<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Script de inicialización de Tema (Claro / Oscuro) sin parpadeo -->
  <script>
    (function() {
      const defaultMode = '<%= content.brand?.themeMode || "light" %>';
      const currentTheme = localStorage.getItem('kidsrun_theme') || defaultMode;
      if (currentTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>

  <!-- Metadatos SEO Principales -->
  <title><%= content.seo?.metaTitle || 'KidsRun 2026 | La Gran Corrida Infantil y Familiar' %></title>
  <meta name="description" content="<%= content.seo?.metaDescription || '' %>">
  <meta name="keywords" content="<%= content.seo?.keywords || '' %>">
  <link rel="canonical" href="<%= content.seo?.canonicalUrl || siteUrl %>">
  <% if (content.seo?.enableRobotsIndex !== false) { %>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <% } else { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>

  <!-- Open Graph / Redes Sociales (WhatsApp, Facebook, LinkedIn) -->
  <meta property="og:type" content="<%= content.seo?.ogType || 'website' %>">
  <meta property="og:url" content="<%= content.seo?.canonicalUrl || siteUrl %>">
  <meta property="og:title" content="<%= content.seo?.metaTitle || 'KidsRun 2026' %>">
  <meta property="og:description" content="<%= content.seo?.metaDescription || '' %>">
  <meta property="og:image" content="<%= content.seo?.ogImage || '' %>">
  <meta property="og:site_name" content="<%= content.brand?.name || 'KidsRun 2026' %>">

  <!-- Twitter Cards (X) -->
  <meta name="twitter:card" content="<%= content.seo?.twitterCard || 'summary_large_image' %>">
  <meta name="twitter:title" content="<%= content.seo?.metaTitle || 'KidsRun 2026' %>">
  <meta name="twitter:description" content="<%= content.seo?.metaDescription || '' %>">
  <meta name="twitter:image" content="<%= content.seo?.ogImage || '' %>">
  <% if (content.seo?.twitterHandle) { %>
  <meta name="twitter:site" content="<%= content.seo.twitterHandle %>">
  <% } %>

  <!-- Marcado Estructurado Schema.org SportsEvent -->
  <script type="application/ld+json">
    <%- jsonLd %>
  </script>

  <% if (content.seo?.analyticsCode) { %>
  <%- content.seo.analyticsCode %>
  <% } %>

  <!-- Tailwind CSS & Fuentes -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              DEFAULT: '<%= theme.primaryHex %>',
              light: '<%= theme.primaryHex %>20',
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@1.47.0"></script>

  <!-- Estilos Personalizados y Animaciones -->
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-gray-950 dark:text-gray-100 transition-colors duration-300 selection:bg-emerald-500 selection:text-white antialiased relative overflow-x-hidden">

  <!-- Luces ambientales de fondo adaptables (corporativo: rojo/verde/amarillo) -->
  <div class="ambient-glow ambient-green w-[650px] h-[650px] top-[-100px] left-1/2 -translate-x-1/2"></div>
  <div class="ambient-glow ambient-red w-[550px] h-[550px] top-[500px] right-[-150px]"></div>
  <div class="ambient-glow ambient-yellow w-[600px] h-[600px] top-[2200px] left-[-200px]"></div>

  <!-- Barra de Navegación Superior -->
  <header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-white/80 dark:bg-gray-950/85 backdrop-blur-md border-b border-slate-200/80 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Logotipo: Soporta Imagen Personalizada o Icono + Texto -->
      <a href="/" class="flex items-center gap-3 group">
        <% if (content.brand?.logoUrl) { %>
        <img src="<%= content.brand.logoUrl %>" alt="<%= content.brand?.name || 'KidsRun' %>" class="h-11 w-auto object-contain">
        <% } else { %>
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr <%= theme.gradient %> p-[1px] shadow-lg shadow-emerald-300/50 group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-white dark:bg-gray-950 rounded-3xl flex items-center justify-center">
            <i data-lucide="<%= content.brand?.logoIcon || 'trophy' %>" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
          </div>
        </div>
        <% } %>

        <div class="flex flex-col">
          <span class="text-xl font-black tracking-tight text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            <%= content.brand?.logoText || 'KidsRun 2026' %>
          </span>
          <span class="text-[10px] font-bold text-emerald-600 dark:text-yellow-400 -mt-1 hidden sm:block">
            <%= content.brand?.tagline || 'Corrida Infantil & Familiar' %>
          </span>
        </div>
      </a>

      <!-- Menú de Navegación Escritorio -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-slate-600 dark:text-gray-300">
        <a href="#countdown" class="hover:text-emerald-600 dark:hover:text-yellow-400 transition-colors flex items-center gap-1">
          <i data-lucide="clock" class="w-3.5 h-3.5"></i> Cuenta Regresiva
        </a>
        <a href="#circuits" class="hover:text-slate-900 dark:hover:text-white transition-colors">Circuitos</a>
        <a href="#schedule" class="hover:text-slate-900 dark:hover:text-white transition-colors">Cronograma</a>
        <a href="#gallery" class="hover:text-slate-900 dark:hover:text-white transition-colors">Galería</a>
        <a href="#kits" class="hover:text-slate-900 dark:hover:text-white transition-colors">Kits & Precios</a>
        <a href="#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors">Preguntas</a>
      </nav>

      <!-- Acciones de Cabecera: Conmutador Modo Claro/Oscuro + CMS + Inscripción -->
      <div class="hidden md:flex items-center gap-3">
        
        <!-- Botón de Alternar Modo Claro (White Mode) / Modo Oscuro -->
        <button type="button" id="theme-toggle-btn" class="p-2.5 rounded-2xl border border-slate-200 dark:border-gray-800 text-slate-700 dark:text-yellow-400 hover:bg-slate-100 dark:hover:bg-gray-900 transition-all" title="Cambiar Modo Claro / Oscuro" aria-label="Cambiar tema">
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
          <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
        </button>

        <a href="/admin" class="text-xs font-semibold px-3 py-2 rounded-2xl border border-slate-200 dark:border-gray-800 text-slate-600 dark:text-gray-400 hover:text-slate-900 dark:hover:text-white transition-all flex items-center gap-1.5" title="Panel CMS">
          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
          CMS Admin
        </a>

        <a href="#contact" class="px-5 py-2.5 rounded-2xl text-sm font-bold <%= theme.solidBtn %> hover:scale-105 transition-all shadow-md shadow-emerald-300/50 hover:shadow-emerald-400/60 transform hover:-translate-y-0.5 flex items-center gap-1.5">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>Inscribir Niño/a</span>
        </a>
      </div>

      <!-- Botón Menú Móvil -->
      <div class="flex items-center gap-2 lg:hidden">
        <button type="button" id="theme-toggle-mobile" class="p-2 rounded-2xl border border-slate-200 dark:border-gray-800 text-slate-700 dark:text-yellow-400" aria-label="Alternar tema">
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
          <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
        </button>
        <button id="mobile-menu-btn" class="text-slate-700 dark:text-gray-400 hover:text-slate-900 dark:hover:text-white p-2 focus:outline-none" aria-label="Abrir menú">
          <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
      </div>
    </div>

    <!-- Menú Desplegable Móvil -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white/95 dark:bg-gray-950/95 backdrop-blur-md border-b border-slate-200 dark:border-white/10 px-6 py-6 space-y-4 shadow-xl">
      <a href="#countdown" class="block text-emerald-600 dark:text-yellow-400 font-bold">⏰ Cuenta Regresiva</a>
      <a href="#circuits" class="block text-slate-700 dark:text-gray-300 font-medium">Circuitos por Edades</a>
      <a href="#schedule" class="block text-slate-700 dark:text-gray-300 font-medium">Cronograma del Día</a>
      <a href="#gallery" class="block text-slate-700 dark:text-gray-300 font-medium">Galería de Fotos</a>
      <a href="#kits" class="block text-slate-700 dark:text-gray-300 font-medium">Kits y Valores</a>
      <a href="#faq" class="block text-slate-700 dark:text-gray-300 font-medium">Preguntas Frecuentes</a>
      <div class="pt-4 border-t border-slate-200 dark:border-gray-800 flex flex-col gap-3">
        <a href="/admin" class="text-center text-sm font-semibold py-2 px-4 rounded-xl border border-slate-200 dark:border-gray-800 text-slate-700 dark:text-gray-300">
          CMS Admin
        </a>
        <a href="#contact" class="text-center py-2.5 px-4 rounded-2xl text-sm font-bold <%= theme.solidBtn %>">
          Inscribir Niño/a
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- SECCIÓN HERO -->
    <section class="relative min-h-[90vh] flex items-center justify-center pt-32 pb-16 overflow-hidden">
      <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <!-- Badge Superior Animado -->
        <% if (content.hero?.badgeText) { %>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-emerald-400/70 bg-emerald-200 backdrop-blur-md text-xs font-black text-emerald-700 dark:text-emerald-300 mb-6 hover:border-emerald-400/80 transition-all cursor-pointer group">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span><%= content.hero.badgeText %></span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"></i>
        </div>
        <% } %>

        <!-- Título Principal con Efecto Gradiente -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1] mb-6">
          <span><%= content.hero?.headlinePrefix || 'La Carrera Más Divertida del Año para' %></span>
          <br>
          <span class="text-gradient bg-gradient-to-r <%= theme.gradient %>">
            <%= content.hero?.headlineGradient || 'Pequeños Campeones & Familias' %>
          </span>
        </h1>

        <!-- Subtítulo Descriptivo -->
        <p class="max-w-3xl mx-auto text-lg sm:text-xl text-slate-600 dark:text-gray-300 font-normal leading-relaxed mb-10">
          <%= content.hero?.subheadline || 'Un día inolvidable de deporte, risas y diversión con medalla para todos los niños.' %>
        </p>

        <!-- Botones CTA -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
          <a href="<%= content.hero?.primaryCtaLink || '#contact' %>" class="w-full sm:w-auto px-8 py-4 rounded-2xl text-base font-bold <%= theme.solidBtn %> hover:scale-105 shadow-xl shadow-emerald-300/50 hover:shadow-emerald-400/60 transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
            <span><%= content.hero?.primaryCtaText || 'Inscribir a mi Pequeño/a' %></span>
            <i data-lucide="sparkles" class="w-4 h-4"></i>
          </a>
          <a href="<%= content.hero?.secondaryCtaLink || '#gallery' %>" class="w-full sm:w-auto px-8 py-4 rounded-2xl text-base font-bold <%= theme.solidBtnSecondary %> hover:scale-105 shadow-sm transition-all flex items-center justify-center gap-2">
            <i data-lucide="image" class="w-5 h-5 text-emerald-600 dark:text-yellow-400"></i>
            <span><%= content.hero?.secondaryCtaText || 'Ver Galería & Circuitos' %></span>
          </a>
        </div>

        <p class="text-xs font-bold text-emerald-700 dark:text-yellow-300/90 flex items-center justify-center gap-2">
          <%= content.hero?.statsNotice || '🏅 Medalla finisher garantizada para todos los niños • Cupos limitados' %>
        </p>

      </div>
    </section>

    <!-- SECCIÓN CONTADOR REGRESIVO (COUNTDOWN TIMER) -->
    <section id="countdown" class="py-16 relative z-10 -mt-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white/95 dark:bg-gray-900/90 p-8 sm:p-10 rounded-3xl border-2 border-emerald-400/60 dark:border-yellow-400/60 shadow-2xl backdrop-blur-xl relative overflow-hidden">
          
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-300/50 dark:bg-yellow-300/50 text-emerald-700 dark:text-yellow-300 text-xs font-bold border border-emerald-400/60 dark:border-yellow-400/60 mb-3">
              <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-yellow-400 animate-pulse"></span>
              <%= content.countdown?.badge || '⏰ ¡FALTAN SÓLO!' %>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Cuenta Regresiva para la Gran Largada
            </h2>
            <p class="text-sm text-slate-500 dark:text-gray-400 mt-1">
              <%= content.countdown?.eventDateDisplay || 'Domingo 15 de Noviembre, 2026' %> • <%= content.countdown?.eventTime || '09:00 AM' %>
            </p>
          </div>

          <!-- Bloques del Contador Dinámico -->
          <div id="countdown-timer" data-target="<%= content.countdown?.targetDate || '2026-11-15T09:00:00' %>" class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center max-w-3xl mx-auto">
            
            <div class="p-4 sm:p-6 rounded-3xl bg-slate-50 dark:bg-gray-950/90 border border-slate-200 dark:border-gray-800/80 shadow-sm dark:shadow-inner flex flex-col justify-center items-center">
              <span id="cd-days" class="text-4xl sm:text-6xl font-black text-emerald-600 dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-r <%= theme.gradient %>">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">DÍAS</span>
            </div>

            <div class="p-4 sm:p-6 rounded-3xl bg-slate-50 dark:bg-gray-950/90 border border-slate-200 dark:border-gray-800/80 shadow-sm dark:shadow-inner flex flex-col justify-center items-center">
              <span id="cd-hours" class="text-4xl sm:text-6xl font-black text-emerald-600 dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-r <%= theme.gradient %>">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">HORAS</span>
            </div>

            <div class="p-4 sm:p-6 rounded-3xl bg-slate-50 dark:bg-gray-950/90 border border-slate-200 dark:border-gray-800/80 shadow-sm dark:shadow-inner flex flex-col justify-center items-center">
              <span id="cd-minutes" class="text-4xl sm:text-6xl font-black text-emerald-600 dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-r <%= theme.gradient %>">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">MINUTOS</span>
            </div>

            <div class="p-4 sm:p-6 rounded-3xl bg-slate-50 dark:bg-gray-950/90 border border-slate-200 dark:border-gray-800/80 shadow-sm dark:shadow-inner flex flex-col justify-center items-center">
              <span id="cd-seconds" class="text-4xl sm:text-6xl font-black text-yellow-400 dark:text-yellow-400">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">SEGUNDOS</span>
            </div>

          </div>

          <!-- Mensaje al expirar -->
          <div id="countdown-expired" class="hidden text-center py-6">
            <span class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-yellow-400">🎉 ¡HOY ES EL GRAN DÍA DE LA CORRIDA! 🎉</span>
            <p class="text-slate-600 dark:text-gray-300 mt-2">¡Nos vemos en el arco de largada! Trae tu kit y toda la energía.</p>
          </div>

          <!-- Tarjetas de Ubicación y Seguridad -->
          <div class="mt-8 pt-6 border-t border-slate-200 dark:border-gray-800 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-600 dark:text-gray-300">
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-gray-950/50 border border-slate-200 dark:border-gray-800">
              <i data-lucide="map-pin" class="w-5 h-5 text-emerald-600 dark:text-yellow-400 flex-shrink-0"></i>
              <div>
                <p class="font-bold text-slate-900 dark:text-white"><%= content.countdown?.locationName || 'Parque Bicentenario' %></p>
                <p class="text-slate-500 dark:text-gray-400"><%= content.countdown?.locationCity || 'Sector Explanada Central' %></p>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-gray-950/50 border border-slate-200 dark:border-gray-800">
              <i data-lucide="shield-check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400 flex-shrink-0"></i>
              <div>
                <p class="font-bold text-slate-900 dark:text-white">Circuito 100% Seguro</p>
                <p class="text-slate-500 dark:text-gray-400">Sin vehículos • Ambulancia y paramédicos certificados</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- BARRA DE MÉTRICAS -->
    <section class="py-12 border-y border-slate-200 dark:border-white/5 bg-white/70 dark:bg-gray-950/80 backdrop-blur-sm relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <% (content.metrics || []).forEach(metric => { %>
          <div class="space-y-1">
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r <%= theme.gradient %>">
              <%= metric.value %>
            </div>
            <div class="text-xs sm:text-sm font-bold text-slate-600 dark:text-gray-400 flex items-center justify-center gap-1.5">
              <i data-lucide="<%= metric.icon || 'award' %>" class="w-4 h-4 text-emerald-600 dark:text-yellow-400"></i>
              <%= metric.label %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE CIRCUITOS Y CATEGORÍAS -->
    <section id="circuits" class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400 mb-3">CIRCUITOS ADAPTADOS</h2>
          <p class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
            Una distancia ideal para cada edad
          </p>
          <p class="text-slate-600 dark:text-gray-400 text-sm mt-3">Diseñados para garantizar la diversión, el esfuerzo sano y la seguridad de cada corredor.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <% (content.categories || []).forEach(cat => { %>
          <div class="bg-white dark:bg-gray-900/60 p-6 rounded-3xl flex flex-col justify-between border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-xl transition-all group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-black px-3 py-1 rounded-full bg-emerald-300/50 dark:bg-yellow-200/50 text-emerald-700 dark:text-yellow-300 border border-emerald-400/60 dark:border-yellow-400/60">
                  <%= cat.badge %>
                </span>
                <div class="w-10 h-10 rounded-2xl bg-slate-100 dark:bg-gray-950 flex items-center justify-center text-emerald-600 dark:text-yellow-400 group-hover:scale-110 transition-transform">
                  <i data-lucide="<%= cat.icon || 'smile' %>" class="w-5 h-5"></i>
                </div>
              </div>

              <div class="text-2xl font-black text-slate-900 dark:text-white mb-1"><%= cat.distance %></div>
              <h3 class="text-base font-bold text-emerald-600 dark:text-yellow-300 mb-3"><%= cat.title %></h3>
              <p class="text-xs text-slate-600 dark:text-gray-400 leading-relaxed"><%= cat.description %></p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-gray-800 flex items-center justify-between text-xs">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                <i data-lucide="check" class="w-3.5 h-3.5"></i> Medalla Finisher
              </span>
              <a href="#contact" class="text-emerald-600 dark:text-yellow-400 hover:opacity-80 font-bold flex items-center">
                Elegir <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-0.5"></i>
              </a>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN CRONOGRAMA DEL DÍA -->
    <section id="schedule" class="py-20 bg-slate-100/70 dark:bg-gradient-to-b dark:from-gray-950 dark:via-gray-900/40 dark:to-gray-950 relative z-10 border-t border-slate-200 dark:border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400 mb-3">HORARIOS Y ACTIVIDADES</h2>
          <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Cronograma de la Gran Jornada
          </p>
          <p class="text-slate-600 dark:text-gray-400 text-sm mt-2">Ven temprano para disfrutar de todas las sorpresas preparadas para la familia.</p>
        </div>

        <div class="space-y-4">
          <% (content.schedule || []).forEach(item => { %>
          <div class="bg-white dark:bg-gray-900/60 p-5 rounded-3xl border border-slate-200 dark:border-white/10 flex flex-col sm:flex-row items-start sm:items-center gap-4 shadow-sm hover:border-emerald-400/70 dark:hover:border-yellow-400/60 transition-all">
            <div class="px-4 py-2 rounded-2xl bg-emerald-300/50 dark:bg-yellow-300/50 text-emerald-700 dark:text-yellow-300 font-black text-sm tracking-wide border border-emerald-400/60 dark:border-yellow-400/60 flex-shrink-0">
              <%= item.time %>
            </div>
            <div class="flex-1">
              <h4 class="text-base font-bold text-slate-900 dark:text-white"><%= item.title %></h4>
              <p class="text-xs text-slate-600 dark:text-gray-400 mt-0.5"><%= item.desc %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN GALERÍA DE IMÁGENES INTERACTIVA (CON LIGHTBOX) -->
    <section id="gallery" class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400 mb-3">RECUERDOS INOLVIDABLES</h2>
          <p class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
            Galería de Ediciones Anteriores
          </p>
          <p class="text-slate-600 dark:text-gray-400 text-sm">Haz clic en cualquier imagen para verla en tamaño completo.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% (content.gallery || []).forEach((photo, idx) => { %>
          <div class="gallery-item group relative rounded-3xl overflow-hidden bg-white dark:bg-gray-900 border border-slate-200 dark:border-white/10 cursor-pointer shadow-md hover:shadow-2xl transition-all"
               data-img-src="<%= photo.url %>"
               data-img-title="<%= photo.title %>"
               data-img-caption="<%= photo.caption %>">
            
            <div class="aspect-w-16 aspect-h-11 w-full h-64 overflow-hidden bg-slate-100 dark:bg-gray-900">
              <img src="<%= photo.url %>" 
                   alt="<%= photo.title %>" 
                   class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" 
                   loading="lazy">
            </div>

            <!-- Overlay dinámico -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent opacity-85 group-hover:opacity-95 transition-opacity flex flex-col justify-between p-5 text-white">
              <div class="flex justify-end">
                <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-400/70 text-emerald-200 border border-emerald-400/70 backdrop-blur-md">
                  <%= photo.category || 'KidsRun' %>
                </span>
              </div>
              <div>
                <h4 class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors flex items-center justify-between">
                  <span><%= photo.title %></span>
                  <i data-lucide="maximize-2" class="w-4 h-4 text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity"></i>
                </h4>
                <p class="text-xs text-gray-200 mt-1 line-clamp-2"><%= photo.caption %></p>
              </div>
            </div>
          </div>
          <% }); %>
        </div>

      </div>
    </section>

    <!-- MODAL LIGHTBOX PARA LA GALERÍA -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4">
      <button id="lightbox-close" class="absolute top-6 right-6 text-gray-400 hover:text-white p-2 rounded-full bg-gray-900/80 border border-white/10 transition-colors" aria-label="Cerrar visor">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
      <div class="max-w-4xl w-full flex flex-col items-center">
        <img id="lightbox-img" src="" alt="Vista ampliada" class="max-h-[75vh] w-auto rounded-3xl shadow-2xl border border-white/20 object-contain">
        <div class="text-center mt-4">
          <h3 id="lightbox-title" class="text-lg font-bold text-white"></h3>
          <p id="lightbox-caption" class="text-sm text-gray-300 mt-1"></p>
        </div>
      </div>
    </div>

    <!-- SECCIÓN DE KITS Y PRECIOS -->
    <section id="kits" class="py-24 bg-slate-100/70 dark:bg-gradient-to-b dark:from-gray-950 dark:via-gray-900/30 dark:to-gray-950 relative z-10 border-t border-slate-200 dark:border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400 mb-3">INSCRIPCIÓN OFICIAL</h2>
          <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
            Kits de Corredor Disponibles
          </p>
          <p class="text-slate-600 dark:text-gray-400 text-sm">Todos los kits incluyen polera técnica y medalla de metal finisher garantizada.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
          <% (content.pricing?.plans || []).forEach(plan => { %>
          <div class="relative bg-white dark:bg-gray-900/70 rounded-3xl p-8 flex flex-col justify-between transition-all shadow-md <%= plan.isPopular ? 'border-2 border-emerald-500 dark:border-yellow-400 shadow-xl shadow-emerald-300/50 md:-translate-y-2' : 'border border-slate-200 dark:border-white/10' %>">
            
            <% if (plan.isPopular) { %>
             <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-emerald-600 text-white text-[11px] font-black uppercase tracking-wider px-4 py-1 rounded-full shadow-md">
              <%= plan.badge || 'MÁS ELEGIDO' %>
            </div>
            <% } %>

            <div>
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white"><%= plan.name %></h3>
                <% if (!plan.isPopular && plan.badge) { %>
                <span class="text-xs font-semibold text-slate-600 dark:text-gray-400 bg-slate-100 dark:bg-gray-800/80 px-2.5 py-0.5 rounded-full">
                  <%= plan.badge %>
                </span>
                <% } %>
              </div>
              <p class="text-xs text-slate-600 dark:text-gray-400 mb-6 leading-relaxed"><%= plan.description %></p>

              <!-- Precio -->
              <div class="flex items-baseline gap-1 mb-6">
                <span class="text-4xl font-black text-slate-900 dark:text-white">
                  $<%= plan.priceMonthly %>
                </span>
                <span class="text-xs text-slate-500 dark:text-gray-400">/inscripción</span>
              </div>

              <!-- Lista de Beneficios -->
              <ul class="space-y-3 mb-8 text-xs text-slate-700 dark:text-gray-300">
                <% (plan.features || []).forEach(feat => { %>
                <li class="flex items-center gap-2.5">
                  <i data-lucide="check" class="w-4 h-4 text-emerald-500 flex-shrink-0"></i>
                  <span><%= feat %></span>
                </li>
                <% }); %>
              </ul>
            </div>

            <!-- Botón CTA -->
            <a href="#contact" class="w-full text-center py-3.5 px-4 rounded-2xl text-xs font-bold transition-all <%= plan.isPopular ? theme.solidBtn : 'bg-slate-900 text-white hover:bg-slate-800 dark:bg-gray-800 dark:hover:bg-gray-700' %> shadow-lg shadow-emerald-300/60">
              <%= plan.ctaText || 'Inscribir Ahora' %>
            </a>
          </div>
          <% }); %>
        </div>

      </div>
    </section>

    <!-- SECCIÓN DE TESTIMONIOS -->
    <section id="testimonials" class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400 mb-3">EXPERIENCIA FAMILIAR</h2>
          <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Opiniones de Papás y Mamás
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <% (content.testimonials || []).forEach(testimonial => { %>
          <div class="bg-white dark:bg-gray-900/60 p-8 rounded-3xl flex flex-col justify-between border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-xl transition-all">
            <div>
              <div class="flex items-center gap-1 text-yellow-400 dark:text-yellow-400 mb-4">
                <% for (let i = 0; i < (testimonial.stars || 5); i++) { %>
                <i data-lucide="star" class="w-4 h-4 fill-yellow-400"></i>
                <% } %>
              </div>
              <p class="text-slate-700 dark:text-gray-300 text-sm leading-relaxed mb-6 italic">
                "<%= testimonial.quote %>"
              </p>
            </div>
            <div class="flex items-center gap-3 pt-4 border-t border-slate-100 dark:border-gray-800">
              <img src="<%= testimonial.avatar %>" alt="<%= testimonial.name %>" class="w-10 h-10 rounded-full object-cover border border-emerald-400/60" loading="lazy">
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white"><%= testimonial.name %></p>
                <p class="text-xs text-slate-500 dark:text-gray-400"><%= testimonial.role %></p>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE PREGUNTAS FRECUENTES (FAQ) -->
    <section id="faq" class="py-24 relative z-10 border-t border-slate-200 dark:border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400 mb-3">RESOLVEMOS TUS DUDAS</h2>
          <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Preguntas Frecuentes para Padres
          </p>
        </div>

        <div class="space-y-4">
          <% (content.faqs || []).forEach((faq, index) => { %>
          <div class="faq-item bg-white dark:bg-gray-900/60 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm overflow-hidden transition-all">
            <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between text-base font-bold text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-yellow-300 transition-colors">
              <span><%= faq.question %></span>
              <i data-lucide="chevron-down" class="faq-icon w-5 h-5 text-slate-400 dark:text-gray-400 transition-transform duration-300"></i>
            </button>
            <div class="faq-content <%= index === 0 ? '' : 'hidden' %> px-6 pb-5 text-sm text-slate-600 dark:text-gray-300 leading-relaxed border-t border-slate-100 dark:border-white/5 pt-3">
              <%= faq.answer %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE FORMULARIO DE PRE-INSCRIPCIÓN FAMILIAR -->
    <section id="contact" class="py-24 bg-slate-100/80 dark:bg-gradient-to-b dark:from-gray-950 dark:via-gray-900/60 dark:to-gray-950 relative z-10 border-t border-slate-200 dark:border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          
          <!-- Información y Canales -->
          <div class="space-y-6">
            <span class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-yellow-400">INSCRIPCIÓN RÁPIDA</span>
            <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
              <%= content.contact?.title || 'Inscribe a tu Pequeño Corredor' %>
            </h2>
            <p class="text-slate-600 dark:text-gray-300 leading-relaxed text-sm">
              <%= content.contact?.subtitle || 'Completa los datos del tutor y del participante para reservar el cupo y el kit oficial en nuestra base de datos.' %>
            </p>

            <div class="space-y-4 pt-4">
              <div class="flex items-center gap-3 text-sm text-slate-700 dark:text-gray-300">
                <div class="w-10 h-10 rounded-2xl bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 flex items-center justify-center text-emerald-600 dark:text-yellow-400 shadow-sm">
                  <i data-lucide="mail" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-gray-400">Mesa de Ayuda a Familias</p>
                  <p class="font-bold text-slate-900 dark:text-white"><%= content.contact?.email || 'contacto@kidsrun2026.com' %></p>
                </div>
              </div>

              <div class="flex items-center gap-3 text-sm text-slate-700 dark:text-gray-300">
                <div class="w-10 h-10 rounded-2xl bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 flex items-center justify-center text-emerald-600 dark:text-yellow-400 shadow-sm">
                  <i data-lucide="phone" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-gray-400">WhatsApp Oficial</p>
                  <p class="font-bold text-slate-900 dark:text-white"><%= content.contact?.phone || '+56 9 8765 4321' %></p>
                </div>
              </div>

              <div class="flex items-center gap-3 text-sm text-slate-700 dark:text-gray-300">
                <div class="w-10 h-10 rounded-2xl bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 flex items-center justify-center text-emerald-600 dark:text-yellow-400 shadow-sm">
                  <i data-lucide="map-pin" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-gray-400">Lugar de Largada</p>
                  <p class="font-bold text-slate-900 dark:text-white"><%= content.contact?.location || 'Parque Bicentenario • Explanada Central' %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Formulario Adaptado a Niños (PostgreSQL Backend) -->
          <div class="bg-white dark:bg-gray-900/80 p-8 rounded-3xl border border-slate-200 dark:border-white/10 shadow-2xl">
            <form id="contact-form" class="space-y-4">
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Nombre del Padre / Tutor *</label>
                  <input type="text" id="name" name="name" required placeholder="Ej: Marcela González" class="w-full bg-slate-50 dark:bg-gray-950/80 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
                <div>
                  <label for="email" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Correo Electrónico *</label>
                  <input type="email" id="email" name="email" required placeholder="marcela@correo.com" class="w-full bg-slate-50 dark:bg-gray-950/80 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-2">
                  <label for="kidName" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Nombre del Niño/a Corredor *</label>
                  <input type="text" id="kidName" name="kidName" required placeholder="Ej: Mateo González" class="w-full bg-slate-50 dark:bg-gray-950/80 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
                <div>
                  <label for="kidAge" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Edad *</label>
                  <input type="number" id="kidAge" name="kidAge" min="2" max="15" required placeholder="7" class="w-full bg-slate-50 dark:bg-gray-950/80 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="phone" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Teléfono</label>
                  <input type="tel" id="phone" name="phone" placeholder="+56 9 1234 5678" class="w-full bg-slate-50 dark:bg-gray-950/80 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition-colors">
                </div>
                <div>
                  <label for="distance" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Circuito / Distancia *</label>
                  <select id="distance" name="distance" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-emerald-500 transition-colors">
                    <option value="500m (3-5 años)">500 Metros - Mini Runners (3-5 años)</option>
                    <option value="1K (6-8 años)">1 Kilómetro - Pequeños Rayos (6-8 años)</option>
                    <option value="2K (9-11 años)">2 Kilómetros - Súper Campeones (9-11 años)</option>
                    <option value="3K (12-14 años)">3 Kilómetros - Jóvenes Titanes (12-14 años)</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Comentarios o Consultas Especiales</label>
                <textarea id="message" name="message" rows="3" placeholder="Alergias, talla de polera sugerida o dudas..." class="w-full bg-slate-50 dark:bg-gray-950/80 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition-colors"></textarea>
              </div>

              <button type="submit" class="w-full py-4 rounded-2xl text-sm font-black <%= theme.solidBtn %> hover:scale-105 shadow-lg shadow-emerald-300/50 transition-all flex items-center justify-center gap-2">
                <span><%= content.contact?.formButtonText || 'Completar Pre-Inscripción Oficial' %></span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
              </button>
            </form>
          </div>

        </div>
      </div>
    </section>
  </main>

  <!-- PIE DE PÁGINA (FOOTER) -->
  <footer class="border-t border-slate-200 dark:border-white/5 bg-slate-100 dark:bg-gray-950 py-12 relative z-10 text-xs text-slate-600 dark:text-gray-400 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Marca y Copyright -->
      <div class="flex items-center gap-3">
        <% if (content.brand?.logoUrl) { %>
        <img src="<%= content.brand.logoUrl %>" alt="" class="h-7 w-auto object-contain">
        <% } else { %>
        <div class="w-7 h-7 rounded-xl bg-gradient-to-tr <%= theme.gradient %> p-[1px]">
          <div class="w-full h-full bg-white dark:bg-gray-950 rounded-2xl flex items-center justify-center">
            <i data-lucide="<%= content.brand?.logoIcon || 'trophy' %>" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
          </div>
        </div>
        <% } %>
        <span class="font-bold text-slate-900 dark:text-white"><%= content.brand?.name || 'KidsRun 2026' %></span>
        <span class="text-slate-300 dark:text-gray-600">|</span>
        <span><%= content.footer?.copyright || '© 2026 KidsRun. Todos los derechos reservados.' %></span>
      </div>

      <!-- Redes Sociales y Acceso Admin -->
      <div class="flex items-center gap-4">
        <% if (content.footer?.socialLinks?.twitter) { %>
        <a href="<%= content.footer.socialLinks.twitter %>" target="_blank" rel="noopener" class="hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="Twitter">
          <i data-lucide="twitter" class="w-4 h-4"></i>
        </a>
        <% } %>
        <% if (content.footer?.socialLinks?.github) { %>
        <a href="<%= content.footer.socialLinks.github %>" target="_blank" rel="noopener" class="hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="Instagram">
          <i data-lucide="instagram" class="w-4 h-4"></i>
        </a>
        <% } %>
        <% if (content.footer?.socialLinks?.linkedin) { %>
        <a href="<%= content.footer.socialLinks.linkedin %>" target="_blank" rel="noopener" class="hover:text-slate-900 dark:hover:text-white transition-colors" aria-label="Facebook">
          <i data-lucide="facebook" class="w-4 h-4"></i>
        </a>
        <% } %>
        <a href="/admin" class="ml-4 text-xs text-emerald-700 dark:text-yellow-400 hover:opacity-80 flex items-center gap-1 font-bold">
          <i data-lucide="shield" class="w-3.5 h-3.5"></i>
          CMS Admin
        </a>
      </div>

    </div>
  </footer>

  <!-- Scripts de la Landing Page -->
  <script src="/js/landing.js"></script>
</body>
</html>
