            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
              <i data-lucide="message-square" class="w-5 h-5 text-blue-600 dark:text-yellow-400"></i>
              Envíanos un Mensaje
            </h3>
            <p class="text-xs text-slate-500 dark:text-gray-400 mb-6">
              Te responderemos a tu correo o WhatsApp a la mayor brevedad.
            </p>

            <form id="contact-form" class="space-y-4">
              <input type="hidden" id="contactCsrfToken" name="csrfToken" value="<%= csrfToken %>">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Nombre Completo *</label>
                <input type="text" id="contact-name" name="name" required maxlength="100" placeholder="Tu nombre y apellido" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-blue-600 transition-colors">
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-email" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Correo Electrónico *</label>
                  <input type="email" id="contact-email" name="email" required maxlength="254" placeholder="ejemplo@correo.com" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-blue-600 transition-colors">
                </div>
                <div>
                  <label for="contact-phone" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1.5">Teléfono / WhatsApp</label>
                  <input type="tel" id="contact-phone" name="phone" maxlength="30" placeholder="+56 9 1234 5678" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-4 py-3 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:border-blue-600 transition-colors">
                </div>
              </div>

