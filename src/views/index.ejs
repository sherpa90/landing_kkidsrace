<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Script de inicialización de Tema (Claro / Oscuro) sin parpadeo -->
  <script>
    (function() {
      const defaultMode = '<%= content.brand?.themeMode || "light" %>';
      const currentTheme = localStorage.getItem('kidsrun_theme') || defaultMode;
      if (currentTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>

  <!-- Metadatos SEO Principales y Pestaña del Navegador -->
  <title><%= content.seo?.metaTitle || 'Kids Race 2026 | La Gran Corrida Infantil y Familiar' %></title>
  <link rel="icon" type="image/x-icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <link rel="shortcut icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <link rel="apple-touch-icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <meta name="description" content="<%= content.seo?.metaDescription || '' %>">
  <meta name="keywords" content="<%= content.seo?.keywords || '' %>">
  <link rel="canonical" href="<%= content.seo?.canonicalUrl || siteUrl %>">
  <% if (content.seo?.enableRobotsIndex !== false) { %>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <% } else { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>

  <!-- Open Graph / Redes Sociales (WhatsApp, Facebook, LinkedIn) -->
  <meta property="og:type" content="<%= content.seo?.ogType || 'website' %>">
  <meta property="og:url" content="<%= content.seo?.canonicalUrl || siteUrl %>">
  <meta property="og:title" content="<%= content.seo?.metaTitle || 'Kids Race 2026' %>">
  <meta property="og:description" content="<%= content.seo?.metaDescription || '' %>">
  <meta property="og:image" content="<%= content.seo?.ogImage || '' %>">
  <meta property="og:site_name" content="<%= content.brand?.name || 'Kids Race 2026' %>">

  <!-- Twitter Cards (X) -->
  <meta name="twitter:card" content="<%= content.seo?.twitterCard || 'summary_large_image' %>">
  <meta name="twitter:title" content="<%= content.seo?.metaTitle || 'Kids Race 2026' %>">
  <meta name="twitter:description" content="<%= content.seo?.metaDescription || '' %>">
  <meta name="twitter:image" content="<%= content.seo?.ogImage || '' %>">
  <% if (content.seo?.twitterHandle) { %>
  <meta name="twitter:site" content="<%= content.seo.twitterHandle %>">
  <% } %>

  <!-- Marcado Estructurado Schema.org SportsEvent -->
  <script type="application/ld+json">
    <%- jsonLd %>
  </script>

  <% if (content.seo?.analyticsCode) { %>
  <%- content.seo.analyticsCode %>
  <% } %>

  <!-- Tailwind CSS & Fuentes -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              DEFAULT: '<%= theme.primaryHex %>',
              light: '<%= theme.primaryHex %>15',
              subtle: '#eff6ff',
            },
            accent: {
              yellow: '#facc15',
              red: '#ef4444',
            }
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@1.47.0"></script>

  <!-- Estilos Personalizados y Animaciones -->
  <link rel="stylesheet" href="/css/custom.css">
  <!-- Leaflet.js CSS con respaldo CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
  <style>
    /* Corrección de renderizado para Leaflet con Tailwind CSS y Flexbox */
    #venue-map {
      min-height: 320px;
    }
    #venue-map .leaflet-tile-pane img {
      max-width: none !important;
      max-height: none !important;
    }
    #venue-map .leaflet-container {
      width: 100% !important;
      height: 100% !important;
      font-family: inherit;
    }
  </style>
</head>
<body class="bg-white text-slate-800 dark:bg-gray-950 dark:text-gray-100 transition-colors duration-300 selection:bg-blue-600 selection:text-white antialiased relative overflow-x-hidden">

  <!-- Luces ambientales de fondo confinadas (previene desborde horizontal en móviles) -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
    <div class="ambient-glow ambient-blue w-[500px] sm:w-[650px] h-[500px] sm:h-[650px] top-[-120px] left-1/2 -translate-x-1/2"></div>
    <div class="ambient-glow ambient-red w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] top-[600px] right-[-80px] sm:right-[-150px]"></div>
    <div class="ambient-glow ambient-yellow w-[380px] sm:w-[550px] h-[380px] sm:h-[550px] top-[2100px] left-[-100px] sm:left-[-200px]"></div>
  </div>

  <!-- Barra de Navegación Superior -->
  <header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-white/90 dark:bg-gray-950/85 backdrop-blur-md border-b border-slate-100 dark:border-white/10 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">

      <!-- Logotipo: Soporta Imagen Personalizada o Icono + Texto -->
      <a href="/" class="flex items-center gap-2 sm:gap-3 group min-w-0 shrink-0">
        <% if (content.brand?.logoUrl) { %>
        <img src="<%= content.brand.logoUrl %>" alt="<%= content.brand?.name || 'Kids Race' %>" class="h-8 sm:h-11 w-auto max-w-[110px] sm:max-w-[180px] object-contain">
        <% } else { %>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-gradient-to-tr <%= theme.gradient %> p-[2px] shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform shrink-0">
          <div class="w-full h-full bg-white dark:bg-gray-950 rounded-[10px] sm:rounded-2xl flex items-center justify-center">
            <i data-lucide="<%= content.brand?.logoIcon || 'trophy' %>" class="w-4 h-4 sm:w-5 sm:h-5 text-blue-600 dark:text-yellow-400"></i>
          </div>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-base sm:text-xl font-black tracking-tight text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-yellow-400 transition-colors leading-tight truncate max-w-[130px] sm:max-w-none">
            <%= content.brand?.logoText || 'Kids Race 2026' %>
          </span>
          <% if (!content.header || content.header.showTagline !== false) { %>
          <span class="text-[9px] sm:text-[10px] font-bold text-blue-600 dark:text-yellow-400 -mt-0.5 hidden sm:block tracking-wide uppercase truncate">
            <%= content.brand?.tagline || 'Corrida Infantil & Familiar' %>
          </span>
          <% } %>
        </div>
        <% } %>
      </a>

      <!-- Menú de Navegación Escritorio -->
      <% 
        const isSecVis = (id) => !(content.sections && content.sections.visibility && content.sections.visibility[id] === false);
        const headerCfg = content.header || {};
        const headerLinks = headerCfg.links || {};
        const headerLabels = headerCfg.labels || {};
        const isHeaderVis = (id) => {
          if (typeof headerLinks[id] !== 'undefined') {
            return headerLinks[id] === true;
          }
          if (id === 'bases') return true;
          return isSecVis(id);
        };
        const getNavLabel = (id, def) => headerLabels[id] || def;
      %>
      <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-sm font-bold text-slate-600 dark:text-gray-300 flex-1 justify-center">
        <% if (isHeaderVis('countdown')) { %>
        <a href="#countdown" class="hover:text-blue-600 dark:hover:text-yellow-400 transition-colors flex items-center gap-1.5 whitespace-nowrap">
          <i data-lucide="clock" class="w-3.5 h-3.5 text-blue-600 dark:text-yellow-400"></i> <%= getNavLabel('countdown', 'Cuenta Regresiva') %>
        </a>
        <% } %>
        <% if (isHeaderVis('circuits')) { %><a href="#circuits" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap"><%= getNavLabel('circuits', 'Circuitos') %></a><% } %>
        <% if (isHeaderVis('schedule')) { %><a href="#schedule" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap"><%= getNavLabel('schedule', 'Cronograma') %></a><% } %>
        <% if (isHeaderVis('gallery')) { %><a href="#gallery" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap"><%= getNavLabel('gallery', 'Galería') %></a><% } %>
        <% if (isHeaderVis('kits')) { %><a href="#kits" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap"><%= getNavLabel('kits', 'Inscripción Oficial') %></a><% } %>
        <% if (isHeaderVis('bases')) { %>
        <a href="/bases" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-yellow-400 transition-colors flex items-center gap-1 whitespace-nowrap text-amber-600 dark:text-yellow-400 font-extrabold" title="Abrir Bases y Reglamento en una pestaña nueva">
          <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
          <span><%= getNavLabel('bases', 'Bases & Reglamento') %></span>
        </a>
        <% } %>
        <% if (isHeaderVis('faq')) { %><a href="#faq" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap"><%= getNavLabel('faq', 'Preguntas') %></a><% } %>
        <% if (isHeaderVis('sponsors')) { %><a href="#sponsors" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap hidden xl:block"><%= getNavLabel('sponsors', 'Auspiciadores') %></a><% } %>
        <% if (isHeaderVis('venue')) { %><a href="#venue" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap hidden xl:block"><%= getNavLabel('venue', 'Lugar') %></a><% } %>
        <% if (isHeaderVis('contact')) { %><a href="#contact" class="hover:text-blue-600 dark:hover:text-white transition-colors whitespace-nowrap hidden xl:block"><%= getNavLabel('contact', 'Contacto') %></a><% } %>
      </nav>

      <!-- Acciones Escritorio: Tema + Inscripción -->
      <div class="hidden lg:flex items-center gap-3 shrink-0">
        <% if (headerCfg.showThemeToggle !== false) { %>
        <button type="button" id="theme-toggle-btn" class="p-2.5 rounded-2xl border border-slate-200 dark:border-gray-800 text-slate-700 dark:text-yellow-400 hover:bg-slate-100 dark:hover:bg-gray-900 transition-all" title="Cambiar Modo Claro / Oscuro" aria-label="Cambiar tema">
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
          <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
        </button>
        <% } %>
        <% if (headerCfg.showCtaButton !== false) { %>
        <a href="<%= headerCfg.ctaButtonLink || '/inscribir' %>" class="px-4 xl:px-5 py-2.5 rounded-2xl text-sm font-bold <%= theme.solidBtn %> hover:scale-105 transition-all shadow-md shadow-blue-600/30 transform hover:-translate-y-0.5 flex items-center gap-1.5 whitespace-nowrap">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span><%= headerCfg.ctaButtonText || 'Inscribir Niño/a' %></span>
        </a>
        <% } %>
      </div>

      <!-- Acciones Móvil (< lg): Tema + Hamburguesa -->
      <div class="flex items-center gap-2 lg:hidden shrink-0">
        <% if (headerCfg.showThemeToggle !== false) { %>
        <button type="button" id="theme-toggle-mobile" class="p-2.5 rounded-xl border border-slate-200 dark:border-gray-800 text-slate-700 dark:text-yellow-400 hover:bg-slate-100 dark:hover:bg-gray-900 transition-colors touch-manipulation" aria-label="Alternar tema">
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
          <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
        </button>
        <% } %>
        <button id="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" class="relative p-2.5 rounded-xl border border-slate-200 dark:border-gray-800 text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-gray-900 focus:outline-none transition-all touch-manipulation" aria-label="Abrir menú">
          <!-- Ícono Menu -->
          <i data-lucide="menu" id="nav-icon-menu" class="w-5 h-5 transition-all duration-200"></i>
          <!-- Ícono X (cierre) — oculto inicialmente -->
          <i data-lucide="x" id="nav-icon-close" class="w-5 h-5 absolute inset-0 m-auto transition-all duration-200 opacity-0 scale-50 pointer-events-none"></i>
        </button>
      </div>
    </div>

    <!-- Menú Desplegable Móvil (animado con max-height) -->
    <div id="mobile-menu"
         class="lg:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out"
         aria-hidden="true"
         style="max-height:0">
      <div class="bg-white/98 dark:bg-gray-950/98 backdrop-blur-md border-t border-slate-200 dark:border-white/8 shadow-2xl">
        <nav class="px-4 py-3 space-y-0.5" aria-label="Menú móvil">
          <% if (isHeaderVis('countdown')) { %>
          <a href="#countdown" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-blue-600 dark:text-yellow-400 font-bold hover:bg-blue-50 dark:hover:bg-blue-950/40 active:bg-blue-100 dark:active:bg-blue-900/40 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-blue-100 dark:bg-blue-900/50 shrink-0"><i data-lucide="clock" class="w-3.5 h-3.5"></i></span>
            <%= getNavLabel('countdown', 'Cuenta Regresiva') %>
          </a>
          <% } %>
          <% if (isHeaderVis('circuits')) { %>
          <a href="#circuits" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="flag" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('circuits', 'Circuitos por Edades') %>
          </a>
          <% } %>
          <% if (isHeaderVis('schedule')) { %>
          <a href="#schedule" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="calendar-clock" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('schedule', 'Cronograma Oficial') %>
          </a>
          <% } %>
          <% if (isHeaderVis('gallery')) { %>
          <a href="#gallery" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="image" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('gallery', 'Galería de Fotos') %>
          </a>
          <% } %>
          <% if (isHeaderVis('kits')) { %>
          <a href="#kits" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="tag" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('kits', 'Inscripción Oficial') %>
          </a>
          <% } %>
          <% if (isHeaderVis('bases')) { %>
          <a href="/bases" target="_blank" rel="noopener noreferrer" class="mobile-nav-link group flex items-center justify-between py-3 px-4 rounded-xl text-amber-600 dark:text-yellow-400 font-bold hover:bg-amber-50 dark:hover:bg-amber-950/40 active:bg-amber-100 transition-colors">
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-amber-100 dark:bg-amber-900/50 shrink-0"><i data-lucide="file-text" class="w-3.5 h-3.5 text-amber-600 dark:text-yellow-400"></i></span>
              <%= getNavLabel('bases', 'Bases & Reglamento') %>
            </div>
            <i data-lucide="external-link" class="w-3.5 h-3.5 text-slate-400"></i>
          </a>
          <% } %>
          <% if (isHeaderVis('faq')) { %>
          <a href="#faq" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="help-circle" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('faq', 'Preguntas Frecuentes') %>
          </a>
          <% } %>
          <% if (isHeaderVis('sponsors')) { %>
          <a href="#sponsors" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="building-2" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('sponsors', 'Auspiciadores') %>
          </a>
          <% } %>
          <% if (isHeaderVis('venue')) { %>
          <a href="#venue" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('venue', 'Lugar del Evento') %>
          </a>
          <% } %>
          <% if (isHeaderVis('contact')) { %>
          <a href="#contact" class="mobile-nav-link group flex items-center gap-3 py-3 px-4 rounded-xl text-slate-700 dark:text-gray-300 font-semibold hover:bg-slate-100 dark:hover:bg-gray-800/70 active:bg-slate-200 transition-colors">
            <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-slate-100 dark:bg-gray-800 shrink-0"><i data-lucide="mail" class="w-3.5 h-3.5 text-blue-500"></i></span>
            <%= getNavLabel('contact', 'Contacto & Ayuda') %>
          </a>
          <% } %>
        </nav>
        <% if (headerCfg.showCtaButton !== false) { %>
        <div class="px-4 pb-5 pt-2 border-t border-slate-200 dark:border-white/8">
          <a href="<%= headerCfg.ctaButtonLink || '/inscribir' %>" class="mobile-nav-link w-full text-center py-3.5 px-4 rounded-2xl text-sm font-bold <%= theme.solidBtn %> flex items-center justify-center gap-2 shadow-lg shadow-blue-600/20 active:scale-95 transition-transform">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            <span><%= headerCfg.ctaButtonText || 'Inscribir Niño/a' %></span>
          </a>
        </div>
        <% } %>
      </div>
    </div>
  </header>

  <!-- BANNER FLOTANTE DE AVISO: MODO CONSTRUCCIÓN ACTIVO (SOLO VISIBLE PARA ADMIN) -->
  <% if (typeof constructionAdminBypass !== 'undefined' && constructionAdminBypass) { %>
  <div class="fixed top-16 sm:top-20 inset-x-0 z-40 bg-amber-500/95 text-slate-950 backdrop-blur-md px-4 py-2 border-b border-amber-600 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-bold text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-red-700 animate-ping shrink-0"></span>
        <span>🚧 <strong>Modo Construcción Activo:</strong> El público ve la página de lanzamiento. Estás navegando la web completa con permisos de Administrador.</span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a href="/preview-construction" target="_blank" class="px-2.5 py-1 rounded-xl bg-slate-950 text-white hover:bg-slate-800 text-[11px] font-black transition-colors flex items-center gap-1">
          <i data-lucide="eye" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>Ver cómo lo ve el público</span>
        </a>
        <a href="/admin" class="px-2.5 py-1 rounded-xl bg-white/30 hover:bg-white/50 text-slate-950 text-[11px] font-black transition-colors">
          CMS Admin
        </a>
      </div>
    </div>
  </div>
  <% } %>

  <main class="sections-wrapper">
    <%
      const _sOrder = content.sections?.order || ["hero","countdown","circuits","schedule","gallery","kits","testimonials","faq","sponsors","venue","contact"];
      const _sVis   = content.sections?.visibility || {};
      function sStyle(id) {
        const ord = _sOrder.indexOf(id);
        const vis = _sVis[id] !== false;
        return 'order:' + (ord >= 0 ? ord : 99) + (vis ? '' : ';display:none');
      }
    %>
    <!-- SECCIÓN HERO -->
    <section id="hero" style="<%= sStyle('hero') %>" class="relative min-h-[92vh] flex items-center justify-center pt-32 pb-20 overflow-hidden bg-gradient-to-b from-blue-50/50 via-white to-white dark:from-gray-950 dark:via-gray-900 dark:to-gray-950">
      <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <!-- Badge Superior Animado -->
        <% if (content.hero?.badgeText) { %>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-blue-200 bg-blue-50/90 backdrop-blur-md text-xs font-black text-blue-700 dark:border-yellow-400/40 dark:bg-yellow-400/10 dark:text-yellow-300 mb-6 hover:border-blue-300 shadow-sm transition-all cursor-pointer group">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
          <span><%= content.hero.badgeText %></span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform text-blue-600 dark:text-yellow-400"></i>
        </div>
        <% } %>

        <!-- Título Principal con Efecto Gradiente Atlético -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.12] mb-6">
          <span><%= content.hero?.headlinePrefix || 'La Carrera Más Divertida del Año para' %></span>
          <br>
          <span class="text-gradient bg-gradient-to-r <%= theme.gradient %>">
            <%= content.hero?.headlineGradient || 'Pequeños Campeones & Familias' %>
          </span>
        </h1>

        <!-- Subtítulo Descriptivo -->
        <p class="max-w-3xl mx-auto text-base sm:text-lg lg:text-xl text-slate-600 dark:text-gray-300 font-normal leading-relaxed mb-10">
          <%= content.hero?.subheadline || 'Un día inolvidable de deporte, risas y diversión con premios para los primeros lugares.' %>
        </p>

        <!-- Botones CTA -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
          <a href="<%= content.hero?.primaryCtaLink === '#contact' ? '/inscribir' : (content.hero?.primaryCtaLink || '/inscribir') %>" class="w-full sm:w-auto px-8 py-4 rounded-2xl text-base font-bold <%= theme.solidBtn %> hover:scale-105 shadow-xl shadow-blue-600/30 hover:shadow-blue-600/40 transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
            <span><%= content.hero?.primaryCtaText || 'Inscribir a mi Pequeño/a' %></span>
            <i data-lucide="sparkles" class="w-4 h-4 text-amber-300"></i>
          </a>
          <a href="<%= content.hero?.secondaryCtaLink || '#circuits' %>" class="w-full sm:w-auto px-8 py-4 rounded-2xl text-base font-bold bg-white text-blue-700 border-2 border-blue-600/20 hover:border-blue-600 hover:bg-blue-50/50 dark:bg-gray-900 dark:text-yellow-400 dark:border-yellow-400/40 hover:scale-105 shadow-sm transition-all flex items-center justify-center gap-2">
            <i data-lucide="flag" class="w-5 h-5 text-blue-600 dark:text-yellow-400"></i>
            <span><%= content.hero?.secondaryCtaText || 'Ver Galería & Circuitos' %></span>
          </a>
        </div>

        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-amber-50 dark:bg-yellow-950/40 border border-amber-200/80 dark:border-yellow-500/30 text-xs font-bold text-amber-900 dark:text-yellow-300">
          <i data-lucide="award" class="w-4 h-4 text-amber-600 dark:text-yellow-400"></i>
          <span><%= content.hero?.statsNotice || '🏆 Premiación con medallas para primeros lugares • Cupos limitados' %></span>
        </div>

      </div>
    </section>

    <!-- SECCIÓN CONTADOR REGRESIVO (COUNTDOWN TIMER) -->
    <section id="countdown" style="<%- sStyle('countdown') %>" class="py-14 relative z-10 -mt-6">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-gray-900 p-5 sm:p-10 rounded-3xl border border-blue-100 dark:border-gray-800 shadow-xl shadow-blue-900/5 relative overflow-hidden">
          
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 dark:bg-red-950/60 text-red-600 dark:text-red-400 text-xs font-bold border border-red-200 dark:border-red-900 mb-3">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <%= content.countdown?.badge || '⏰ ¡FALTAN SÓLO!' %>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              Cuenta Regresiva para la Gran Largada
            </h2>
            <p class="text-sm text-slate-500 dark:text-gray-400 mt-1 font-medium">
              <%= content.countdown?.eventDateDisplay || 'Domingo 29 de Noviembre, 2026' %> • <%= content.countdown?.eventTime || '09:00 AM' %>
            </p>
          </div>

          <!-- Bloques del Contador Dinámico -->
          <div id="countdown-timer" data-target="<%= content.countdown?.targetDate || '2026-11-29T10:00:00' %>" class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center max-w-3xl mx-auto">
            
            <div class="p-4 sm:p-6 rounded-3xl bg-blue-50/60 dark:bg-gray-950/90 border border-blue-100 dark:border-gray-800/80 shadow-sm flex flex-col justify-center items-center">
              <span id="cd-days" class="text-4xl sm:text-6xl font-black text-blue-600 dark:text-blue-400">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">DÍAS</span>
            </div>

            <div class="p-4 sm:p-6 rounded-3xl bg-blue-50/60 dark:bg-gray-950/90 border border-blue-100 dark:border-gray-800/80 shadow-sm flex flex-col justify-center items-center">
              <span id="cd-hours" class="text-4xl sm:text-6xl font-black text-blue-600 dark:text-blue-400">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">HORAS</span>
            </div>

            <div class="p-4 sm:p-6 rounded-3xl bg-blue-50/60 dark:bg-gray-950/90 border border-blue-100 dark:border-gray-800/80 shadow-sm flex flex-col justify-center items-center">
              <span id="cd-minutes" class="text-4xl sm:text-6xl font-black text-blue-600 dark:text-blue-400">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">MINUTOS</span>
            </div>

            <div class="p-4 sm:p-6 rounded-3xl bg-amber-50/70 dark:bg-gray-950/90 border border-amber-200 dark:border-gray-800/80 shadow-sm flex flex-col justify-center items-center">
              <span id="cd-seconds" class="text-4xl sm:text-6xl font-black text-amber-500 dark:text-yellow-400">00</span>
              <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-gray-400 font-bold mt-2">SEGUNDOS</span>
            </div>

          </div>

          <!-- Mensaje al expirar -->
          <div id="countdown-expired" class="hidden text-center py-6">
            <span class="text-2xl sm:text-3xl font-black text-blue-600 dark:text-yellow-400">🎉 ¡HOY ES EL GRAN DÍA DE LA CORRIDA! 🎉</span>
            <p class="text-slate-600 dark:text-gray-300 mt-2">¡Nos vemos en el arco de largada! Trae tu kit y toda la energía.</p>
          </div>

          <!-- Tarjetas de Ubicación y Seguridad -->
          <div class="mt-8 pt-6 border-t border-slate-100 dark:border-gray-800 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-600 dark:text-gray-300">
            <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-gray-950/50 border border-slate-100 dark:border-gray-800">
              <div class="w-9 h-9 rounded-xl bg-blue-100 dark:bg-blue-950 flex items-center justify-center flex-shrink-0">
                <i data-lucide="map-pin" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i>
              </div>
              <div>
                <p class="font-bold text-slate-900 dark:text-white"><%= content.countdown?.locationName || 'Sector Costanera • Pedraplén' %></p>
                <p class="text-slate-500 dark:text-gray-400"><%= content.countdown?.locationCity || 'Puerto Varas' %></p>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-gray-950/50 border border-slate-100 dark:border-gray-800">
              <div class="w-9 h-9 rounded-xl bg-red-100 dark:bg-red-950 flex items-center justify-center flex-shrink-0">
                <i data-lucide="shield-check" class="w-5 h-5 text-red-600 dark:text-red-400"></i>
              </div>
              <div>
                <p class="font-bold text-slate-900 dark:text-white">Circuito 100% Protegido</p>
                <p class="text-slate-500 dark:text-gray-400">Sin vehículos • Ambulancia y paramédicos certificados</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- BARRA DE MÉTRICAS -->
    <section class="py-12 border-y border-slate-100 dark:border-white/5 bg-slate-50/60 dark:bg-gray-950/80 backdrop-blur-sm relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <% (content.metrics || []).forEach(metric => { %>
          <div class="space-y-1">
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r <%= theme.gradient %>">
              <%= metric.value %>
            </div>
            <div class="text-xs sm:text-sm font-bold text-slate-600 dark:text-gray-400 flex items-center justify-center gap-1.5">
              <i data-lucide="<%= metric.icon || 'award' %>" class="w-4 h-4 text-blue-600 dark:text-yellow-400"></i>
              <%= metric.label %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE CIRCUITOS Y CATEGORÍAS -->
    <section id="circuits" style="<%- sStyle('circuits') %>" class="py-24 relative z-10 bg-white dark:bg-gray-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400 mb-2 inline-block">CIRCUITOS ADAPTADOS</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
            Una distancia ideal para cada edad
          </h2>
          <p class="text-slate-600 dark:text-gray-400 text-sm sm:text-base mt-3">Diseñados para garantizar la diversión, el esfuerzo sano y la seguridad de cada corredor.</p>
        </div>

        <div class="flex flex-wrap justify-center gap-4 sm:gap-5">
          <% (content.categories || []).forEach(cat => { %>
          <div class="bg-white dark:bg-gray-900/90 p-5 rounded-2xl flex flex-col justify-between border border-slate-200/90 dark:border-white/10 shadow-sm hover:shadow-md hover:border-blue-400 dark:hover:border-yellow-400/60 hover:-translate-y-1 transition-all duration-200 group w-full sm:w-[calc(50%-12px)] lg:w-[calc(25%-16px)] min-w-[210px] max-w-[270px]">
            <div>
              <div class="flex items-center justify-between mb-3.5">
                <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-blue-50 dark:bg-yellow-400/15 text-blue-700 dark:text-yellow-300 border border-blue-200/60 dark:border-yellow-400/30">
                  <%= cat.badge %>
                </span>
                <div class="w-8 h-8 rounded-xl bg-slate-50 dark:bg-gray-800/80 flex items-center justify-center text-blue-600 dark:text-yellow-400 group-hover:bg-blue-600 group-hover:text-white transition-all">
                  <i data-lucide="<%= cat.icon || 'smile' %>" class="w-4 h-4"></i>
                </div>
              </div>

              <div class="text-base sm:text-lg font-black text-slate-900 dark:text-white mb-1"><%= cat.distance %></div>
              <h3 class="text-xs font-bold text-blue-600 dark:text-yellow-400 mb-2 leading-snug"><%= cat.title %></h3>
              <p class="text-[11px] text-slate-500 dark:text-gray-400 leading-relaxed"><%= cat.description %></p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-gray-800/80 flex items-center justify-between text-[11px] font-bold">
              <span class="text-slate-600 dark:text-gray-300 flex items-center gap-1.5">
                <i data-lucide="award" class="w-3.5 h-3.5 text-amber-500"></i> Premiación
              </span>
              <span class="flex items-center gap-1 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                <i data-lucide="shield-check" class="w-3 h-3"></i> Circuito Seguro
              </span>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN CRONOGRAMA DEL DÍA -->
    <section id="schedule" style="<%- sStyle('schedule') %>" class="py-20 bg-slate-50/70 dark:bg-gray-900/40 relative z-10 border-t border-slate-100 dark:border-white/5">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400 mb-2 inline-block"><%= content.scheduleSection?.badge || 'HORARIOS Y ACTIVIDADES' %></span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            <%= content.scheduleSection?.title || 'Cronograma de la Jornada' %>
          </h2>
          <p class="text-slate-600 dark:text-gray-400 text-sm mt-2"><%= content.scheduleSection?.subtitle || 'Dos días de actividades para toda la familia.' %></p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

          <!-- Columna KITS (Sábado) -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-2xl bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center">
                <i data-lucide="package" class="w-5 h-5 text-amber-600 dark:text-amber-400"></i>
              </div>
              <div>
                <p class="text-xs font-black uppercase tracking-widest text-amber-600 dark:text-amber-400"><%= content.scheduleSection?.kitsColumnTitle || 'Sábado 28 de Noviembre' %></p>
                <p class="text-base font-black text-slate-900 dark:text-white"><%= content.scheduleSection?.kitsColumnSubtitle || 'Entrega de Kits' %></p>
              </div>
            </div>
            <div class="space-y-3">
              <% (content.schedule || []).filter(i => i.day === 'kits').forEach(item => { %>
              <div class="bg-white dark:bg-gray-900/80 p-5 rounded-3xl border border-slate-200 dark:border-white/10 flex flex-col sm:flex-row items-start sm:items-center gap-4 shadow-sm hover:border-amber-400 dark:hover:border-amber-400/60 transition-all">
                <div class="px-4 py-2 rounded-2xl bg-amber-500 text-white font-black text-sm tracking-wide shadow-sm flex-shrink-0">
                  <%= item.time %>
                </div>
                <div class="flex-1">
                  <h4 class="text-base font-bold text-slate-900 dark:text-white"><%= item.title %></h4>
                  <% if (item.desc) { %><p class="text-xs text-slate-600 dark:text-gray-400 mt-0.5"><%= item.desc %></p><% } %>
                </div>
              </div>
              <% }); %>
            </div>
          </div>

          <!-- Columna CORRIDA (Domingo) -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-2xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center">
                <i data-lucide="flag" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i>
              </div>
              <div>
                <p class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-blue-400"><%= content.scheduleSection?.raceColumnTitle || 'Domingo 29 de Noviembre' %></p>
                <p class="text-base font-black text-slate-900 dark:text-white"><%= content.scheduleSection?.raceColumnSubtitle || 'Día de la Corrida' %></p>
              </div>
            </div>
            <div class="space-y-3">
              <% (content.schedule || []).filter(i => i.day === 'race' || !i.day).forEach(item => { %>
              <div class="bg-white dark:bg-gray-900/80 p-5 rounded-3xl border border-slate-200 dark:border-white/10 flex flex-col sm:flex-row items-start sm:items-center gap-4 shadow-sm hover:border-blue-400 dark:hover:border-yellow-400/60 transition-all">
                <div class="px-4 py-2 rounded-2xl bg-blue-600 text-white font-black text-sm tracking-wide shadow-sm flex-shrink-0">
                  <%= item.time %>
                </div>
                <div class="flex-1">
                  <h4 class="text-base font-bold text-slate-900 dark:text-white"><%= item.title %></h4>
                  <% if (item.desc) { %><p class="text-xs text-slate-600 dark:text-gray-400 mt-0.5"><%= item.desc %></p><% } %>
                </div>
              </div>
              <% }); %>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECCIÓN GALERÍA DE IMÁGENES INTERACTIVA (CON CARRUSEL Y LIGHTBOX) -->
    <section id="gallery" style="<%- sStyle('gallery') %>" class="py-24 relative z-10 bg-white dark:bg-gray-950 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
          <div class="max-w-2xl">
            <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400 mb-2 inline-block">RECUERDOS INOLVIDABLES</span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-3">
              Galería de Ediciones Anteriores
            </h2>
            <p class="text-slate-600 dark:text-gray-400 text-sm">
              Desliza por nuestro carrusel de momentos épicos o haz clic en cualquier imagen para abrir el visor interactivo.
            </p>
          </div>

          <!-- Controles de Carrusel y Vista -->
          <div class="flex items-center gap-3 shrink-0 self-start md:self-end">
            <!-- Indicador de Diapositiva -->
            <div id="gallery-counter-badge" class="px-3.5 py-2 rounded-2xl bg-slate-100 dark:bg-gray-900 border border-slate-200 dark:border-white/10 text-xs font-mono font-bold text-slate-700 dark:text-gray-300">
              <span id="gallery-current-slide">1</span> / <span id="gallery-total-slides"><%= (content.gallery || []).length %></span>
            </div>

            <!-- Botones Prev / Next del Carrusel -->
            <div class="flex items-center gap-2">
              <button id="gallery-prev-btn" 
                      type="button" 
                      class="w-11 h-11 rounded-2xl bg-slate-100 hover:bg-blue-600 dark:bg-gray-900 dark:hover:bg-blue-600 text-slate-700 hover:text-white dark:text-gray-300 dark:hover:text-white border border-slate-200 dark:border-white/10 flex items-center justify-center transition-all active:scale-95 shadow-sm disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer" 
                      aria-label="Foto anterior">
                <i data-lucide="chevron-left" class="w-5 h-5"></i>
              </button>
              <button id="gallery-next-btn" 
                      type="button" 
                      class="w-11 h-11 rounded-2xl bg-slate-100 hover:bg-blue-600 dark:bg-gray-900 dark:hover:bg-blue-600 text-slate-700 hover:text-white dark:text-gray-300 dark:hover:text-white border border-slate-200 dark:border-white/10 flex items-center justify-center transition-all active:scale-95 shadow-sm disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer" 
                      aria-label="Foto siguiente">
                <i data-lucide="chevron-right" class="w-5 h-5"></i>
              </button>
            </div>

            <!-- Botón Alternar Modo Cuadrícula / Carrusel -->
            <button id="gallery-view-toggle"
                    type="button"
                    class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-2xl text-xs font-bold text-slate-700 dark:text-gray-200 bg-slate-100 hover:bg-slate-200 dark:bg-gray-900 dark:hover:bg-gray-800 border border-slate-200 dark:border-white/10 transition-colors cursor-pointer"
                    title="Alternar entre carrusel y cuadrícula">
              <i data-lucide="layout-grid" class="w-4 h-4"></i>
              <span id="gallery-toggle-label">Ver cuadrícula</span>
            </button>
          </div>
        </div>

        <!-- TRACK DEL CARRUSEL DE IMÁGENES -->
        <div id="gallery-track-container" class="relative">
          <div id="gallery-track" 
               class="flex gap-6 overflow-x-auto no-scrollbar scroll-smooth snap-x snap-mandatory pb-4 select-none cursor-grab active:cursor-grabbing">
            <% (content.gallery || []).forEach((photo, idx) => { %>
            <div class="gallery-item group relative rounded-3xl overflow-hidden bg-white dark:bg-gray-900 border border-slate-200 dark:border-white/10 cursor-pointer shadow-md hover:shadow-2xl transition-all shrink-0 w-[85vw] sm:w-[45vw] lg:w-[calc(33.333%-16px)] snap-start"
                 data-idx="<%= idx %>"
                 data-img-src="<%= photo.url %>"
                 data-img-title="<%= photo.title %>"
                 data-img-caption="<%= photo.caption %>"
                 data-img-category="<%= photo.category || 'Kids Race' %>">
              
              <div class="aspect-w-16 aspect-h-11 w-full h-72 sm:h-80 overflow-hidden bg-slate-100 dark:bg-gray-900">
                <img src="<%= photo.url %>" 
                     alt="<%= photo.title %>" 
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" 
                     loading="lazy">
              </div>

              <!-- Overlay dinámico -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent opacity-85 group-hover:opacity-95 transition-opacity flex flex-col justify-between p-6 text-white">
                <div class="flex justify-between items-center">
                  <span class="text-[11px] font-mono font-bold text-white/80 bg-black/40 px-2.5 py-0.5 rounded-full border border-white/10">#<%= String(idx + 1).padStart(2, '0') %></span>
                  <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-blue-600/90 text-white border border-blue-400/40 backdrop-blur-md">
                    <%= photo.category || 'Kids Race' %>
                  </span>
                </div>
                <div>
                  <h4 class="text-base sm:text-lg font-bold text-white group-hover:text-amber-300 transition-colors flex items-center justify-between">
                    <span><%= photo.title %></span>
                    <i data-lucide="maximize-2" class="w-4 h-4 text-amber-400 opacity-0 group-hover:opacity-100 transition-opacity"></i>
                  </h4>
                  <p class="text-xs text-gray-200 mt-1.5 line-clamp-2 leading-relaxed"><%= photo.caption %></p>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>

        <!-- Indicadores (Dots) debajo del carrusel -->
        <div id="gallery-dots" class="flex justify-center items-center gap-2 mt-6">
          <% (content.gallery || []).forEach((_, idx) => { %>
          <button type="button" 
                  class="gallery-dot h-2 rounded-full transition-all duration-300 cursor-pointer <%= idx === 0 ? 'w-8 bg-blue-600 dark:bg-yellow-400' : 'w-2.5 bg-slate-300 dark:bg-gray-700 hover:bg-slate-400' %>" 
                  data-slide-to="<%= idx %>" 
                  aria-label="Ir a foto <%= idx + 1 %>"></button>
          <% }); %>
        </div>

      </div>
    </section>

    <!-- MODAL LIGHTBOX / CARRUSEL PANTALLA COMPLETA -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl hidden flex items-center justify-center p-3 sm:p-6 transition-all duration-300">
      
      <!-- Botón Cerrar -->
      <button id="lightbox-close" class="absolute top-4 right-4 sm:top-6 sm:right-6 text-gray-300 hover:text-white p-3 rounded-full bg-gray-900/80 hover:bg-gray-800 border border-white/10 transition-colors z-20 cursor-pointer" aria-label="Cerrar visor">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>

      <!-- Botón Anterior (Lightbox) -->
      <button id="lightbox-prev" class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white p-3 sm:p-4 rounded-full bg-black/60 hover:bg-blue-600 border border-white/20 backdrop-blur-md transition-all active:scale-90 z-20 cursor-pointer" aria-label="Foto anterior">
        <i data-lucide="chevron-left" class="w-6 h-6 sm:w-7 sm:h-7"></i>
      </button>

      <!-- Botón Siguiente (Lightbox) -->
      <button id="lightbox-next" class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white p-3 sm:p-4 rounded-full bg-black/60 hover:bg-blue-600 border border-white/20 backdrop-blur-md transition-all active:scale-90 z-20 cursor-pointer" aria-label="Foto siguiente">
        <i data-lucide="chevron-right" class="w-6 h-6 sm:w-7 sm:h-7"></i>
      </button>

      <!-- Contenedor de la Imagen y Datos -->
      <div class="max-w-5xl w-full flex flex-col items-center select-none relative z-10">
        <div class="relative w-full flex justify-center items-center">
          <img id="lightbox-img" src="" alt="Vista ampliada" class="max-h-[72vh] sm:max-h-[76vh] w-auto max-w-full rounded-2xl sm:rounded-3xl shadow-2xl border border-white/15 object-contain transition-all duration-200">
        </div>
        
        <div class="text-center mt-4 max-w-xl px-4">
          <div class="flex items-center justify-center gap-2 mb-2">
            <span id="lightbox-counter" class="text-[11px] font-mono font-bold text-gray-300 bg-white/10 px-3 py-1 rounded-full border border-white/10">Foto 1 de 6</span>
            <span id="lightbox-category" class="text-[11px] font-bold text-blue-300 bg-blue-500/20 px-3 py-1 rounded-full border border-blue-400/30">Carrera</span>
          </div>
          <h3 id="lightbox-title" class="text-lg sm:text-xl font-black text-white tracking-tight"></h3>
          <p id="lightbox-caption" class="text-xs sm:text-sm text-gray-300 mt-1 leading-relaxed"></p>
        </div>
      </div>
    </div>

    <!-- SECCIÓN DE KITS Y PRECIOS -->
    <!-- SECCIÓN INSCRIPCIÓN OFICIAL -->
    <section id="kits" style="<%- sStyle('kits') %>" class="py-28 relative z-10 overflow-hidden">
      <!-- Fondo con gradiente llamativo -->
      <div class="absolute inset-0 bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-700 dark:from-gray-950 dark:via-blue-950 dark:to-indigo-950"></div>
      <!-- Patrón decorativo -->
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 25% 25%, white 1px, transparent 1px), radial-gradient(circle at 75% 75%, white 1px, transparent 1px); background-size: 40px 40px;"></div>
      <!-- Destellos -->
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-yellow-400/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Encabezado central -->
        <div class="text-center mb-16">
          <span class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-yellow-300 mb-4 bg-white/10 px-4 py-1.5 rounded-full">
            <i data-lucide="award" class="w-3.5 h-3.5"></i>
            INSCRIPCIÓN OFICIAL
          </span>
          <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight mb-4">
            <%= content.pricing?.title || '¡Inscribe a tu Campeón!' %>
          </h2>
          <p class="text-blue-100 dark:text-gray-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
            <%= content.pricing?.subtitle || 'Todos los kits incluyen polera técnica oficial, número de corredor, pulsera de color y opción a premiación.' %>
          </p>
          <% if (content.pricing?.discountNotice) { %>
          <p class="mt-4 text-yellow-300 text-xs font-bold tracking-wide"><%= content.pricing.discountNotice %></p>
          <% } %>
        </div>

        <!-- Cards centradas con flex-wrap -->
        <div class="flex flex-wrap justify-center gap-8 items-stretch">
          <% (content.pricing?.plans || []).forEach(plan => { %>
          <div class="relative flex flex-col w-full sm:w-[480px] max-w-[520px] <%= plan.isPopular ? 'bg-white dark:bg-gray-900' : 'bg-white/10 dark:bg-white/5 backdrop-blur-sm border border-white/20' %> rounded-3xl p-10 shadow-2xl transition-all hover:scale-[1.02] duration-300">

            <% if (plan.isPopular) { %>
            <!-- Badge destacado -->
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 flex items-center gap-1.5 bg-gradient-to-r from-yellow-400 to-amber-400 text-gray-900 text-[11px] font-black uppercase tracking-wider px-5 py-1.5 rounded-full shadow-lg shadow-yellow-400/40 whitespace-nowrap">
              <i data-lucide="star" class="w-3 h-3 fill-current"></i>
              <%= plan.badge || 'MÁS ELEGIDO' %>
            </div>
            <% } %>

            <!-- Nombre del plan — centrado -->
            <div class="text-center mb-1 mt-3">
              <h3 class="text-xl font-black <%= plan.isPopular ? 'text-slate-900 dark:text-white' : 'text-white' %> leading-tight"><%= plan.name %></h3>
              <% if (!plan.isPopular && plan.badge) { %>
              <span class="inline-block mt-2 text-[10px] font-black px-3 py-1 rounded-full bg-white/20 text-white uppercase tracking-wide"><%= plan.badge %></span>
              <% } %>
            </div>
            <p class="text-sm mb-6 leading-relaxed text-center <%= plan.isPopular ? 'text-slate-600 dark:text-gray-400' : 'text-blue-100' %>"><%= plan.description %></p>

            <!-- Precio grande — centrado -->
            <div class="flex flex-col items-center mb-8">
              <% 
                // Normalizar precio: soporta número 15000, string "15.000" o "15,000"
                const rawPrice = plan.priceMonthly;
                const numPrice = typeof rawPrice === 'number'
                  ? rawPrice
                  : parseInt(String(rawPrice || '0').replace(/\./g, '').replace(/,/g, ''), 10) || 0;
              %>
              <% if (numPrice > 0) { %>
              <span class="text-6xl font-black <%= plan.isPopular ? 'text-blue-600 dark:text-yellow-400' : 'text-yellow-300' %>">$<%= numPrice.toLocaleString('es-CL') %></span>
              <span class="text-sm font-medium mt-1 <%= plan.isPopular ? 'text-slate-500' : 'text-blue-200' %>">por inscripción</span>
              <% } else { %>
              <span class="text-6xl font-black <%= plan.isPopular ? 'text-green-600' : 'text-green-300' %>">Gratis</span>
              <span class="text-sm font-medium mt-1 <%= plan.isPopular ? 'text-slate-500' : 'text-blue-200' %>">cupo liberado</span>
              <% } %>
            </div>

            <!-- Separador -->
            <div class="border-t <%= plan.isPopular ? 'border-slate-100 dark:border-white/10' : 'border-white/15' %> mb-6"></div>

            <!-- Beneficios -->
            <ul class="space-y-3 mb-8 flex-1">
              <% (plan.features || []).forEach(feat => { %>
              <li class="flex items-start gap-3 text-sm <%= plan.isPopular ? 'text-slate-700 dark:text-gray-300' : 'text-blue-50' %>">
                <div class="mt-0.5 w-5 h-5 rounded-full flex-shrink-0 flex items-center justify-center <%= plan.isPopular ? 'bg-blue-100 dark:bg-blue-950' : 'bg-white/20' %>">
                  <i data-lucide="check" class="w-3 h-3 <%= plan.isPopular ? 'text-blue-600 dark:text-blue-400' : 'text-white' %>"></i>
                </div>
                <span><%= feat %></span>
              </li>
              <% }); %>
            </ul>

            <!-- CTA -->
            <a href="<%= plan.ctaLink || '/inscribir' %>" class="block w-full text-center py-4 px-6 rounded-2xl text-base font-black transition-all hover:scale-[1.02] shadow-lg <%= plan.isPopular ? 'bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-blue-600/40' : 'bg-white/20 hover:bg-white/30 text-white border border-white/30' %>">
              <%= plan.ctaText || 'Inscribirme Ahora' %>
            </a>
          </div>
          <% }); %>
        </div>


        <!-- Garantía / nota al pie -->
        <div class="mt-14 text-center">
          <div class="inline-flex flex-wrap justify-center items-center gap-6 text-blue-100 text-xs font-semibold">
            <span class="flex items-center gap-1.5"><i data-lucide="shield-check" class="w-4 h-4 text-yellow-300"></i> Inscripción 100% segura</span>
            <span class="flex items-center gap-1.5"><i data-lucide="medal" class="w-4 h-4 text-yellow-300"></i> Opción a medalla para primeros lugares</span>
            <span class="flex items-center gap-1.5"><i data-lucide="users" class="w-4 h-4 text-yellow-300"></i> Para niños de 0 a 14 años</span>
          </div>
        </div>

      </div>
    </section>

    <!-- SECCIÓN DE TESTIMONIOS -->
    <section id="testimonials" style="<%- sStyle('testimonials') %>" class="py-24 relative z-10 bg-white dark:bg-gray-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400 mb-2 inline-block">EXPERIENCIA FAMILIAR</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Opiniones de Papás y Mamás
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <% (content.testimonials || []).forEach(testimonial => { %>
          <div class="bg-white dark:bg-gray-900/60 p-8 rounded-3xl flex flex-col justify-between border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-xl hover:border-blue-200 transition-all">
            <div>
              <div class="flex items-center gap-1 text-amber-400 dark:text-yellow-400 mb-4">
                <% for (let i = 0; i < (testimonial.stars || 5); i++) { %>
                <i data-lucide="star" class="w-4 h-4 fill-amber-400 text-amber-400"></i>
                <% } %>
              </div>
              <p class="text-slate-700 dark:text-gray-300 text-sm leading-relaxed mb-6 italic">
                "<%= testimonial.quote %>"
              </p>
            </div>
            <div class="flex items-center gap-3 pt-4 border-t border-slate-100 dark:border-gray-800">
              <img src="<%= testimonial.avatar %>" alt="<%= testimonial.name %>" class="w-10 h-10 rounded-full object-cover border border-blue-200 dark:border-blue-900" loading="lazy">
              <div>
                <p class="text-sm font-bold text-slate-900 dark:text-white"><%= testimonial.name %></p>
                <p class="text-xs text-slate-500 dark:text-gray-400"><%= testimonial.role %></p>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE PREGUNTAS FRECUENTES (FAQ) -->
    <section id="faq" style="<%- sStyle('faq') %>" class="py-24 relative z-10 bg-slate-50/70 dark:bg-gray-900/30 border-t border-slate-100 dark:border-white/5">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400 mb-2 inline-block">RESOLVEMOS TUS DUDAS</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
            Preguntas Frecuentes para Padres
          </h2>
        </div>

        <div class="space-y-4">
          <% (content.faqs || []).forEach((faq, index) => { %>
          <div class="faq-item bg-white dark:bg-gray-900/60 rounded-3xl border border-slate-200 dark:border-white/10 shadow-sm overflow-hidden transition-all">
            <button class="faq-trigger w-full px-6 py-5 text-left flex items-center justify-between text-base font-bold text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-yellow-300 transition-colors">
              <span><%= faq.question %></span>
              <i data-lucide="chevron-down" class="faq-icon w-5 h-5 text-slate-400 dark:text-gray-400 transition-transform duration-300"></i>
            </button>
            <div class="faq-content <%= index === 0 ? '' : 'hidden' %> px-6 pb-5 text-sm text-slate-600 dark:text-gray-300 leading-relaxed border-t border-slate-100 dark:border-white/5 pt-3">
              <%= faq.answer %>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE AUSPICIADORES & MARCAS OFICIALES (CON TRANSICIONES Y TAMAÑO UNIFORME) -->
    <% if (content.sponsors && content.sponsors.list && content.sponsors.list.length > 0) { %>
    <section id="sponsors" style="<%- sStyle('sponsors') %>" class="py-20 relative z-10 bg-slate-50/50 dark:bg-gray-900/40 border-t border-slate-100 dark:border-white/5 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 text-center">
        <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400 mb-2 inline-block">
          <%= content.sponsors.badge || 'COMPAÑÍAS QUE IMPULSAN EL DEPORTE INFANTIL' %>
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
          <%= content.sponsors.title || 'Nuestros Auspiciadores Oficiales' %>
        </h2>
        <% if (content.sponsors.description) { %>
        <p class="text-slate-600 dark:text-gray-400 text-xs sm:text-sm mt-2 max-w-2xl mx-auto">
          <%= content.sponsors.description %>
        </p>
        <% } %>
      </div>

      <!-- Carrusel Continuo con Transiciones Interactivas -->
      <div class="relative w-full overflow-hidden py-4">
        <!-- Máscaras de degradado lateral para efecto de desvanecimiento suave -->
        <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-20 sm:w-32 bg-gradient-to-r from-slate-50 dark:from-gray-950 to-transparent z-20"></div>
        <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-20 sm:w-32 bg-gradient-to-l from-slate-50 dark:from-gray-950 to-transparent z-20"></div>

        <div class="sponsors-track flex items-center gap-6 sm:gap-8 px-4">
          <!-- Duplicamos la lista para crear bucle infinito sin saltos -->
          <% const sponsorItems = [...content.sponsors.list, ...content.sponsors.list]; %>
          <% sponsorItems.forEach((sp, idx) => { %>
          <a href="<%= sp.website || '#' %>" 
             target="<%= sp.website ? '_blank' : '_self' %>" 
             rel="noopener"
             class="sponsor-card flex-shrink-0 group block p-4 sm:p-5 rounded-3xl bg-white dark:bg-gray-900 border border-slate-200 dark:border-gray-800 shadow-sm hover:shadow-xl hover:border-blue-300 dark:hover:border-blue-500/50"
             title="<%= sp.name %> - <%= sp.tier || 'Auspiciador' %>">
            <!-- Contenedor con tamaño uniforme estricto (200px ancho x 90px alto) -->
            <div class="w-48 sm:w-56 h-20 sm:h-24 flex items-center justify-center p-2 rounded-2xl bg-slate-50/70 dark:bg-gray-950/60 overflow-hidden">
              <img src="<%= sp.logoUrl %>" 
                   alt="<%= sp.name %>" 
                   class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-105"
                   loading="lazy">
            </div>
            <div class="mt-2.5 text-center">
              <p class="text-xs font-bold text-slate-800 dark:text-gray-200 truncate group-hover:text-blue-600 dark:group-hover:text-yellow-400 transition-colors"><%= sp.name %></p>
              <% if (sp.tier) { %>
              <span class="text-[10px] font-semibold text-slate-400 dark:text-gray-500 uppercase tracking-wider block truncate"><%= sp.tier %></span>
              <% } %>
            </div>
          </a>
          <% }); %>
        </div>
      </div>
    </section>
    <% } %>

    <!-- SECCIÓN: LUGAR DEL EVENTO (MAPA INTERACTIVO) -->
    <% if (content.venue !== false) { %>
    <section id="venue" style="<%- sStyle('venue') %>" class="py-20 relative z-10 bg-white dark:bg-gray-950 border-t border-slate-100 dark:border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-10">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 text-xs font-bold uppercase tracking-widest mb-4">
            <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
            <%= content.venue?.badge || 'Punto de Largada' %>
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mb-3">
            <%= content.venue?.title || '¿Dónde es la corrida?' %>
          </h2>
          <p class="text-slate-500 dark:text-gray-400 text-base max-w-xl mx-auto">
            <%= content.venue?.description || 'Encuéntranos en el lugar del evento. ¡Llega con tiempo para disfrutar la previa!' %>
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
          <!-- Info del lugar -->
          <div class="space-y-4 lg:col-span-1">
            <div class="bg-slate-50 dark:bg-gray-900 rounded-3xl p-6 border border-slate-100 dark:border-gray-800">
              <h3 class="font-black text-slate-900 dark:text-white text-lg mb-4 flex items-center gap-2">
                <i data-lucide="flag" class="w-5 h-5 text-blue-600 dark:text-yellow-400"></i>
                <%= content.venue?.name || content.countdown?.locationName || 'Costanera Puerto Varas' %>
              </h3>
              <ul class="space-y-3 text-sm text-slate-600 dark:text-gray-400">
                <li class="flex items-start gap-2.5">
                  <i data-lucide="map-pin" class="w-4 h-4 text-blue-600 dark:text-yellow-400 mt-0.5 shrink-0"></i>
                  <span><%= content.venue?.address || (content.countdown?.locationName + ', ' + content.countdown?.locationCity) || 'Av. Vicente Pérez Rosales, Puerto Varas' %></span>
                </li>
                <li class="flex items-start gap-2.5">
                  <i data-lucide="clock" class="w-4 h-4 text-blue-600 dark:text-yellow-400 mt-0.5 shrink-0"></i>
                  <span>Apertura de puertas: <%= content.venue?.doorsOpen || '08:00 AM' %> — Largada: <%= content.countdown?.eventTime || '09:00 AM' %></span>
                </li>
                <li class="flex items-start gap-2.5">
                  <i data-lucide="car" class="w-4 h-4 text-blue-600 dark:text-yellow-400 mt-0.5 shrink-0"></i>
                  <span><%= content.venue?.parking || 'Estacionamientos disponibles en calles aledañas a la Costanera y sector Puerto Chico.' %></span>
                </li>
                <li class="flex items-start gap-2.5">
                  <i data-lucide="bus" class="w-4 h-4 text-blue-600 dark:text-yellow-400 mt-0.5 shrink-0"></i>
                  <span><%= content.venue?.transit || 'Locomoción colectiva y buses por Av. Vicente Pérez Rosales.' %></span>
                </li>
              </ul>
              <a href="https://www.google.com/maps/search/<%= encodeURIComponent(content.venue?.address || content.countdown?.locationName || 'Costanera Puerto Varas Sector Pedraplen') %>" target="_blank" rel="noopener noreferrer" class="mt-5 flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-2xl text-sm font-bold bg-blue-600 hover:bg-blue-700 dark:bg-yellow-400 dark:hover:bg-yellow-300 text-white dark:text-gray-900 transition-all shadow-md shadow-blue-600/20 dark:shadow-yellow-400/10">
                <i data-lucide="navigation" class="w-4 h-4"></i>
                Abrir en Google Maps
              </a>
            </div>
          </div>

          <!-- Mapa Leaflet -->
          <div class="lg:col-span-2">
            <div id="venue-map" class="w-full h-80 sm:h-96 rounded-3xl overflow-hidden shadow-xl border border-slate-200 dark:border-gray-800 z-0 relative"></div>
          </div>
        </div>
      </div>
    </section>
    <% } %>


    <!-- SECCIÓN DE CONTACTO & ATENCIÓN A FAMILIAS -->
    <section id="contact" style="<%- sStyle('contact') %>" class="py-24 bg-white dark:bg-gray-950 relative z-10 border-t border-slate-100 dark:border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          
          <!-- Información y Canales Oficiales -->
          <div class="space-y-6">
            <span class="text-xs font-black uppercase tracking-widest text-blue-600 dark:text-yellow-400">ESTAMOS PARA AYUDARTE</span>
