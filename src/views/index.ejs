                  <i data-lucide="mail" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-gray-400">Correo Electrónico</p>
                  <p class="font-bold text-slate-900 dark:text-white"><%= content.contact?.email || 'contacto@kkidsrace.cl' %></p>
                </div>
              </div>

              <div class="flex items-center gap-3 text-sm text-slate-700 dark:text-gray-300">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 dark:bg-gray-900 border border-blue-100 dark:border-gray-800 flex items-center justify-center text-blue-600 dark:text-yellow-400 shadow-sm">
                  <i data-lucide="phone" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-gray-400">WhatsApp de Atención</p>
                  <p class="font-bold text-slate-900 dark:text-white"><%= content.contact?.phone || '+56 9 8765 4321' %></p>
                </div>
              </div>

              <div class="flex items-center gap-3 text-sm text-slate-700 dark:text-gray-300">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 dark:bg-gray-900 border border-blue-100 dark:border-gray-800 flex items-center justify-center text-blue-600 dark:text-yellow-400 shadow-sm">
                  <i data-lucide="map-pin" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="text-xs text-slate-500 dark:text-gray-400">Ubicación del Evento</p>
                  <p class="font-bold text-slate-900 dark:text-white"><%= content.contact?.location || 'Costanera Puerto Varas • Sector Pedraplén' %></p>
                </div>
              </div>
            </div>

            <!-- Banner Invitación a Inscripción -->
            <div class="p-4 rounded-2xl bg-blue-50/80 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/40 flex items-center justify-between">
              <div>
                <p class="text-xs font-bold text-blue-900 dark:text-blue-200">¿Listo para inscribir a tu hijo/a?</p>
                <p class="text-[11px] text-blue-700 dark:text-blue-300">Reserva su cupo y polera oficial en 1 minuto.</p>
              </div>
