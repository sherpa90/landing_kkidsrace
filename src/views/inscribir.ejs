      // ─── RUT Chileno Formateador en Vivo ─────────────────────────────────────
      const rutInput = document.getElementById('tutorRut');
      const rutIndicator = document.getElementById('rut-status-indicator');
      const rutError = document.getElementById('rutError');

      function validateRut(rut) {
        if (!rut) return false;
        const clean = rut.replace(/\./g, '').replace(/-/g, '').trim().toUpperCase();
        if (!/^\d{7,8}[0-9K]$/.test(clean)) return false;
        const body = clean.slice(0, -1);
        let dv = clean.slice(-1);
        let sum = 0, mul = 2;
        for (let i = body.length - 1; i >= 0; i--) {
          sum += parseInt(body[i], 10) * mul;
          mul = mul === 7 ? 2 : mul + 1;
        }
        const expected = 11 - (sum % 11);
        const expectedDv = expected === 11 ? '0' : expected === 10 ? 'K' : String(expected);
        return dv === expectedDv;
      }

      function formatRut(value) {
        let clean = value.replace(/[^0-9kK]/g, '').toUpperCase();
        if (clean.length === 0) return '';
        if (clean.length === 1) return clean;
        const dv = clean.slice(-1);
        let body = clean.slice(0, -1);
        body = body.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        return `${body}-${dv}`;
      }

      if (rutInput) {
        rutInput.addEventListener('input', (e) => {
          const formatted = formatRut(e.target.value);
          e.target.value = formatted;

          if (formatted.length >= 8) {
            const isValid = validateRut(formatted);
            if (isValid) {
              if (rutIndicator) {
                rutIndicator.textContent = '✓ RUT Válido';
                rutIndicator.className = 'text-[10px] text-emerald-600 dark:text-emerald-400 font-bold block';
              }
              if (rutError) rutError.classList.add('hidden');
              rutInput.classList.remove('border-red-500');
            } else {
              if (rutIndicator) rutIndicator.classList.add('hidden');
            }
          } else {
            if (rutIndicator) rutIndicator.classList.add('hidden');
          }
          updateFormProgress();
        });

        rutInput.addEventListener('blur', () => {
          if (rutInput.value && !validateRut(rutInput.value)) {
            if (rutError) rutError.classList.remove('hidden');
            rutInput.classList.add('border-red-500');
          } else {
            if (rutError) rutError.classList.add('hidden');
            rutInput.classList.remove('border-red-500');
          }
        });
      }

      // ─── Subida de Comprobante Asíncrona (Límite 3 MB + Compresión Server) ─────
      const fileInput = document.getElementById('paymentFileInput');
      const idleState = document.getElementById('upload-idle-state');
      const loadingState = document.getElementById('upload-loading-state');
      const successState = document.getElementById('upload-success-state');
      const previewImg = document.getElementById('payment-preview-img');
      const fileInfo = document.getElementById('payment-file-info');
      const proofHidden = document.getElementById('paymentProofUrl');
      const btnChange = document.getElementById('btn-change-payment');

      if (fileInput) {
        fileInput.addEventListener('change', async () => {
          if (!fileInput.files || fileInput.files.length === 0) return;
          const file = fileInput.files[0];

          // Validación estricta en el cliente de 3 MB
          if (file.size > 3 * 1024 * 1024) {
            alert('La captura no debe superar los 3 MB. Por favor comprime la imagen o adjunta una captura de menor tamaño.');
            fileInput.value = '';
            return;
          }

          idleState.classList.add('hidden');
          successState.classList.add('hidden');
          loadingState.classList.remove('hidden');

          try {
            const csrfToken = document.getElementById('csrfTokenField')?.value || '';
            const formData = new FormData();
            formData.append('proof', file);

            const res = await fetch('/api/upload-proof', {
              method: 'POST',
              headers: { 'X-CSRF-Token': csrfToken },
              body: formData
            });

            const json = await res.json();
            if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo procesar el comprobante');

            proofHidden.value = json.data.url;
            previewImg.src = json.data.url;
            const kb = (json.data.sizeBytes / 1024).toFixed(1);
            fileInfo.textContent = `Optimizado a WebP (${kb} KB) • Guardado seguro`;

            loadingState.classList.add('hidden');
            successState.classList.remove('hidden');
            if (window.lucide) window.lucide.createIcons();
            updateFormProgress();
          } catch (err) {
            alert('Error al subir comprobante: ' + err.message);
            loadingState.classList.add('hidden');
            idleState.classList.remove('hidden');
          }
        });
      }

      if (btnChange) {
        btnChange.addEventListener('click', (e) => {
          e.stopPropagation();
          proofHidden.value = '';
          fileInput.value = '';
          successState.classList.add('hidden');
          idleState.classList.remove('hidden');
          updateFormProgress();
        });
      }

      // ─── Barra de Progreso Dinámica ──────────────────────────────────────────
      function updateFormProgress() {
        let score = 20; // Base inicial
        const tFn = document.getElementById('tutorFirstName')?.value || '';
        const tLn = document.getElementById('tutorLastName')?.value || '';
        const rutVal = document.getElementById('tutorRut')?.value || '';
        const emailVal = document.getElementById('email')?.value || '';
        const phoneVal = document.getElementById('phone')?.value || '';
        const proofVal = proofHidden?.value || '';

        const firstKid = document.querySelector('.kid-card');
        const kFn = firstKid?.querySelector('.kid-firstname-input')?.value || '';
        const kLn = firstKid?.querySelector('.kid-lastname-input')?.value || '';

        if (kFn.length >= 2 && kLn.length >= 2) score += 30;
        if (tFn.length >= 2 && tLn.length >= 2 && validateRut(rutVal)) score += 30;
        if (emailVal.includes('@') && phoneVal.length >= 7) score += 20;
        if (proofVal) score += 20;

        score = Math.min(100, score);
        const pBar = document.getElementById('form-progress-bar');
        const pText = document.getElementById('form-progress-text');
        if (pBar) pBar.style.width = score + '%';
        if (pText) pText.textContent = score + '%';
      }

      ['tutorFirstName', 'tutorLastName', 'email', 'phone'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', updateFormProgress);
      });

