<!DOCTYPE html>
<html lang="es" class="<%= themeMode === 'dark' ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscripción Oficial | <%= activeRace ? activeRace.name : (content.brand?.name || 'KidsRun') %></title>
  <link rel="icon" type="image/x-icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <link rel="shortcut icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <link rel="apple-touch-icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <meta name="description" content="Inscribe a tu pequeño/a en la corrida infantil más alegre y segura. Selecciona su distancia y asegura su kit con medalla oficial.">

  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              500: '#22c55e',
              600: '#16a34a'
            }
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lucide@1.47.0"></script>
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    /* Variables de tema dinámico desde el CMS */
    :root {
      --theme-primary: <%= theme.primaryHex || '#2563eb' %>;
      --theme-primary-dark: <%= theme.primaryDark || theme.primaryHex || '#1d4ed8' %>;
      --theme-secondary: <%= theme.secondaryHex || '#4f46e5' %>;
    }
    /* Estilos Mobile First para selecciones táctiles */
    .touch-card {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      -webkit-tap-highlight-color: transparent;
    }
    .touch-card:active { transform: scale(0.98); }
    .step-badge.active { box-shadow: 0 0 0 4px color-mix(in srgb, var(--theme-primary) 30%, transparent); }
    .distance-card-selected {
      border-color: var(--theme-primary) !important;
      border-width: 2px !important;
    }
    .distance-badge-selected {
      background-color: var(--theme-primary) !important;
      color: white !important;
    }
    .distance-title-selected {
      color: var(--theme-primary) !important;
    }
    .btn-theme {
      background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
      box-shadow: 0 10px 25px -5px color-mix(in srgb, var(--theme-primary) 40%, transparent);
    }
    .btn-theme:hover {
      background: linear-gradient(135deg, var(--theme-primary-dark, var(--theme-primary)), var(--theme-secondary));
      opacity: 0.93;
    }
    .hero-gradient {
      background: linear-gradient(135deg, var(--theme-primary), var(--theme-secondary));
    }
    .step-circle {
      background-color: var(--theme-primary);
    }
    .focus-theme:focus { border-color: var(--theme-primary) !important; }
    .text-theme { color: var(--theme-primary) !important; }
    .selection-theme::selection { background-color: var(--theme-primary); color: white; }
  </style>
</head>
<body class="bg-slate-50 dark:bg-gray-950 text-slate-800 dark:text-gray-100 min-h-screen flex flex-col antialiased selection-theme">

  <!-- BARRA DE NAVEGACIÓN SUPERIOR FIJA Y MINIMALISTA -->
  <header class="sticky top-0 z-40 bg-white/90 dark:bg-gray-950/90 backdrop-blur-md border-b border-slate-200 dark:border-gray-800">
    <div class="max-w-xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-slate-700 dark:text-gray-300 hover:opacity-80 text-xs font-bold transition-opacity" style="--hover-color: var(--theme-primary)">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Volver a la Portada</span>
      </a>

      <div class="flex items-center gap-2">
        <% if (content.brand?.logoUrl) { %>
        <img src="<%= content.brand.logoUrl %>" alt="<%= content.brand?.name || 'KidsRun' %>" class="h-8 w-auto object-contain max-w-[140px]">
        <% } else { %>
        <div class="w-7 h-7 rounded-xl text-white flex items-center justify-center font-black text-xs shadow-sm step-circle">
          <i data-lucide="medal" class="w-4 h-4"></i>
        </div>
        <span class="text-xs font-black text-slate-900 dark:text-white tracking-tight uppercase"><%= content.brand?.name || 'KidsRun 2026' %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- BANNER FLOTANTE DE AVISO: MODO CONSTRUCCIÓN ACTIVO (SOLO VISIBLE PARA ADMIN) -->
  <% if (typeof constructionAdminBypass !== 'undefined' && constructionAdminBypass) { %>
  <div class="bg-amber-500 text-slate-950 px-4 py-2 border-b border-amber-600 shadow-md">
    <div class="max-w-xl mx-auto flex items-center justify-between gap-2 text-xs font-bold">
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-red-700 animate-ping"></span>
        <span>Modo Construcción Activo (Bypass Admin)</span>
      </div>
      <a href="/preview-construction" target="_blank" class="px-2 py-0.5 rounded-lg bg-slate-950 text-white text-[10px] font-black">
        Ver público
      </a>
    </div>
  </div>
  <% } %>

  <!-- CONTENEDOR PRINCIPAL MOBILE-FIRST -->
  <main class="flex-1 w-full max-w-xl mx-auto px-4 py-6 sm:py-8">

    <!-- CABECERA DEL EVENTO Y CORRIDA ACTIVA -->
    <div class="hero-gradient rounded-3xl p-6 text-white shadow-xl mb-6 relative overflow-hidden">
      <!-- Círculos decorativos de fondo -->
      <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
      <div class="absolute -left-6 -top-6 w-24 h-24 bg-yellow-400/20 rounded-full blur-lg pointer-events-none"></div>

      <div class="relative z-10">
        <% if (activeRace && activeRace.status === 'paused') { %>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 backdrop-blur-md text-[11px] font-black uppercase tracking-wider mb-2.5 text-amber-300 border border-amber-500/40">
          <i data-lucide="pause-circle" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>Inscripciones Temporalmente Pausadas</span>
        </div>
        <% } else if (!activeRace || activeRace.status === 'inactive' || activeRace.status === 'planned') { %>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-black uppercase tracking-wider mb-2.5 text-white/80 border border-white/20">
          <i data-lucide="calendar" class="w-3.5 h-3.5 text-white/80"></i>
          <span>Próxima Edición en Preparación</span>
        </div>
        <% } else { %>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-black uppercase tracking-wider mb-2.5 text-yellow-300 border border-white/20">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Inscripciones Oficiales Abiertas</span>
        </div>
        <% } %>

        <h1 class="text-xl sm:text-2xl font-black tracking-tight mb-1 text-white">
          <%= content.registrationForm?.heroTitle || (activeRace ? activeRace.name : 'KidsRun 2026 - Edición Oficial') %>
        </h1>
        <p class="text-sm text-white/80 font-medium mb-2"><%= content.registrationForm?.heroSubtitle || '' %></p>

        <div class="flex flex-wrap items-center gap-y-1.5 gap-x-4 text-xs text-white/80 font-medium mt-2">
          <div class="flex items-center gap-1.5">
            <i data-lucide="calendar" class="w-3.5 h-3.5 text-yellow-300"></i>
            <span><%= activeRace ? (activeRace.dateDisplay || activeRace.date) : 'Domingo 15 de Noviembre, 2026' %></span>
          </div>
          <div class="flex items-center gap-1.5">
            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-yellow-300"></i>
            <span class="truncate"><%= activeRace ? activeRace.location.split('•')[0] : 'Parque Bicentenario' %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- BENEFICIOS CLAVE EN MÓVIL (Puntos de Confianza) -->
    <div class="grid grid-cols-3 gap-2 mb-6 text-center">
      <div class="p-2.5 bg-white dark:bg-gray-900 rounded-2xl border border-slate-200 dark:border-gray-800 shadow-sm">
        <i data-lucide="<%= content.registrationForm?.badge1Icon || 'award' %>" class="w-5 h-5 mx-auto text-amber-500 mb-1"></i>
        <p class="text-[11px] font-bold text-slate-800 dark:text-white leading-tight"><%= content.registrationForm?.badge1Text || 'Medalla Finisher' %></p>
        <p class="text-[9px] text-slate-400"><%= content.registrationForm?.badge1Sub || '100% garantizada' %></p>
      </div>
      <div class="p-2.5 bg-white dark:bg-gray-900 rounded-2xl border border-slate-200 dark:border-gray-800 shadow-sm">
        <i data-lucide="<%= content.registrationForm?.badge2Icon || 'shield-check' %>" class="w-5 h-5 mx-auto text-emerald-500 mb-1"></i>
        <p class="text-[11px] font-bold text-slate-800 dark:text-white leading-tight"><%= content.registrationForm?.badge2Text || 'Circuito Seguro' %></p>
        <p class="text-[9px] text-slate-400"><%= content.registrationForm?.badge2Sub || '100% cerrado' %></p>
      </div>
      <div class="p-2.5 bg-white dark:bg-gray-900 rounded-2xl border border-slate-200 dark:border-gray-800 shadow-sm">
        <i data-lucide="<%= content.registrationForm?.badge3Icon || 'shirt' %>" class="w-5 h-5 mx-auto mb-1" style="color: var(--theme-primary)"></i>
        <p class="text-[11px] font-bold text-slate-800 dark:text-white leading-tight"><%= content.registrationForm?.badge3Text || 'Polera Oficial' %></p>
        <p class="text-[9px] text-slate-400"><%= content.registrationForm?.badge3Sub || 'Incluida en Kit' %></p>
      </div>
    </div>

    <!-- FORMULARIO PRINCIPAL -->
    <form id="registration-form" class="space-y-6">
      <input type="hidden" name="raceId" value="<%= activeRace ? activeRace.id : 'race-2026-primavera' %>">
      <input type="hidden" name="raceName" value="<%= activeRace ? activeRace.name : 'KidsRun 2026' %>">
      <input type="hidden" id="paymentProofUrl" name="paymentProof" value="">
      <!-- CSRF Token para protección contra ataques de sitios cruzados -->
      <input type="hidden" id="csrfTokenField" name="csrfToken" value="<%= csrfToken %>">
      <!-- Honeypot: campo invisible para detectar bots -->
      <div style="display:none; visibility:hidden; position:absolute; left:-9999px;" aria-hidden="true">
        <label for="website_url">Sitio web (no completar)</label>
        <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
      </div>

      <!-- PASO 1: SELECCIÓN DEL CIRCUITO / DISTANCIA (TOUCH UI) -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full text-white font-black text-xs flex items-center justify-center step-circle">1</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white"><%= content.registrationForm?.step1Title || 'Selecciona el Circuito' %></h2>
          </div>
          <span class="text-[11px] font-medium text-theme"><%= content.registrationForm?.step1Hint || 'Por edad sugerida' %></span>
        </div>

        <div class="grid grid-cols-2 gap-2.5" id="distance-selector">
          <% const formCategories = (content.categories && content.categories.length > 0) ? content.categories : [
            { distance: '500 Metros', badge: '3-5 años', title: 'Mini Runners', description: 'Acompañado de papás' },
            { distance: '1 Kilómetro', badge: '6-8 años', title: 'Pequeños Rayos', description: 'Circuito plano seguro' },
            { distance: '2 Kilómetros', badge: '9-11 años', title: 'Súper Campeones', description: 'Con cronometraje' },
            { distance: '3 Kilómetros', badge: '12-14 años', title: 'Jóvenes Titanes', description: 'Gran desafío atlético' }
          ]; %>
          <% formCategories.forEach((cat, idx) => {
               const val = `${cat.distance} (${cat.badge})`;
               const isFirst = idx === 0;
          %>
          <div class="touch-card distance-option cursor-pointer p-3.5 rounded-2xl border <%= isFirst ? 'distance-card-selected border-2' : 'border-slate-200 dark:border-gray-800 bg-white dark:bg-gray-950' %> relative" data-distance="<%= val %>">
            <div class="flex items-center justify-between mb-1">
              <span class="dist-title text-xs font-black <%= isFirst ? 'distance-title-selected' : 'text-slate-800 dark:text-white' %>"><%= (cat.distance || '').split(' ')[0] %></span>
              <span class="dist-badge text-[10px] <%= isFirst ? 'distance-badge-selected' : 'bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-gray-300' %> font-bold px-1.5 py-0.5 rounded-full"><%= cat.badge %></span>
            </div>
            <p class="text-[11px] font-semibold text-slate-800 dark:text-gray-200"><%= cat.title %></p>
            <p class="text-[10px] text-slate-400 mt-0.5 truncate"><%= cat.description %></p>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- PASO 2: HIJOS / CORREDORES (MULTI-CHILD) -->
      <div id="kids-wrapper" class="space-y-4">
        <!-- Primer hijo (índice 0) -->
        <div class="kid-block bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4" data-kid-index="0">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full text-white font-black text-xs flex items-center justify-center step-circle">2</span>
              <h2 class="text-sm font-bold text-slate-900 dark:text-white"><%= content.registrationForm?.step2Title || 'Datos del Pequeño/a' %></h2>
            </div>
            <!-- Botón eliminar hijo (oculto en el primero) -->
            <button type="button" class="btn-remove-kid hidden items-center gap-1 text-[11px] text-red-500 hover:text-red-700 font-bold transition-colors">
              <i data-lucide="x-circle" class="w-4 h-4"></i> Quitar
            </button>
          </div>

          <!-- Selección de circuito específica para este hijo (inline) -->
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Circuito del participante *</label>
            <select class="kid-distance-select w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors">
              <% formCategories.forEach((cat, idx) => { %>
              <option value="<%= cat.distance %> (<%= cat.badge %>)" <%= idx === 0 ? 'selected' : '' %>><%= cat.distance %> - <%= cat.title %> (<%= cat.badge %>)</option>
              <% }); %>
            </select>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2">
              <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1"><%= content.registrationForm?.step2KidNameLabel || 'Nombre o Apodo *' %></label>
              <input type="text" class="kid-name-input w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors" required maxlength="60" placeholder="<%= content.registrationForm?.step2KidNamePlaceholder || 'Ej: Mateo o Sofi' %>" autocomplete="off" autocapitalize="words">
              <span class="text-[10px] text-slate-400 block mt-1"><%= content.registrationForm?.step2KidNameHint || 'Se imprimirá en su número oficial de carrera.' %></span>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1"><%= content.registrationForm?.step2KidAgeLabel || 'Edad *' %></label>
              <input type="number" class="kid-age-input w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors" required min="2" max="15" inputmode="numeric" pattern="[0-9]*" placeholder="6">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-gray-400 mb-1"><%= content.registrationForm?.step2MedicalLabel || 'Alergias o notas médicas (Opcional)' %></label>
            <input type="text" class="kid-medical-input w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2 text-xs text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors" maxlength="500" placeholder="<%= content.registrationForm?.step2MedicalPlaceholder || 'Ej: Asma leve, alergia al maní...' %>">
          </div>
        </div>
      </div>

      <!-- BOTÓN AGREGAR HIJO -->
      <% if (activeRace && (activeRace.status === 'active' || activeRace.status === 'open')) { %>
      <button type="button" id="btn-add-kid" class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-gray-700 text-slate-500 dark:text-gray-400 hover:border-opacity-80 hover:text-slate-700 dark:hover:text-gray-200 text-xs font-bold transition-all" style="border-color: color-mix(in srgb, var(--theme-primary) 50%, transparent)">
        <i data-lucide="user-plus" class="w-4 h-4" style="color: var(--theme-primary)"></i>
        <span style="color: var(--theme-primary)"><%= content.registrationForm?.addChildButtonText || 'Agregar otro hijo/a' %></span>
      </button>
      <% } %>

      <!-- PASO 3: DATOS DEL PADRE / TUTOR LEGAL -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full text-white font-black text-xs flex items-center justify-center step-circle">3</span>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white"><%= content.registrationForm?.step3Title || 'Datos del Padre / Tutor' %></h2>
        </div>

        <div class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="name" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1"><%= content.registrationForm?.step3NameLabel || 'Nombre Completo *' %></label>
              <input type="text" id="name" name="name" required maxlength="100" placeholder="<%= content.registrationForm?.step3NamePlaceholder || 'Tu Nombre y Apellido' %>" autocomplete="name" autocapitalize="words" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors">
            </div>

            <div>
              <label for="tutorRut" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1"><%= content.registrationForm?.step3RutLabel || 'RUT o DNI del Padre/Tutor *' %></label>
              <input type="text" id="tutorRut" name="tutorRut" required maxlength="15" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" placeholder="<%= content.registrationForm?.step3RutPlaceholder || 'Ej: 12.345.678-9' %>" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors">
              <span id="rutError" class="text-[10px] text-red-500 hidden mt-1 block">RUT inválido. Verifica el formato (ej: 12.345.678-9).</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="email" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1"><%= content.registrationForm?.step3EmailLabel || 'Correo Electrónico *' %></label>
              <input type="email" id="email" name="email" required maxlength="254" placeholder="<%= content.registrationForm?.step3EmailPlaceholder || 'tu@correo.com' %>" autocomplete="email" inputmode="email" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors">
            </div>

            <div>
              <label for="phone" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1"><%= content.registrationForm?.step3PhoneLabel || 'WhatsApp / Teléfono *' %></label>
              <input type="tel" id="phone" name="phone" required maxlength="30" placeholder="<%= content.registrationForm?.step3PhonePlaceholder || '+56 9 1234 5678' %>" autocomplete="tel" inputmode="tel" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors">
            </div>
          </div>
        </div>
      </div>

      <!-- PASO 4: COMPROBANTE DE PAGO -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-black text-xs flex items-center justify-center">4</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white"><%= content.registrationForm?.step4Title || 'Comprobante de Pago' %></h2>
          </div>
          <span class="text-[10px] bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-bold px-2 py-0.5 rounded-full border border-emerald-300 dark:border-emerald-800">
            <%= content.registrationForm?.step4Badge || 'Acreditación Rápida' %>
          </span>
        </div>

        <p class="text-xs text-slate-500 dark:text-gray-400">
          <%= content.registrationForm?.step4Description || 'Adjunta la foto o captura de transferencia del kit de inscripción. Nuestro servidor la optimizará y guardará de forma permanente.' %>
        </p>

        <!-- ZONA DE CARGA TÁCTIL -->
        <div id="upload-dropzone" class="border-2 border-dashed border-slate-300 dark:border-gray-700 hover:border-emerald-500 dark:hover:border-emerald-500 rounded-2xl p-4 text-center transition-all bg-slate-50/50 dark:bg-gray-950/50 cursor-pointer relative">
          <input type="file" id="paymentFileInput" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
          
          <div id="upload-idle-state" class="space-y-2 pointer-events-none">
            <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center shadow-sm">
              <i data-lucide="camera" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-800 dark:text-white">Toca aquí para tomar foto o adjuntar captura</p>
              <p class="text-[10px] text-slate-400 mt-0.5">JPG, PNG o foto de celular (Se optimiza a WebP ligero)</p>
            </div>
          </div>

          <!-- Estado Subiendo -->
          <div id="upload-loading-state" class="hidden space-y-2 py-2">
            <span class="inline-block w-8 h-8 border-3 border-emerald-600 border-t-transparent rounded-full animate-spin"></span>
            <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Optimizando y guardando captura...</p>
          </div>

          <!-- Estado Listo con Previsualización -->
          <div id="upload-success-state" class="hidden space-y-3">
            <div class="flex items-center justify-center gap-3">
              <img id="payment-preview-img" src="" alt="Comprobante" class="w-16 h-16 object-cover rounded-xl border border-emerald-500 shadow-md">
              <div class="text-left">
                <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-black text-xs">
                  <i data-lucide="check-circle" class="w-4 h-4"></i>
                  <span>¡Comprobante Listo!</span>
                </div>
                <p id="payment-file-info" class="text-[10px] text-slate-400 mt-0.5"></p>
                <button type="button" id="btn-change-payment" class="text-[11px] hover:underline mt-1 font-bold text-theme">Cambiar foto</button>
              </div>
            </div>
          </div>
        </div>

        <div class="p-3 bg-amber-50 dark:bg-yellow-950/30 rounded-2xl border border-amber-200 dark:border-yellow-500/20 text-[11px] text-amber-800 dark:text-yellow-200/90 flex items-start gap-2">
          <i data-lucide="info" class="w-4 h-4 text-amber-600 dark:text-yellow-400 flex-shrink-0 mt-0.5"></i>
          <span><%= content.registrationForm?.step4PaymentHint || '¿No realizaste la transferencia aún? Puedes enviar la inscripción ahora y coordinar el pago por WhatsApp antes del cierre de cupos.' %></span>
        </div>
      </div>

      <!-- CONSENTIMIENTO INFORMADO & PROTECCIÓN -->
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-gray-900 border border-slate-200 dark:border-gray-800 flex items-start gap-3">
        <input type="checkbox" id="consentCheck" name="consentGiven" checked required class="mt-1 w-4 h-4 rounded border-slate-300 cursor-pointer" style="accent-color: var(--theme-primary)">
        <label for="consentCheck" class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed cursor-pointer">
          <%= content.registrationForm?.consentText || 'Confirmo que soy padre/madre o tutor legal del pupilo/a, autorizo su participación en la corrida y confirmo que cuenta con aptitud física para la actividad deportiva.' %>
        </label>
      </div>

      <!-- BOTÓN PRINCIPAL DE ENVÍO TÁCTIL -->
      <% if (activeRace && activeRace.status === 'paused') { %>
      <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-center space-y-1">
        <p class="text-sm font-bold text-amber-300 flex items-center justify-center gap-1.5">
          <i data-lucide="pause-circle" class="w-4 h-4"></i>
          Inscripciones Pausadas Temporalmente
        </p>
        <p class="text-xs text-amber-200/80">La organización ha detenido momentáneamente la recepción de inscripciones. Por favor regresa más tarde.</p>
      </div>
      <button type="button" disabled class="w-full py-4 px-6 rounded-2xl text-base font-bold text-slate-400 bg-slate-800 opacity-60 cursor-not-allowed flex items-center justify-center gap-2">
        <i data-lucide="lock" class="w-5 h-5"></i>
        <span>Inscripciones Pausadas</span>
      </button>
      <% } else if (!activeRace || activeRace.status === 'inactive' || activeRace.status === 'planned') { %>
      <div class="p-4 rounded-2xl bg-white/10 border border-white/20 text-center space-y-1">
        <p class="text-sm font-bold flex items-center justify-center gap-1.5" style="color: var(--theme-primary)">
          <i data-lucide="calendar" class="w-4 h-4"></i>
          Próxima Edición en Preparación
        </p>
        <p class="text-xs text-slate-400">No hay inscripciones abiertas en este momento. Anunciaremos pronto las nuevas fechas.</p>
      </div>
      <button type="button" disabled class="w-full py-4 px-6 rounded-2xl text-base font-bold text-slate-400 bg-slate-200 dark:bg-slate-800 opacity-60 cursor-not-allowed flex items-center justify-center gap-2">
        <i data-lucide="calendar-off" class="w-5 h-5"></i>
        <span>Inscripciones No Disponibles</span>
      </button>
      <% } else { %>
      <button type="submit" id="submit-btn" class="btn-theme w-full py-4 px-6 rounded-2xl text-base font-black text-white active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span><%= content.registrationForm?.submitButtonText || 'Confirmar Inscripción Oficial' %></span>
      </button>
      <% } %>

      <!-- MENSAJE DE ÉXITO FINAL MODAL/INLINE -->
      <div id="success-message" class="hidden p-6 rounded-3xl bg-emerald-500 text-white text-center space-y-3 shadow-xl">
        <div class="w-14 h-14 bg-white text-emerald-600 rounded-full mx-auto flex items-center justify-center font-black text-2xl shadow-lg">
          ✓
        </div>
        <h3 class="text-xl font-black" id="success-title"><%= content.registrationForm?.successTitle || '¡Inscripción Exitosa!' %></h3>
        <p class="text-xs text-emerald-100 leading-relaxed" id="success-details">
          <%= content.registrationForm?.successText || 'Hemos reservado el cupo y kit oficial. Te contactaremos al correo y WhatsApp indicados con las instrucciones de acreditación y número de dorsal.' %>
        </p>
        <div class="pt-2">
          <a href="/" class="inline-block bg-white text-emerald-800 font-black text-xs px-6 py-3 rounded-2xl shadow-md">
            Volver a la Portada
          </a>
        </div>
      </div>
    </form>
  </main>

  <!-- PIE DE PÁGINA MÓVIL DISCRETO -->
  <footer class="py-6 text-center text-xs text-slate-400 dark:text-gray-600 border-t border-slate-200 dark:border-gray-800/80">
    <p><%= content.brand?.name || 'KidsRun 2026' %> • Evento Deportivo Familiar Seguro</p>
  </footer>

  <!-- SCRIPT DE INTERACCIÓN MOBILE FIRST -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();

      // ─── Helpers de estilo por tema ──────────────────────────────────────────
      function applySelectedStyle(card) {
        card.classList.add('distance-card-selected', 'border-2');
        card.classList.remove('border-slate-200', 'dark:border-gray-800', 'bg-white', 'dark:bg-gray-950');
        const distTitle = card.querySelector('.dist-title');
        if (distTitle) distTitle.classList.add('distance-title-selected');
        const badge = card.querySelector('.dist-badge');
        if (badge) {
          badge.classList.remove('bg-slate-100', 'dark:bg-gray-800', 'text-slate-600', 'dark:text-gray-300');
          badge.classList.add('distance-badge-selected');
        }
      }
      function removeSelectedStyle(card) {
        card.classList.remove('distance-card-selected', 'border-2');
        card.classList.add('border-slate-200', 'dark:border-gray-800', 'bg-white', 'dark:bg-gray-950');
        const distTitle = card.querySelector('.dist-title');
        if (distTitle) distTitle.classList.remove('distance-title-selected');
        const badge = card.querySelector('.dist-badge');
        if (badge) {
          badge.classList.remove('distance-badge-selected');
          badge.classList.add('bg-slate-100', 'dark:bg-gray-800', 'text-slate-600', 'dark:text-gray-300');
        }
      }

      // ─── 1. Selector global de distancia (Paso 1) — sincroniza el primer select ──
      const distanceCards = document.querySelectorAll('.distance-option');

      distanceCards.forEach(card => {
        card.addEventListener('click', () => {
          distanceCards.forEach(c => removeSelectedStyle(c));
          applySelectedStyle(card);
          // Sincronizar el select del primer kid con la distancia elegida
          const firstSelect = document.querySelector('.kid-distance-select');
          if (firstSelect) firstSelect.value = card.getAttribute('data-distance');
        });
      });

      // ─── 2. Multi-child: Agregar / Eliminar hijos ───────────────────────────────
      const kidsWrapper = document.getElementById('kids-wrapper');
      const btnAddKid = document.getElementById('btn-add-kid');
      let kidCount = 1;

      // Template del bloque de un hijo adicional
      function createKidBlock(idx) {
        const optionsHtml = Array.from(document.querySelectorAll('.distance-option')).map((card, i) => {
          const val = card.getAttribute('data-distance');
          return `<option value="${val}"${i === 0 ? ' selected' : ''}>${val}</option>`;
        }).join('');

        const div = document.createElement('div');
        div.className = 'kid-block bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4';
        div.setAttribute('data-kid-index', idx);
        div.innerHTML = `
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full text-white font-black text-xs flex items-center justify-center step-circle">+</span>
              <h2 class="text-sm font-bold text-slate-900 dark:text-white">Hijo/a ${idx + 1}</h2>
            </div>
            <button type="button" class="btn-remove-kid flex items-center gap-1 text-[11px] text-red-500 hover:text-red-700 font-bold transition-colors">
              <i data-lucide="x-circle" class="w-4 h-4"></i> Quitar
            </button>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Circuito del participante *</label>
            <select class="kid-distance-select w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors">
              ${optionsHtml}
            </select>
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2">
              <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Nombre o Apodo *</label>
              <input type="text" class="kid-name-input w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors" required maxlength="60" placeholder="Ej: Valentina" autocomplete="off" autocapitalize="words">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Edad *</label>
              <input type="number" class="kid-age-input w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors" required min="2" max="15" inputmode="numeric" pattern="[0-9]*" placeholder="8">
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-gray-400 mb-1">Alergias o notas médicas (Opcional)</label>
            <input type="text" class="kid-medical-input w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2 text-xs text-slate-900 dark:text-white focus-theme focus:outline-none transition-colors" maxlength="500" placeholder="Ej: Sin restricciones">
          </div>
        `;
        // Asociar evento Quitar
        div.querySelector('.btn-remove-kid').addEventListener('click', () => {
          div.remove();
          updateKidNumbers();
          if (window.lucide) window.lucide.createIcons();
        });
        return div;
      }

      function updateKidNumbers() {
        document.querySelectorAll('.kid-block').forEach((block, i) => {
          // Actualizar data-kid-index
          block.setAttribute('data-kid-index', i);
          // Mostrar/ocultar botón Quitar en el primer hijo
          const removeBtn = block.querySelector('.btn-remove-kid');
          if (removeBtn) {
            if (i === 0) removeBtn.classList.add('hidden');
            else removeBtn.classList.remove('hidden');
          }
          // Actualizar título del bloque si es >1
          if (i > 0) {
            const h2 = block.querySelector('h2');
            if (h2) h2.textContent = `Hijo/a ${i + 1}`;
          }
        });
      }

      if (btnAddKid) {
        btnAddKid.addEventListener('click', () => {
          kidCount++;
          const newBlock = createKidBlock(kidCount - 1);
          kidsWrapper.appendChild(newBlock);
          updateKidNumbers();
          if (window.lucide) window.lucide.createIcons();
          // Scroll suave al nuevo bloque
          newBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      // ─── 3. Subida y Optimización Asíncrona del Comprobante ─────────────────────
      const fileInput = document.getElementById('paymentFileInput');
      const idleState = document.getElementById('upload-idle-state');
      const loadingState = document.getElementById('upload-loading-state');
      const successState = document.getElementById('upload-success-state');
      const previewImg = document.getElementById('payment-preview-img');
      const fileInfo = document.getElementById('payment-file-info');
      const proofHidden = document.getElementById('paymentProofUrl');
      const btnChange = document.getElementById('btn-change-payment');

      fileInput.addEventListener('change', async () => {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];

        idleState.classList.add('hidden');
        successState.classList.add('hidden');
        loadingState.classList.remove('hidden');

        try {
          const csrfToken = document.getElementById('csrfTokenField')?.value || '';
          const formData = new FormData();
          formData.append('proof', file);

          const res = await fetch('/api/upload-proof', {
            method: 'POST',
            headers: { 'X-CSRF-Token': csrfToken },
            body: formData
          });

          const json = await res.json();
          if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo procesar el comprobante');

          proofHidden.value = json.data.url;
          previewImg.src = json.data.url;
          const kb = (json.data.sizeBytes / 1024).toFixed(1);
          fileInfo.textContent = `Optimizado a WebP (${kb} KB) • Guardado seguro`;

          loadingState.classList.add('hidden');
          successState.classList.remove('hidden');
          if (window.lucide) window.lucide.createIcons();
        } catch (err) {
          alert('Error al subir comprobante: ' + err.message);
          loadingState.classList.add('hidden');
          idleState.classList.remove('hidden');
        }
      });

      btnChange.addEventListener('click', (e) => {
        e.stopPropagation();
        proofHidden.value = '';
        fileInput.value = '';
        successState.classList.add('hidden');
        idleState.classList.remove('hidden');
      });

      // ─── 4. Validación de RUT chileno en cliente ─────────────────────────────────
      function validateRutClient(rut) {
        if (!rut) return false;
        const clean = rut.replace(/\./g, '').replace(/-/g, '').trim().toUpperCase();
        if (!/^\d{7,8}[0-9K]$/.test(clean)) return false;
        const body = clean.slice(0, -1);
        let dv = clean.slice(-1);
        let sum = 0, mul = 2;
        for (let i = body.length - 1; i >= 0; i--) {
          sum += parseInt(body[i], 10) * mul;
          mul = mul === 7 ? 2 : mul + 1;
        }
        const expected = 11 - (sum % 11);
        const expectedDv = expected === 11 ? '0' : expected === 10 ? 'K' : String(expected);
        return dv === expectedDv;
      }

      const rutInput = document.getElementById('tutorRut');
      const rutError = document.getElementById('rutError');
      if (rutInput && rutError) {
        rutInput.addEventListener('blur', () => {
          if (rutInput.value && !validateRutClient(rutInput.value)) {
            rutError.classList.remove('hidden');
            rutInput.classList.add('border-red-500');
          } else {
            rutError.classList.add('hidden');
            rutInput.classList.remove('border-red-500');
          }
        });
      }

      // ─── 5. Envío del Formulario ─────────────────────────────────────────────────
      const form = document.getElementById('registration-form');
      const submitBtn = document.getElementById('submit-btn');
      const successBox = document.getElementById('success-message');

      if (!form || !submitBtn) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot
        const honeypot = document.getElementById('website_url');
        if (honeypot && honeypot.value) { submitBtn.disabled = true; return; }

        // Recolectar todos los hijos
        const kidBlocks = document.querySelectorAll('.kid-block');
        const children = [];
        let valid = true;

        kidBlocks.forEach((block, idx) => {
          const kidNameInput = block.querySelector('.kid-name-input');
          const kidAgeInput  = block.querySelector('.kid-age-input');
          const kidDistSel   = block.querySelector('.kid-distance-select');
          const kidMedical   = block.querySelector('.kid-medical-input');

          const kidName = kidNameInput ? kidNameInput.value.trim() : '';
          const kidAge  = kidAgeInput  ? parseInt(kidAgeInput.value, 10) : 0;
          const distance = kidDistSel  ? kidDistSel.value : '';

          if (!kidName) { alert(`Por favor ingresa el nombre del participante ${idx + 1}.`); valid = false; return; }
          if (isNaN(kidAge) || kidAge < 2 || kidAge > 15) { alert(`La edad del participante ${idx + 1} debe estar entre 2 y 15 años.`); valid = false; return; }

          children.push({
            kidName,
            kidAge: kidAgeInput ? kidAgeInput.value : '',
            distance,
            medicalNotes: kidMedical ? kidMedical.value.trim() : ''
          });
        });

        if (!valid) return;

        // Validar RUT
        const tutorRutVal = document.getElementById('tutorRut')?.value || '';
        if (tutorRutVal && !validateRutClient(tutorRutVal)) {
          alert('El RUT/DNI ingresado no es válido. Verifica el formato (ej: 12.345.678-9).');
          if (rutError) rutError.classList.remove('hidden');
          if (rutInput) rutInput.focus();
          return;
        }

        const formData = new FormData(form);
        const baseData = Object.fromEntries(formData.entries());
        const csrfToken = baseData.csrfToken || '';

        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="inline-block animate-spin mr-2">⟳</span> Guardando Inscripción${children.length > 1 ? 'es' : ''}...`;

        try {
          const payload = {
            raceId:           baseData.raceId,
            raceName:         baseData.raceName,
            name:             baseData.name,
            email:            baseData.email,
            phone:            baseData.phone,
            tutorRut:         baseData.tutorRut,
            paymentProof:     baseData.paymentProof || '',
            consentGiven:     baseData.consentGiven || 'on',
            website_url:      '',
            children
          };

          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify(payload)
          });

          const json = await res.json();
          if (res.ok && json.success) {
            form.querySelectorAll('.kid-block, .space-y-4, .grid, button[type="submit"]').forEach(el => el.classList.add('hidden'));
            if (btnAddKid) btnAddKid.classList.add('hidden');
            // Actualizar texto de éxito si hay múltiples hijos
            if (json.count && json.count > 1) {
              const titleEl = document.getElementById('success-title');
              if (titleEl) titleEl.textContent = `¡${json.count} Inscripciones Exitosas!`;
            }
            successBox.classList.remove('hidden');
            window.scrollTo({ top: successBox.offsetTop - 80, behavior: 'smooth' });
          } else {
            alert(json.error || 'No se pudo completar la inscripción. Por favor revisa los datos.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        } catch (err) {
          alert('Error de conexión. Inténtalo nuevamente.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      });
    });
  </script>
</body>
</html>
