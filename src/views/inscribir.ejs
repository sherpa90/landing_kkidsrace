      // ─── Manejador de selección táctil de edad rápida (0 a 14) con botón 'Ver todas' ───
      function setupAgeSelection(kidCard) {
        const pills = kidCard.querySelectorAll('.age-pill');
        const ageInput = kidCard.querySelector('.kid-age-input');
        const ageHint = kidCard.querySelector('.age-selected-hint');
        const pillsContainer = kidCard.querySelector('.age-pills-container');
        const toggleAllBtn = kidCard.querySelector('.btn-toggle-all-ages');
        const scrollMoreBtn = kidCard.querySelector('.btn-scroll-more-ages');

        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            pills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            const ageVal = pill.getAttribute('data-age');
            if (ageInput) ageInput.value = ageVal;
            if (ageHint) {
              ageHint.innerHTML = `Edad: <strong class="theme-color font-black">${ageVal === '0' ? '0 años (Bebé)' : ageVal + ' años'}</strong>`;
            }

            // Auto-seleccionar circuito sugerido según edad
            const ageNum = parseInt(ageVal, 10);
            let suggestedIdx = 0;
            if (ageNum >= 0 && ageNum <= 5) suggestedIdx = 0;
            else if (ageNum >= 6 && ageNum <= 8) suggestedIdx = Math.min(1, categoriesData.length - 1);
            else if (ageNum >= 9 && ageNum <= 11) suggestedIdx = Math.min(2, categoriesData.length - 1);
            else if (ageNum >= 12) suggestedIdx = Math.min(3, categoriesData.length - 1);

            const distOptions = kidCard.querySelectorAll('.kid-dist-option');
            if (distOptions[suggestedIdx]) {
              distOptions[suggestedIdx].click();
            }

            updateFormProgress();
          });
        });

        // Botón 'Ver todas las edades'
        if (toggleAllBtn && pillsContainer) {
          toggleAllBtn.addEventListener('click', () => {
            const isWrapped = pillsContainer.classList.contains('flex-wrap');
            if (isWrapped) {
              pillsContainer.classList.remove('flex-wrap');
              pillsContainer.classList.add('overflow-x-auto', 'no-scrollbar');
              toggleAllBtn.innerHTML = `<span>Ver todas (0 a 14)</span><i data-lucide="chevrons-down" class="w-3 h-3"></i>`;
              if (scrollMoreBtn) scrollMoreBtn.classList.remove('hidden');
            } else {
              pillsContainer.classList.add('flex-wrap');
              pillsContainer.classList.remove('overflow-x-auto', 'no-scrollbar');
              toggleAllBtn.innerHTML = `<span>Cerrar cuadrícula</span><i data-lucide="chevrons-up" class="w-3 h-3"></i>`;
              if (scrollMoreBtn) scrollMoreBtn.classList.add('hidden');
            }
            if (window.lucide) window.lucide.createIcons();
          });
        }

        // Botón 'Más 👉'
        if (scrollMoreBtn && pillsContainer) {
          scrollMoreBtn.addEventListener('click', () => {
            pillsContainer.scrollBy({ left: 180, behavior: 'smooth' });
          });
        }
      }

