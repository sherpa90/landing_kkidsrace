      }

      // ─── Función para Descargar el Comprobante como Imagen PNG ───────────────
      function generateTicketDataUrl() {
        if (!latestRegistrationResult) {
          window.print();
          return;
        }

        const { children, tutorName, tutorRut, raceName } = latestRegistrationResult;
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        const width = 900;
        const cardHeight = 150;
        const height = 360 + (children.length * cardHeight);

        canvas.width = width;
        canvas.height = height;

        // Fondo oscuro elegante
        const bgGrad = ctx.createLinearGradient(0, 0, width, height);
        bgGrad.addColorStop(0, '#0f172a');
        bgGrad.addColorStop(1, '#020617');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, width, height);

        // Borde decorativo
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 4;
        ctx.strokeRect(15, 15, width - 30, height - 30);

        // Barra superior dorada
        const headerGrad = ctx.createLinearGradient(15, 15, width - 15, 90);
        headerGrad.addColorStop(0, '#2563eb');
        headerGrad.addColorStop(1, '#1d4ed8');
        ctx.fillStyle = headerGrad;
        ctx.fillRect(17, 17, width - 34, 90);

        // Título del evento
        ctx.fillStyle = '#ffffff';
        ctx.font = '900 24px -apple-system, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(raceName.toUpperCase(), width / 2, 54);

        ctx.fillStyle = '#fde047';
        ctx.font = 'bold 13px -apple-system, sans-serif';
        ctx.fillText('COMPROBANTE OFICIAL DE INSCRIPCIÓN Y RETIRO DE KIT', width / 2, 80);

        // Datos del tutor
        ctx.fillStyle = '#94a3b8';
        ctx.font = 'bold 13px -apple-system, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(`APODERADO / TUTOR: ${tutorName.toUpperCase()}`, 40, 140);
        ctx.fillText(`RUN / RUT: ${tutorRut}`, 40, 162);
        ctx.textAlign = 'right';
        ctx.fillText(`FECHA: ${new Date().toLocaleDateString('es-CL')}`, width - 40, 140);
        ctx.fillText(`ESTADO: RESERVADO Y CONFIRMADO ✓`, width - 40, 162);

        // Línea divisoria
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(40, 180);
        ctx.lineTo(width - 40, 180);
        ctx.stroke();

        // Tarjetas de cada niño
        let currentY = 205;
        children.forEach((c, idx) => {
          // Fondo tarjeta
          ctx.fillStyle = '#1e293b';
          ctx.beginPath();
          ctx.roundRect(40, currentY, width - 80, cardHeight - 20, 16);
          ctx.fill();
          ctx.strokeStyle = '#475569';
          ctx.lineWidth = 1.5;
          ctx.stroke();

          // Número de inscripción en dorado
          ctx.fillStyle = '#facc15';
          ctx.font = '900 13px monospace';
          ctx.textAlign = 'left';
          ctx.fillText(`N° DE INSCRIPCIÓN OFICIAL`, 65, currentY + 32);

          ctx.fillStyle = '#fef08a';
          ctx.font = '900 28px monospace';
          const bibText = `#${c.inscriptionNumber || c.bibNumber || '0100'}`;
          ctx.fillText(bibText, 65, currentY + 68);

          // Nombre del niño
          ctx.fillStyle = '#ffffff';
          ctx.font = '900 20px -apple-system, sans-serif';
          ctx.fillText(c.kidName.toUpperCase(), 280, currentY + 45);

          // Detalles: circuito, talla, edad
          ctx.fillStyle = '#38bdf8';
          ctx.font = 'bold 14px -apple-system, sans-serif';
          ctx.fillText(`Circuito: ${c.distance}`, 280, currentY + 75);

          ctx.fillStyle = '#c084fc';
          ctx.fillText(`Polera: Talla ${c.shirtSize || '4'}`, 520, currentY + 75);

          ctx.fillStyle = '#94a3b8';
          ctx.fillText(`Edad: ${c.kidAge} años`, 680, currentY + 75);

          // Badge 'Kit Asegurado'
          ctx.fillStyle = '#10b981';
          ctx.textAlign = 'right';
          ctx.font = 'bold 12px -apple-system, sans-serif';
          ctx.fillText('🏅 KIT ASEGURADO', width - 65, currentY + 40);

          currentY += cardHeight;
        });

        // Pie de página de seguridad
        ctx.fillStyle = '#f59e0b';
        ctx.textAlign = 'center';
        ctx.font = 'bold 12px -apple-system, sans-serif';
        ctx.fillText('📸 CONSERVA ESTE COMPROBANTE: PRESÉNTALO AL RETIRAR EL KIT OFICIAL DE COMPETENCIA', width / 2, height - 45);

        ctx.fillStyle = '#64748b';
        ctx.font = '11px -apple-system, sans-serif';
        ctx.fillText('Kids Race • Evento Deportivo Familiar Seguro • https://kkidsrace.cl', width / 2, height - 26);

        return canvas.toDataURL('image/png');
      }

      const btnDownloadTicket = document.getElementById('btn-download-ticket');
      if (btnDownloadTicket) {
        btnDownloadTicket.addEventListener('click', () => {
          const img = document.getElementById('ticket-preview-img');
          if (img && img.src) {
            const link = document.createElement('a');
            const firstBib = latestRegistrationResult?.children?.[0]?.inscriptionNumber || 'inscripcion';
            link.download = `comprobante-kidsrace-${firstBib}.png`;
            link.href = img.src;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
          } else {
            window.print();
          }
        });
      }

      // ─── Envío del Formulario con Validación de Campos Obligatorios ─────────
      const form = document.getElementById('registration-form');
      const submitBtn = document.getElementById('submit-btn');
      const successBox = document.getElementById('success-message');

      if (form && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          // Honeypot anti-bots
          const honeypot = document.getElementById('website_url');
          if (honeypot && honeypot.value) { submitBtn.disabled = true; return; }

          // 1. Validar todos los niños (campos obligatorios)
          const kidCards = document.querySelectorAll('.kid-card');
          const children = [];
          let valid = true;

          kidCards.forEach((card, idx) => {
            const fnInput = card.querySelector('.kid-firstname-input');
            const lnInput = card.querySelector('.kid-lastname-input');
            const ageInput = card.querySelector('.kid-age-input');
            const distInput = card.querySelector('.kid-distance-input');
            const shirtInput = card.querySelector('.kid-shirt-input');
            const medInput = card.querySelector('.kid-medical-input');

            const kidFirstName = (fnInput?.value || '').trim();
            const kidLastName  = (lnInput?.value || '').trim();
            const kidAge = parseInt(ageInput?.value || '5', 10);
            const shirtSize = shirtInput?.value || '4';
            const distance = distInput?.value || '';
            const medicalNotes = (medInput?.value || 'Ninguna').trim();

            if (!kidFirstName) {
              alert(`Por favor ingresa el NOMBRE del participante #${idx + 1}.`);
              fnInput?.focus();
              valid = false;
              return;
            }

            if (!kidLastName) {
              alert(`Por favor ingresa el APELLIDO del participante #${idx + 1}.`);
              lnInput?.focus();
              valid = false;
              return;
            }

            if (isNaN(kidAge) || kidAge < 0 || kidAge > 14) {
              alert(`La edad del participante #${idx + 1} debe estar entre 0 y 14 años.`);
              valid = false;
              return;
            }

            children.push({
              kidFirstName,
              kidLastName,
              kidName: `${kidFirstName} ${kidLastName}`.trim(),
              kidAge: String(kidAge),
              shirtSize,
              distance,
              medicalNotes
            });
          });

          if (!valid) return;

          // 2. Validar Tutor (campos obligatorios)
          const tutorFirstName = (document.getElementById('tutorFirstName')?.value || '').trim();
          const tutorLastName  = (document.getElementById('tutorLastName')?.value || '').trim();
          if (!tutorFirstName) {
            alert('Por favor ingresa el Nombre del padre/tutor.');
            document.getElementById('tutorFirstName')?.focus();
            return;
          }
          if (!tutorLastName) {
            alert('Por favor ingresa el Apellido del padre/tutor.');
            document.getElementById('tutorLastName')?.focus();
            return;
          }

          const tutorRutVal = (document.getElementById('tutorRut')?.value || '').trim();
          if (!tutorRutVal) {
            alert('El RUN / RUT del apoderado o tutor es obligatorio.');
            document.getElementById('tutorRut')?.focus();
            return;
          }
          if (!validateRut(tutorRutVal)) {
            alert('El RUN / RUT ingresado no es válido. Verifica el dígito verificador.');
            document.getElementById('tutorRut')?.focus();
            return;
          }

          const tutorEmailVal = (document.getElementById('email')?.value || '').trim();
          if (!tutorEmailVal || !tutorEmailVal.includes('@')) {
            alert('Por favor ingresa un correo electrónico válido de contacto.');
            document.getElementById('email')?.focus();
            return;
          }

          const phoneVal = (document.getElementById('phone')?.value || '').trim();
          if (!phoneVal) {
            alert('Por favor ingresa un teléfono / WhatsApp de contacto.');
            document.getElementById('phone')?.focus();
            return;
          }

          // 3. Validar Comprobante de Pago obligatorio
          const proofVal = proofHidden?.value || '';
          if (!proofVal) {
            alert('Por favor adjunta la foto o captura del comprobante de transferencia antes de continuar.');
            document.getElementById('paymentFileInput')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }

          // 4. Validar Consentimiento
          const consentCheck = document.getElementById('consentCheck');
          if (!consentCheck || !consentCheck.checked) {
            alert('Debes confirmar la autorización y consentimiento informado para participar.');
            consentCheck?.focus();
            return;
          }

          const originalContent = submitBtn.innerHTML;
          submitBtn.disabled = true;
          submitBtn.innerHTML = `
            <span class="inline-block animate-spin mr-2">⟳</span>
            <span>Generando Número de Inscripción y Asegurando Cupos...</span>
          `;

          const csrfToken = document.getElementById('csrfTokenField')?.value || '';
          const payload = {
            raceId: form.querySelector('input[name="raceId"]')?.value || '',
            raceName: form.querySelector('input[name="raceName"]')?.value || '',
            tutorFirstName,
            tutorLastName,
            name: `${tutorFirstName} ${tutorLastName}`.trim(),
            email: tutorEmailVal,
            phone: phoneVal,
            tutorRut: tutorRutVal,
            paymentProof: proofVal,
            consentGiven: true,
            website_url: '',
            children
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-CSRF-Token': csrfToken
              },
              body: JSON.stringify(payload)
            });

            const json = await res.json();
            if (res.ok && json.success) {
              // Ocultar bloques del formulario y mostrar éxito
              document.querySelectorAll('.kid-card, #btn-add-kid, .space-y-4, .space-y-3, #dynamic-summary-bar, #submit-btn').forEach(el => el.classList.add('hidden'));

              const responseChildren = json.children || children;
              latestRegistrationResult = {
                children: responseChildren,
                tutorName: payload.name,
                tutorRut: tutorRutVal,
                raceName: payload.raceName || 'Kids Race 2026'
              };

              // Poblar lista de hijos con su Número de Inscripción correlativo en el cuadro de éxito
              const listContainer = document.getElementById('registered-children-list');
              const tutorRutBadge = document.getElementById('registered-tutor-rut');
              if (tutorRutBadge) {
                tutorRutBadge.textContent = `Tutor RUT: ${tutorRutVal}`;
              }

              if (listContainer) {
                listContainer.innerHTML = responseChildren.map((c, i) => {
                  const bib = c.inscriptionNumber || c.bibNumber || `#010${i+1}`;
                  const kidFullName = c.kidName || `${c.kidFirstName || ''} ${c.kidLastName || ''}`.trim();
                  return `
                    <div class="bg-black/30 backdrop-blur-md rounded-2xl p-4 border border-white/20 space-y-2">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <span class="text-[10px] font-black uppercase text-amber-300">N° INSCRIPCIÓN:</span>
                          <span class="font-mono font-black text-xl text-yellow-300 bg-amber-950/80 px-2.5 py-0.5 rounded-xl border border-amber-400/50">#${bib}</span>
                        </div>
                        <span class="bg-emerald-500/30 text-emerald-200 border border-emerald-400/40 px-2 py-0.5 rounded-full text-[10px] font-black uppercase">Kit Asegurado</span>
                      </div>
                      <div class="text-sm font-black text-white">${kidFullName}</div>
                      <div class="flex flex-wrap items-center gap-2 text-[11px] text-white/80">
                        <span class="bg-white/20 px-2 py-0.5 rounded-lg font-bold">${c.distance}</span>
                        <span class="bg-purple-500/40 text-purple-100 border border-purple-400/40 px-2 py-0.5 rounded-lg font-bold">Polera: Talla ${c.shirtSize || '4'}</span>
                        <span class="bg-white/10 px-2 py-0.5 rounded-lg font-medium">${c.kidAge} años</span>
                      </div>
                    </div>
                  `;
                }).join('');
              }

              if (json.count && json.count > 1) {
                const sTitle = document.getElementById('success-title');
                if (sTitle) sTitle.textContent = `¡${json.count} Inscripciones Confirmadas!`;
              }
              
              // Renderizar y mostrar el comprobante en pantalla
              setTimeout(() => {
                const dataUrl = generateTicketDataUrl();
                if (dataUrl) {
                  const previewImg = document.getElementById('ticket-preview-img');
                  const previewContainer = document.getElementById('ticket-preview-container');
                  if (previewImg && previewContainer) {
                    previewImg.src = dataUrl;
                    previewContainer.classList.remove('hidden');
                  }
                }
              }, 100);

              successBox.classList.remove('hidden');
              if (window.lucide) window.lucide.createIcons();
              launchCelebration();
              window.scrollTo({ top: successBox.offsetTop - 60, behavior: 'smooth' });

              // Configurar botón compartir WhatsApp
              const btnShare = document.getElementById('btn-share-whatsapp');
              if (btnShare) {
                btnShare.addEventListener('click', () => {
                  const names = children.map(c => c.kidName).join(' y ');
                  const text = encodeURIComponent(`¡Listo! Inscribí a ${names} en ${payload.raceName || 'Kids Race 2026'}. N° Inscripción confirmado. ¡Nos vemos en la meta! 🏅🏃‍♂️ ${window.location.origin}`);
                  window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
                });
              }
            } else {
              alert(json.error || 'No se pudo completar la inscripción. Por favor revisa los datos.');
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalContent;
            }
          } catch (err) {
            alert('Error de conexión al enviar el formulario. Inténtalo nuevamente.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;
          }
        });
      }

      // ─── Inscribir más hijos del mismo apoderado ─────────────────────────────
      const btnMoreKids = document.getElementById('btn-register-more-kids');
      if (btnMoreKids) {
        btnMoreKids.addEventListener('click', () => {
          // Ocultar caja de éxito
          const successBox = document.getElementById('success-message');
          if (successBox) successBox.classList.add('hidden');

          // Ocultar visor del comprobante generado
          const previewContainer = document.getElementById('ticket-preview-container');
          if (previewContainer) previewContainer.classList.add('hidden');

          // Restablecer el submit button
          const submitBtn = document.getElementById('submit-btn');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.classList.remove('hidden');
          }

          // Mostrar el botón de agregar hijo y el botón de enviar
          const btnAddKid = document.getElementById('btn-add-kid');
          if (btnAddKid) btnAddKid.classList.remove('hidden');

          // Mostrar la sección de datos del apoderado y comprobante de pago (pero no los kid-cards)
          document.querySelectorAll('.space-y-4, .space-y-3, #dynamic-summary-bar, #submit-btn').forEach(el => el.classList.remove('hidden'));

          // Limpiar los kid-cards actuales excepto el primero, y resetear el primero
          const allCards = document.querySelectorAll('.kid-card');
          allCards.forEach((card, idx) => {
            if (idx === 0) {
              // Resetear campos del primer hijo
              card.querySelectorAll('input, select, textarea').forEach(inp => { inp.value = ''; });
              // Resetear selector de talla visual si existe
              card.querySelectorAll('[data-shirt]').forEach(btn => btn.classList.remove('ring-2', 'ring-offset-2', 'ring-blue-500', 'dark:ring-yellow-400'));
            } else {
              card.remove();
            }
          });

          // Resetear validación de comprobante de pago (dejar el ya subido si existe)
          // No limpiar el payment proof para que no tenga que subir otro comprobante

          // Restablecer botón con el texto correcto
          if (submitBtn) {
            submitBtn.innerHTML = `<i data-lucide="check-circle" class="w-4 h-4 shrink-0"></i><span>Confirmar Inscripción</span>`;
          }

          if (window.lucide) window.lucide.createIcons();

          // Scroll hasta la sección de niños
          const firstCard = document.querySelector('.kid-card');
          if (firstCard) window.scrollTo({ top: firstCard.offsetTop - 80, behavior: 'smooth' });
        });
      }
    });
  </script>
</body>
</html>
