<!DOCTYPE html>
<html lang="es" class="<%= themeMode === 'dark' ? 'dark' : '' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Inscripción Oficial | <%= activeRace ? activeRace.name : (content.brand?.name || 'KidsRun') %></title>
  <meta name="description" content="Inscribe a tu pequeño/a en la corrida infantil más alegre y segura. Selecciona su distancia y asegura su kit con medalla oficial.">

  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              500: '#22c55e',
              600: '#16a34a'
            }
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lucide@1.47.0"></script>
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    /* Estilos Mobile First para selecciones táctiles */
    .touch-card {
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      -webkit-tap-highlight-color: transparent;
    }
    .touch-card:active {
      transform: scale(0.98);
    }
    .step-badge.active {
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.2);
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-gray-950 text-slate-800 dark:text-gray-100 min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">

  <!-- BARRA DE NAVEGACIÓN SUPERIOR FIJA Y MINIMALISTA -->
  <header class="sticky top-0 z-40 bg-white/90 dark:bg-gray-950/90 backdrop-blur-md border-b border-slate-200 dark:border-gray-800">
    <div class="max-w-xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-slate-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-yellow-400 text-xs font-bold transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Volver a la Portada</span>
      </a>

      <div class="flex items-center gap-2">
        <% if (content.brand?.logoUrl) { %>
        <img src="<%= content.brand.logoUrl %>" alt="<%= content.brand?.name || 'KidsRun' %>" class="h-8 w-auto object-contain max-w-[140px]">
        <% } else { %>
        <div class="w-7 h-7 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black text-xs shadow-sm">
          <i data-lucide="medal" class="w-4 h-4"></i>
        </div>
        <span class="text-xs font-black text-slate-900 dark:text-white tracking-tight uppercase"><%= content.brand?.name || 'KidsRun 2026' %></span>
        <% } %>
      </div>
    </div>
  </header>

  <!-- CONTENEDOR PRINCIPAL MOBILE-FIRST (Centrado en Pantallas Grandes, Cómodo en Móviles) -->
  <main class="flex-1 w-full max-w-xl mx-auto px-4 py-6 sm:py-8">

    <!-- CABECERA DEL EVENTO Y CORRIDA ACTIVA -->
    <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-6 text-white shadow-xl shadow-blue-600/20 mb-6 relative overflow-hidden">
      <!-- Círculos decorativos de fondo -->
      <div class="absolute -right-10 -bottom-10 w-36 h-36 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
      <div class="absolute -left-6 -top-6 w-24 h-24 bg-yellow-400/20 rounded-full blur-lg pointer-events-none"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-black uppercase tracking-wider mb-2.5 text-yellow-300 border border-white/20">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Inscripciones Oficiales Abiertas</span>
        </div>

        <h1 class="text-xl sm:text-2xl font-black tracking-tight mb-1 text-white">
          <%= activeRace ? activeRace.name : 'KidsRun 2026 - Edición Oficial' %>
        </h1>

        <div class="flex flex-wrap items-center gap-y-1.5 gap-x-4 text-xs text-blue-100 font-medium mt-2">
          <div class="flex items-center gap-1.5">
            <i data-lucide="calendar" class="w-3.5 h-3.5 text-yellow-300"></i>
            <span><%= activeRace ? (activeRace.dateDisplay || activeRace.date) : 'Domingo 15 de Noviembre, 2026' %></span>
          </div>
          <div class="flex items-center gap-1.5">
            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-yellow-300"></i>
            <span class="truncate"><%= activeRace ? activeRace.location.split('•')[0] : 'Parque Bicentenario' %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- BENEFICIOS CLAVE EN MÓVIL (Puntos de Confianza) -->
    <div class="grid grid-cols-3 gap-2 mb-6 text-center">
      <div class="p-2.5 bg-white dark:bg-gray-900 rounded-2xl border border-slate-200 dark:border-gray-800 shadow-sm">
        <i data-lucide="award" class="w-5 h-5 mx-auto text-amber-500 mb-1"></i>
        <p class="text-[11px] font-bold text-slate-800 dark:text-white leading-tight">Medalla Finisher</p>
        <p class="text-[9px] text-slate-400">100% garantizada</p>
      </div>
      <div class="p-2.5 bg-white dark:bg-gray-900 rounded-2xl border border-slate-200 dark:border-gray-800 shadow-sm">
        <i data-lucide="shield-check" class="w-5 h-5 mx-auto text-emerald-500 mb-1"></i>
        <p class="text-[11px] font-bold text-slate-800 dark:text-white leading-tight">Circuito Seguro</p>
        <p class="text-[9px] text-slate-400">100% cerrado</p>
      </div>
      <div class="p-2.5 bg-white dark:bg-gray-900 rounded-2xl border border-slate-200 dark:border-gray-800 shadow-sm">
        <i data-lucide="shirt" class="w-5 h-5 mx-auto text-blue-500 mb-1"></i>
        <p class="text-[11px] font-bold text-slate-800 dark:text-white leading-tight">Polera Oficial</p>
        <p class="text-[9px] text-slate-400">Incluida en Kit</p>
      </div>
    </div>

    <!-- FORMULARIO PRINCIPAL -->
    <form id="registration-form" class="space-y-6">
      <input type="hidden" name="raceId" value="<%= activeRace ? activeRace.id : 'race-2026-primavera' %>">
      <input type="hidden" name="raceName" value="<%= activeRace ? activeRace.name : 'KidsRun 2026' %>">
      <input type="hidden" id="selectedDistance" name="distance" value="500 Metros (3-5 años)">
      <input type="hidden" id="paymentProofUrl" name="paymentProof" value="">
      <!-- CSRF Token para protección contra ataques de sitios cruzados -->
      <input type="hidden" id="csrfTokenField" name="csrfToken" value="<%= csrfToken %>">
      <!-- Honeypot: campo invisible para detectar bots. Los usuarios humanos NO deben completarlo. -->
      <div style="display:none; visibility:hidden; position:absolute; left:-9999px;" aria-hidden="true">
        <label for="website_url">Sitio web (no completar)</label>
        <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off">
      </div>

      <!-- PASO 1: SELECCIÓN DEL CIRCUITO / DISTANCIA (TOUCH UI) -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-blue-600 text-white font-black text-xs flex items-center justify-center">1</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white">Selecciona el Circuito</h2>
          </div>
          <span class="text-[11px] font-medium text-blue-600 dark:text-yellow-400">Por edad sugerida</span>
        </div>

        <div class="grid grid-cols-2 gap-2.5" id="distance-selector">
          <!-- 500m -->
          <div class="touch-card distance-option cursor-pointer p-3.5 rounded-2xl border-2 border-blue-600 bg-blue-50/50 dark:bg-blue-950/40 relative" data-distance="500 Metros (3-5 años)">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-black text-blue-700 dark:text-yellow-300">500m</span>
              <span class="text-[10px] bg-blue-600 text-white font-bold px-1.5 py-0.5 rounded-full">3-5 años</span>
            </div>
            <p class="text-[11px] font-semibold text-slate-800 dark:text-gray-200">Mini Runners</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Acompañado de papás</p>
          </div>

          <!-- 1K -->
          <div class="touch-card distance-option cursor-pointer p-3.5 rounded-2xl border border-slate-200 dark:border-gray-800 bg-white dark:bg-gray-950 relative" data-distance="1 Kilómetro (6-8 años)">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-black text-slate-800 dark:text-white">1K</span>
              <span class="text-[10px] bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-gray-300 font-bold px-1.5 py-0.5 rounded-full">6-8 años</span>
            </div>
            <p class="text-[11px] font-semibold text-slate-800 dark:text-gray-200">Pequeños Rayos</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Circuito plano seguro</p>
          </div>

          <!-- 2K -->
          <div class="touch-card distance-option cursor-pointer p-3.5 rounded-2xl border border-slate-200 dark:border-gray-800 bg-white dark:bg-gray-950 relative" data-distance="2 Kilómetros (9-11 años)">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-black text-slate-800 dark:text-white">2K</span>
              <span class="text-[10px] bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-gray-300 font-bold px-1.5 py-0.5 rounded-full">9-11 años</span>
            </div>
            <p class="text-[11px] font-semibold text-slate-800 dark:text-gray-200">Súper Campeones</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Con cronometraje</p>
          </div>

          <!-- 3K -->
          <div class="touch-card distance-option cursor-pointer p-3.5 rounded-2xl border border-slate-200 dark:border-gray-800 bg-white dark:bg-gray-950 relative" data-distance="3 Kilómetros (12-14 años)">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-black text-slate-800 dark:text-white">3K</span>
              <span class="text-[10px] bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-gray-300 font-bold px-1.5 py-0.5 rounded-full">12-14 años</span>
            </div>
            <p class="text-[11px] font-semibold text-slate-800 dark:text-gray-200">Jóvenes Titanes</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Gran desafío atlético</p>
          </div>
        </div>
      </div>

      <!-- PASO 2: DATOS DEL PEQUEÑO CORREDOR/A (DORSAL) -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-blue-600 text-white font-black text-xs flex items-center justify-center">2</span>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Datos del Pequeño/a</h2>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="col-span-2">
            <label for="kidName" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Nombre o Apodo *</label>
            <input type="text" id="kidName" name="kidName" required maxlength="60" placeholder="Ej: Mateo o Sofi" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
            <span class="text-[10px] text-slate-400 block mt-1">Se imprimirá en su número oficial de carrera.</span>
          </div>

          <div>
            <label for="kidAge" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Edad *</label>
            <input type="number" id="kidAge" name="kidAge" required min="2" max="15" placeholder="6" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm font-bold text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
          </div>
        </div>

        <div>
          <label for="medicalNotes" class="block text-xs font-semibold text-slate-600 dark:text-gray-400 mb-1">Alergias o notas médicas (Opcional)</label>
          <input type="text" id="medicalNotes" name="medicalNotes" maxlength="500" placeholder="Ej: Asma leve, alergia al maní..." class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
        </div>
      </div>

      <!-- PASO 3: DATOS DEL PADRE / TUTOR LEGAL -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-blue-600 text-white font-black text-xs flex items-center justify-center">3</span>
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Datos del Padre / Tutor</h2>
        </div>

        <div class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="name" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Nombre Completo *</label>
              <input type="text" id="name" name="name" required maxlength="100" placeholder="Tu Nombre y Apellido" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
            </div>

            <div>
              <label for="tutorRut" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">RUT o DNI del Padre/Tutor *</label>
              <input type="text" id="tutorRut" name="tutorRut" required maxlength="15" autocomplete="off" placeholder="Ej: 12.345.678-9" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
              <span id="rutError" class="text-[10px] text-red-500 hidden mt-1 block">RUT inválido. Verifica el formato (ej: 12.345.678-9).</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="email" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">Correo Electrónico *</label>
              <input type="email" id="email" name="email" required maxlength="254" placeholder="tu@correo.com" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
            </div>

            <div>
              <label for="phone" class="block text-xs font-bold text-slate-700 dark:text-gray-300 mb-1">WhatsApp / Teléfono *</label>
              <input type="tel" id="phone" name="phone" required maxlength="30" placeholder="+56 9 1234 5678" class="w-full bg-slate-50 dark:bg-gray-950 border border-slate-300 dark:border-gray-800 rounded-2xl px-3.5 py-2.5 text-sm text-slate-900 dark:text-white focus:outline-none focus:border-blue-600 transition-colors">
            </div>
          </div>
        </div>
      </div>

      <!-- PASO 4: COMPROBANTE DE PAGO (ALMACENAMIENTO PERMANENTE OPTIMIZADO) -->
      <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-slate-200 dark:border-gray-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-black text-xs flex items-center justify-center">4</span>
            <h2 class="text-sm font-bold text-slate-900 dark:text-white">Comprobante de Pago</h2>
          </div>
          <span class="text-[10px] bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-bold px-2 py-0.5 rounded-full border border-emerald-300 dark:border-emerald-800">
            Acreditación Rápida
          </span>
        </div>

        <p class="text-xs text-slate-500 dark:text-gray-400">
          Adjunta la foto o captura de transferencia del kit de inscripción. Nuestro servidor la optimizará y guardará de forma permanente.
        </p>

        <!-- ZONA DE CARGA TÁCTIL (UPLOAD ZONE MOBILE FIRST) -->
        <div id="upload-dropzone" class="border-2 border-dashed border-slate-300 dark:border-gray-700 hover:border-emerald-500 dark:hover:border-emerald-500 rounded-2xl p-4 text-center transition-all bg-slate-50/50 dark:bg-gray-950/50 cursor-pointer relative">
          <input type="file" id="paymentFileInput" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
          
          <div id="upload-idle-state" class="space-y-2 pointer-events-none">
            <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 mx-auto flex items-center justify-center shadow-sm">
              <i data-lucide="camera" class="w-6 h-6"></i>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-800 dark:text-white">Toca aquí para tomar foto o adjuntar captura</p>
              <p class="text-[10px] text-slate-400 mt-0.5">JPG, PNG o foto de celular (Se optimiza a WebP ligero)</p>
            </div>
          </div>

          <!-- Estado Subiendo -->
          <div id="upload-loading-state" class="hidden space-y-2 py-2">
            <span class="inline-block w-8 h-8 border-3 border-emerald-600 border-t-transparent rounded-full animate-spin"></span>
            <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Optimizando y guardando captura...</p>
          </div>

          <!-- Estado Listo con Previsualización -->
          <div id="upload-success-state" class="hidden space-y-3">
            <div class="flex items-center justify-center gap-3">
              <img id="payment-preview-img" src="" alt="Comprobante" class="w-16 h-16 object-cover rounded-xl border border-emerald-500 shadow-md">
              <div class="text-left">
                <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-black text-xs">
                  <i data-lucide="check-circle" class="w-4 h-4"></i>
                  <span>¡Comprobante Listo!</span>
                </div>
                <p id="payment-file-info" class="text-[10px] text-slate-400 mt-0.5"></p>
                <button type="button" id="btn-change-payment" class="text-[11px] text-blue-600 dark:text-yellow-400 hover:underline mt-1 font-bold">Cambiar foto</button>
              </div>
            </div>
          </div>
        </div>

        <div class="p-3 bg-amber-50 dark:bg-yellow-950/30 rounded-2xl border border-amber-200 dark:border-yellow-500/20 text-[11px] text-amber-800 dark:text-yellow-200/90 flex items-start gap-2">
          <i data-lucide="info" class="w-4 h-4 text-amber-600 dark:text-yellow-400 flex-shrink-0 mt-0.5"></i>
          <span>¿No realizaste la transferencia aún? Puedes enviar la inscripción ahora y coordinar el pago por WhatsApp antes del cierre de cupos.</span>
        </div>
      </div>

      <!-- CONSENTIMIENTO INFORMADO & PROTECCIÓN -->
      <div class="p-4 rounded-2xl bg-blue-50/70 dark:bg-gray-900 border border-blue-100 dark:border-gray-800 flex items-start gap-3">
        <input type="checkbox" id="consentCheck" name="consentGiven" checked required class="mt-1 w-4 h-4 rounded text-blue-600 focus:ring-blue-500 border-slate-300 cursor-pointer">
        <label for="consentCheck" class="text-xs text-slate-600 dark:text-gray-300 leading-relaxed cursor-pointer">
          Confirmo que soy padre/madre o tutor legal del pupilo/a, autorizo su participación en la corrida y confirmo que cuenta con aptitud física para la actividad deportiva.
        </label>
      </div>

      <!-- BOTÓN PRINCIPAL DE ENVÍO TÁCTIL -->
      <button type="submit" id="submit-btn" class="w-full py-4 px-6 rounded-2xl text-base font-black text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-xl shadow-blue-600/30 active:scale-98 transition-all flex items-center justify-center gap-2">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span>Confirmar Inscripción Oficial</span>
      </button>

      <!-- MENSAJE DE ÉXITO FINAL MODAL/INLINE -->
      <div id="success-message" class="hidden p-6 rounded-3xl bg-emerald-500 text-white text-center space-y-3 shadow-xl">
        <div class="w-14 h-14 bg-white text-emerald-600 rounded-full mx-auto flex items-center justify-center font-black text-2xl shadow-lg">
          ✓
        </div>
        <h3 class="text-xl font-black">¡Inscripción Exitosa!</h3>
        <p class="text-xs text-emerald-100 leading-relaxed" id="success-details">
          Hemos reservado el cupo y kit oficial. Te contactaremos al correo y WhatsApp indicados con las instrucciones de acreditación y número de dorsal.
        </p>
        <div class="pt-2">
          <a href="/" class="inline-block bg-white text-emerald-800 font-black text-xs px-6 py-3 rounded-2xl shadow-md">
            Volver a la Portada
          </a>
        </div>
      </div>
    </form>
  </main>

  <!-- PIE DE PÁGINA MÓVIL DISCRETO -->
  <footer class="py-6 text-center text-xs text-slate-400 dark:text-gray-600 border-t border-slate-200 dark:border-gray-800/80">
    <p><%= content.brand?.name || 'KidsRun 2026' %> • Evento Deportivo Familiar Seguro</p>
  </footer>

  <!-- SCRIPT DE INTERACCIÓN MOBILE FIRST -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();

      // 1. Selector táctil de Distancia
      const distanceCards = document.querySelectorAll('.distance-option');
      const distanceInput = document.getElementById('selectedDistance');

      distanceCards.forEach(card => {
        card.addEventListener('click', () => {
          distanceCards.forEach(c => {
            c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/40');
            c.classList.add('border', 'border-slate-200', 'dark:border-gray-800', 'bg-white', 'dark:bg-gray-950');
            const b = c.querySelector('span:last-child');
            if (b) {
              b.classList.remove('bg-blue-600', 'text-white');
              b.classList.add('bg-slate-100', 'dark:bg-gray-800', 'text-slate-600', 'dark:text-gray-300');
            }
          });

          card.classList.add('border-2', 'border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/40');
          card.classList.remove('border-slate-200', 'dark:border-gray-800', 'bg-white', 'dark:bg-gray-950');
          const badge = card.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-slate-100', 'dark:bg-gray-800', 'text-slate-600', 'dark:text-gray-300');
            badge.classList.add('bg-blue-600', 'text-white');
          }

          distanceInput.value = card.getAttribute('data-distance');
        });
      });

      // 2. Subida y Optimización Asíncrona del Comprobante
      const fileInput = document.getElementById('paymentFileInput');
      const idleState = document.getElementById('upload-idle-state');
      const loadingState = document.getElementById('upload-loading-state');
      const successState = document.getElementById('upload-success-state');
      const previewImg = document.getElementById('payment-preview-img');
      const fileInfo = document.getElementById('payment-file-info');
      const proofHidden = document.getElementById('paymentProofUrl');
      const btnChange = document.getElementById('btn-change-payment');

      fileInput.addEventListener('change', async () => {
        if (!fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];

        idleState.classList.add('hidden');
        successState.classList.add('hidden');
        loadingState.classList.remove('hidden');

        try {
          const csrfToken = document.getElementById('csrfTokenField')?.value || '';
          const formData = new FormData();
          formData.append('proof', file);

          const res = await fetch('/api/upload-proof', {
            method: 'POST',
            headers: {
              'X-CSRF-Token': csrfToken
            },
            body: formData
          });

          const json = await res.json();
          if (!res.ok || !json.success) {
            throw new Error(json.error || 'No se pudo procesar el comprobante');
          }

          proofHidden.value = json.data.url;
          previewImg.src = json.data.url;
          const kb = (json.data.sizeBytes / 1024).toFixed(1);
          fileInfo.textContent = `Optimizado a WebP (${kb} KB) • Guardado seguro`;

          loadingState.classList.add('hidden');
          successState.classList.remove('hidden');
          if (window.lucide) window.lucide.createIcons();
        } catch (err) {
          alert('Error al subir comprobante: ' + err.message);
          loadingState.classList.add('hidden');
          idleState.classList.remove('hidden');
        }
      });

      btnChange.addEventListener('click', (e) => {
        e.stopPropagation();
        proofHidden.value = '';
        fileInput.value = '';
        successState.classList.add('hidden');
        idleState.classList.remove('hidden');
      });

      // --- Validación de RUT chileno en cliente ---
      function validateRutClient(rut) {
        if (!rut) return false;
        const clean = rut.replace(/\./g, '').replace(/-/g, '').trim().toUpperCase();
        if (!/^\d{7,8}[0-9K]$/.test(clean)) return false;
        const body = clean.slice(0, -1);
        let dv = clean.slice(-1);
        let sum = 0;
        let mul = 2;
        for (let i = body.length - 1; i >= 0; i--) {
          sum += parseInt(body[i], 10) * mul;
          mul = mul === 7 ? 2 : mul + 1;
        }
        const expected = 11 - (sum % 11);
        const expectedDv = expected === 11 ? '0' : expected === 10 ? 'K' : String(expected);
        return dv === expectedDv;
      }

      // Validación de RUT en tiempo real (al salir del campo)
      const rutInput = document.getElementById('tutorRut');
      const rutError = document.getElementById('rutError');
      if (rutInput && rutError) {
        rutInput.addEventListener('blur', () => {
          if (rutInput.value && !validateRutClient(rutInput.value)) {
            rutError.classList.remove('hidden');
            rutInput.classList.add('border-red-500');
          } else {
            rutError.classList.add('hidden');
            rutInput.classList.remove('border-red-500');
          }
        });
      }

      // 3. Envío del Formulario
      const form = document.getElementById('registration-form');
      const submitBtn = document.getElementById('submit-btn');
      const successBox = document.getElementById('success-message');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot: si el campo oculto fue rellenado, es un bot — ignorar silenciosamente
        const honeypot = document.getElementById('website_url');
        if (honeypot && honeypot.value) {
          // Simular éxito sin enviar datos
          submitBtn.disabled = true;
          return;
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Validación de RUT en cliente antes de enviar
        if (data.tutorRut && !validateRutClient(data.tutorRut)) {
          alert('El RUT/DNI ingresado no es válido. Verifica el formato (ej: 12.345.678-9).');
          if (rutError) rutError.classList.remove('hidden');
          if (rutInput) rutInput.focus();
          return;
        }

        // Validar edad en rango
        const age = parseInt(data.kidAge, 10);
        if (isNaN(age) || age < 2 || age > 15) {
          alert('La edad del pequeño/a debe estar entre 2 y 15 años.');
          document.getElementById('kidAge')?.focus();
          return;
        }

        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="inline-block animate-spin mr-2">⟳</span> Guardando Inscripción...`;

        // Obtener CSRF token desde el campo hidden
        const csrfToken = document.getElementById('csrfTokenField')?.value || '';

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify(data)
          });

          const json = await res.json();
          if (res.ok && json.success) {
            form.querySelectorAll('.space-y-4, .space-y-3, .grid, button[type="submit"]').forEach(el => el.classList.add('hidden'));
            successBox.classList.remove('hidden');
            window.scrollTo({ top: successBox.offsetTop - 80, behavior: 'smooth' });
          } else {
            alert(json.error || 'No se pudo completar la inscripción. Por favor revisa los datos.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
          }
        } catch (err) {
          alert('Error de conexión. Inténtalo nuevamente.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      });
    });
  </script>
</body>
</html>

