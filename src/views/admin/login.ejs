<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso Administrador | CMS</title>
  <meta name="robots" content="noindex, nofollow">

  <!-- Tailwind CSS & Fuentes -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@1.47.0"></script>
  <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex items-center justify-center p-4 relative overflow-hidden">

  <!-- Luces ambientales -->
  <div class="ambient-glow bg-emerald-600/50 w-[500px] h-[500px] top-[-100px] left-1/2 -translate-x-1/2"></div>
  <div class="ambient-glow bg-purple-600/15 w-[400px] h-[400px] bottom-[-100px] right-[-100px]"></div>

  <div class="relative z-10 w-full max-w-md">
    
    <!-- Tarjeta de Login Glassmorphism -->
    <div class="glass-panel p-8 sm:p-10 rounded-3xl border border-white/10 shadow-2xl backdrop-blur-xl">
      
      <!-- Cabecera -->
      <div class="text-center mb-8">
        <div class="w-14 h-14 mx-auto rounded-3xl bg-gradient-to-tr from-red-500 via-emerald-400 to-yellow-400 p-[1px] shadow-lg shadow-emerald-500/50 mb-4">
          <div class="w-full h-full bg-gray-950 rounded-3xl flex items-center justify-center">
            <i data-lucide="shield-check" class="w-7 h-7 text-emerald-400"></i>
          </div>
        </div>
        <h1 class="text-2xl font-black text-white tracking-tight">Panel de Control CMS</h1>
        <p class="text-xs text-gray-400 mt-1">Acceso seguro para Administradores y Editores</p>
        <div class="flex items-center justify-center gap-2 mt-3">
          <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">Root (Admin)</span>
          <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30">Admin</span>
          <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">Editor</span>
        </div>
      </div>

      <!-- Alerta de Error -->
      <% if (error) { %>
      <div class="mb-6 p-4 rounded-3xl bg-red-950/40 border border-red-500/30 text-red-200 text-xs flex items-center gap-2.5">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-400 flex-shrink-0"></i>
        <span><%= error %></span>
      </div>
      <% } %>

      <!-- Formulario de Acceso -->
      <form action="/admin/login" method="POST" class="space-y-5">
        <input type="hidden" name="csrfToken" value="<%= csrfToken || '' %>">
        <div>
          <label for="username" class="block text-xs font-semibold text-gray-300 mb-1.5">Usuario (Admin o Editor)</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
              <i data-lucide="user" class="w-4 h-4"></i>
            </div>
            <input type="text" id="username" name="username" required placeholder="admin o editor" class="w-full bg-gray-900 border border-gray-800 rounded-3xl pl-10 pr-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors">
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-gray-300 mb-1.5">Contraseña</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500">
              <i data-lucide="lock" class="w-4 h-4"></i>
            </div>
            <input type="password" id="password" name="password" required class="w-full bg-gray-900 border border-gray-800 rounded-3xl pl-10 pr-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors">
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-3xl text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 shadow-lg shadow-blue-600/30 transition-all flex items-center justify-center gap-2">
          <span>Ingresar al Panel</span>
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </button>
      </form>

    </div>

    <!-- Enlace de regreso -->
    <div class="text-center mt-6">
      <a href="/" class="text-xs text-gray-400 hover:text-white transition-colors inline-flex items-center gap-1.5">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        Volver a la Landing Page
      </a>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) window.lucide.createIcons();
    });
  </script>
</body>
</html>
