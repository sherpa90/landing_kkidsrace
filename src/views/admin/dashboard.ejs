                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Rango de Edad</label>
                    <input type="text" name="categories[<%= idx %>][badge]" value="<%= cat.badge %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
