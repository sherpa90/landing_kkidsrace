                  <textarea name="categories[<%= idx %>][description]" rows="2" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white"><%= cat.description %></textarea>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: KITS Y PRECIOS -->
