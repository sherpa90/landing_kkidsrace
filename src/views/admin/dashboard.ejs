        <!-- PESTAÑA: IDENTIDAD & MARCA -->
        <div id="tab-brand" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="palette" class="w-4 h-4 text-emerald-400"></i>
              Identidad de Marca & Tema
            </h2>
            <p class="text-xs text-gray-400 mb-6">Nombre del evento infantil y paleta de colores vibrantes.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Nombre del Evento</label>
                <input type="text" id="input-brandName" value="<%= content.brand?.name || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Texto del Logo</label>
                <input type="text" id="input-logoText" value="<%= content.brand?.logoText || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Lema / Subtítulo Oficial</label>
                <input type="text" id="input-brandTagline" value="<%= content.brand?.tagline || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Logo Oficial (Imagen optimizada en servidor)</label>
                <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                  <div class="w-16 h-16 rounded-2xl bg-gray-900 border border-gray-800 flex items-center justify-center overflow-hidden flex-shrink-0" id="preview-logo-box">
                    <% if (content.brand?.logoUrl) { %>
                      <img src="<%= content.brand.logoUrl %>" alt="Logo" class="max-w-full max-h-full object-contain">
                    <% } else { %>
                      <i data-lucide="<%= content.brand?.logoIcon || 'trophy' %>" class="w-6 h-6 text-gray-500"></i>
                    <% } %>
                  </div>
                  <div class="flex-1 w-full space-y-2">
                    <div class="flex gap-2">
                      <input type="text" id="input-logoUrl" value="<%= content.brand?.logoUrl || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white focus:outline-none focus:border-emerald-400" placeholder="/uploads/mi-logo.webp o URL externa">
                      <label class="cursor-pointer bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-3.5 py-2 rounded-2xl flex items-center gap-1.5 whitespace-nowrap transition-all shadow-md shadow-blue-600/30">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        <span>Subir Foto</span>
                        <input type="file" class="hidden file-uploader-input" data-target-input="#input-logoUrl" data-preview-box="#preview-logo-box" data-upload-type="logo" accept="image/*">
                      </label>
                    </div>
                    <p class="text-[11px] text-gray-400">Las imágenes subidas se redimensionan y se convierten a <strong>WebP ultra ligero</strong> automáticamente.</p>
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Icono del Logo (Lucide - si no hay imagen)</label>
                <input type="text" id="input-logoIcon" value="<%= content.brand?.logoIcon || 'trophy' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Modo Visual Predeterminado de la Web</label>
                <select id="input-themeMode" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                  <option value="light" <%= (content.brand?.themeMode !== 'dark') ? 'selected' : '' %>>☀️ Modo Claro (White Mode)</option>
                  <option value="dark" <%= (content.brand?.themeMode === 'dark') ? 'selected' : '' %>>🌙 Modo Oscuro (Dark Mode)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Paleta de Color de Acento</label>
                <input type="hidden" id="input-accentColor" value="<%= content.brand?.accentColor || 'green_yellow' %>">
                <div class="flex items-center gap-2 pt-1">
                  <% Object.entries(themes).forEach(([key, thm]) => { %>
                  <button type="button" class="color-choice-btn w-8 h-8 rounded-full border border-white/20 transition-transform <%= content.brand?.accentColor === key ? 'ring-4 ring-white/40 scale-110' : '' %>" data-color="<%= key %>" style="background-color: <%= thm.primaryHex %>;" title="<%= thm.name %>"></button>
                  <% }); %>
                </div>
              </div>
            </div>

            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3 pt-4 border-t border-gray-800">Redes Sociales Oficiales</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-gray-400 mb-1">Instagram URL</label>
                <input type="text" id="input-socialInstagram" value="<%= content.footer?.socialLinks?.instagram || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">Facebook URL</label>
                <input type="text" id="input-socialFacebook" value="<%= content.footer?.socialLinks?.facebook || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">Twitter / X URL</label>
                <input type="text" id="input-socialTwitter" value="<%= content.footer?.socialLinks?.twitter || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">YouTube URL</label>
                <input type="text" id="input-socialYoutube" value="<%= content.footer?.socialLinks?.youtube || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: HERO -->
        <div id="tab-hero" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
