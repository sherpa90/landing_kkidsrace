<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <meta name="current-user" content="<%= username || '' %>">
  <title>CMS Dashboard | <%= content.brand?.name || 'KidsRun 2026' %></title>
  <link rel="icon" type="image/x-icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <link rel="shortcut icon" href="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>">
  <meta name="robots" content="noindex, nofollow">

  <!-- Tailwind CSS & Lucide -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@1.47.0"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <link rel="stylesheet" href="/css/custom.css?v=<%= Date.now() %>">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">

  <!-- BARRA SUPERIOR DEL DASHBOARD -->
  <header class="h-14 sm:h-16 border-b border-slate-800 bg-slate-900/95 backdrop-blur-md sticky top-0 z-40 flex items-center justify-between px-3 sm:px-5 gap-2">

    <!-- LADO IZQUIERDO: Hamburguesa + Logo -->
    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
      <!-- Botón Hamburguesa (sólo en md para abajo) -->
      <button type="button" id="btn-toggle-mobile-menu"
        class="md:hidden p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 transition-colors shrink-0"
        aria-label="Abrir Menú">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>

      <!-- Logo + Nombre -->
      <div class="flex items-center gap-2 min-w-0">
        <% if (content.brand?.logoUrl) { %>
        <img src="<%= content.brand.logoUrl %>" alt="Logo" class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl object-contain bg-slate-900 border border-slate-700 p-0.5 shadow-md shrink-0">
        <% } else { %>
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-amber-400 flex items-center justify-center text-slate-950 font-black shadow-md shrink-0">
          <i data-lucide="trophy" class="w-3.5 h-3.5 sm:w-4 sm:h-4"></i>
        </div>
        <% } %>
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="font-black text-sm text-white tracking-tight truncate max-w-[90px] xs:max-w-[120px] sm:max-w-[180px] md:max-w-none"><%= content.brand?.name || 'KidsRun 2026' %></span>
          <span class="text-[9px] sm:text-[10px] bg-blue-600 text-white font-bold px-1.5 py-0.5 rounded-full border border-blue-400 shrink-0">CMS</span>
        </div>
      </div>
    </div>

    <!-- CENTRO: Rol/Usuario (sólo en pantallas md+) -->
    <div class="hidden md:flex items-center gap-2 flex-1 justify-center">
      <div class="flex items-center gap-1.5 px-3 py-1 rounded-xl <%= role === 'admin' ? 'bg-blue-950/90 border border-blue-500/50 text-blue-300' : 'bg-amber-950/90 border border-amber-500/50 text-amber-300' %>">
        <span class="w-2 h-2 rounded-full <%= role === 'admin' ? 'bg-blue-400 animate-pulse' : 'bg-amber-400' %>"></span>
        <span class="text-xs font-black uppercase tracking-wider">
          <%= role === 'admin' ? 'Administrador' : 'Editor' %>
        </span>
        <span class="text-xs text-slate-400 font-mono">(<%= username %>)</span>
      </div>
    </div>

    <!-- LADO DERECHO: Acciones -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">

      <!-- Botón Toggle Construcción (icono en móvil, texto en sm+) -->
      <button type="button" id="btn-header-toggle-construction"
        class="text-xs font-bold px-2 sm:px-3 py-1.5 rounded-xl border transition-all flex items-center gap-1 sm:gap-1.5 cursor-pointer shadow-sm
               <%= content.construction?.enabled
                 ? 'bg-amber-500/20 border-amber-500/50 text-amber-300 hover:bg-amber-500/30'
                 : 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700 hover:text-white' %>"
        title="Activar o Desactivar Modo Construcción">
        <i data-lucide="construction" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
        <span class="hidden sm:inline">Construcción:</span>
        <span id="header-construction-status-text" class="font-black <%= content.construction?.enabled ? 'text-amber-400' : 'text-slate-400' %>">
          <%= content.construction?.enabled ? 'ON' : 'OFF' %>
        </span>
      </button>

      <!-- Indicador de Modo Construcción (sólo lg+) -->
      <div id="top-construction-badge" class="hidden lg:<%= content.construction?.enabled ? 'flex' : 'hidden' %> items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-300 text-xs font-bold">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>Activo</span>
      </div>

      <!-- Vista Público (icono siempre, texto en sm+) -->
      <a href="/preview-construction" target="_blank"
        class="text-xs font-bold px-2 sm:px-3 py-2 rounded-xl text-amber-300 hover:text-white bg-amber-950/40 hover:bg-amber-900 border border-amber-500/30 transition-all flex items-center gap-1 sm:gap-1.5"
        title="Previsualizar cómo ve el público la web">
        <i data-lucide="eye" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
        <span class="hidden sm:inline">Público</span>
      </a>

      <!-- Web en Vivo (solo sm+) -->
      <a href="/" target="_blank"
        class="hidden sm:flex text-xs font-bold px-3 py-2 rounded-xl text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-all items-center gap-1.5"
        title="Ver Web en Vivo">
        <i data-lucide="external-link" class="w-3.5 h-3.5 text-blue-400"></i>
        <span class="hidden md:inline">Web</span>
      </a>

      <!-- Guardar (solo admin) -->
      <% if (role === 'admin') { %>
      <button type="button" id="btn-save-cms"
        class="text-xs font-black px-3 sm:px-4 py-2 rounded-xl text-white bg-blue-600 hover:bg-blue-500 active:bg-blue-700 shadow-md shadow-blue-600/30 transition-all flex items-center gap-1.5">
        <i data-lucide="save" class="w-3.5 h-3.5 shrink-0"></i>
        <span>Guardar</span>
      </button>
      <% } %>

      <!-- Cerrar Sesión -->
      <a href="/admin/logout" class="p-2 text-slate-400 hover:text-red-400 rounded-xl hover:bg-slate-800 transition-all" title="Cerrar Sesión">
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </a>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL: SIDEBAR + PANELES -->
  <div id="main-layout-wrapper" class="flex-1 flex flex-col md:flex-row max-w-7xl w-full mx-auto p-3 sm:p-6 gap-6 relative">
    
    <!-- Backdrop Móvil -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-40 hidden md:hidden"></div>

    <!-- BARRA LATERAL DE NAVEGACIÓN (TABS) -->
    <aside id="sidebar-nav" class="fixed inset-y-0 left-0 w-72 bg-slate-900 border-r border-slate-800 z-50 p-4 transform -translate-x-full transition-transform duration-200 ease-in-out md:translate-x-0 md:static md:w-64 md:bg-transparent md:border-r-0 md:z-auto md:p-0 md:block flex-shrink-0 space-y-2 overflow-y-auto">
      <div class="flex items-center justify-between md:hidden pb-3 mb-2 border-b border-slate-800">
        <span class="font-black text-sm text-white">Menú del Panel</span>
        <button type="button" id="btn-close-mobile-menu" class="p-1.5 text-slate-400 hover:text-white rounded-lg">✕</button>
      </div>

      <div class="p-3 bg-slate-900 rounded-2xl border border-slate-800 mb-3 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-2xl <%= role === 'admin' ? 'bg-blue-600' : 'bg-amber-500' %> text-white flex items-center justify-center font-bold text-sm shadow-md">
            <%= (name || username || 'U')[0].toUpperCase() %>
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-bold text-white truncate"><%= name || username %></p>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="w-1.5 h-1.5 rounded-full <%= role === 'admin' ? 'bg-blue-400 animate-pulse' : 'bg-amber-400' %>"></span>
              <span class="text-[10px] font-bold uppercase tracking-wider <%= role === 'admin' ? 'text-blue-400' : 'text-amber-400' %>">
                <%= role === 'admin' ? 'Administrador' : 'Editor' %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <nav class="space-y-1">
        <!-- Pestaña de Corridas (Administrador) -->
        <% if (role === 'admin') { %>
        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-bold bg-blue-600 text-white shadow-md shadow-blue-600/30 transition-all text-left" data-tab="races">
          <div class="flex items-center gap-2.5">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            <span>🏃‍♂️ Corridas & Fechas</span>
          </div>
          <span class="text-[10px] bg-blue-800 text-blue-200 px-2 py-0.5 rounded-full font-black"><%= (races || []).length %></span>
        </button>
        <% } %>

        <!-- Base de Datos de Participantes (Admin y Editor) -->
        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold <%= role !== 'admin' ? 'bg-blue-600 text-white shadow-md shadow-blue-600/30' : 'text-gray-300 hover:text-white hover:bg-gray-900' %> transition-all text-left" data-tab="leads">
          <div class="flex items-center gap-2.5">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>📋 Base de Participantes</span>
          </div>
          <% if (leads && leads.length > 0) { %>
          <span class="bg-red-500 text-white text-[10px] font-black px-2 py-0.5 rounded-full"><%= leads.length %></span>
          <% } %>
        </button>
        <!-- Gestión de Usuarios (Solo Administrador) -->
        <% if (role === 'admin') { %>
        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="users">
          <div class="flex items-center gap-2.5">
            <i data-lucide="users" class="w-4 h-4 text-emerald-400"></i>
            <span>Usuarios</span>
          </div>
          <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full font-bold" id="users-count-badge"><%= (typeof usersList !== 'undefined' ? usersList.length : 2) %></span>
        </button>

        <!-- Modo Construcción / Lanzamiento (Solo Administrador) -->
        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="construction">
          <div class="flex items-center gap-2.5">
            <i data-lucide="construction" class="w-4 h-4 text-amber-400"></i>
            <span>🚧 Modo Construcción</span>
          </div>
          <span class="text-[9px] px-1.5 py-0.5 rounded-full font-black <%= content.construction?.enabled ? 'bg-amber-500 text-slate-950 animate-pulse' : 'bg-slate-800 text-slate-400' %>" id="sidebar-construction-badge">
            <%= content.construction?.enabled ? 'ACTIVO' : 'OFF' %>
          </span>
        </button>
        <% } %>

        <% if (role === 'admin') { %>
        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-300 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="hero">
          <div class="flex items-center gap-2.5">
            <i data-lucide="sparkles" class="w-4 h-4 text-amber-400"></i>
            <span>⭐ Portada & Métricas (Hero)</span>
          </div>
          <span class="text-[9px] bg-amber-500/20 text-amber-300 border border-amber-500/30 px-1.5 py-0.5 rounded-full font-bold">Principal</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="countdown">
          <i data-lucide="clock" class="w-4 h-4"></i>
          <span>⏰ Cuenta Regresiva</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="circuits">
          <i data-lucide="flag" class="w-4 h-4"></i>
          <span>Circuitos & Edades</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="schedule">
          <div class="flex items-center gap-2.5">
            <i data-lucide="calendar-clock" class="w-4 h-4 text-blue-400"></i>
            <span>📅 Cronograma del Día</span>
          </div>
          <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full font-bold" id="schedule-count-badge"><%= (content.schedule || []).length %></span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="gallery">
          <i data-lucide="image" class="w-4 h-4"></i>
          <span>🖼️ Galería de Fotos</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="kits">
          <i data-lucide="tag" class="w-4 h-4"></i>
          <span>Kits de Corredor</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="brand">
          <div class="flex items-center gap-2.5">
            <i data-lucide="palette" class="w-4 h-4 text-purple-400"></i>
            <span>Identidad, Logo & Pestaña</span>
          </div>
          <span class="text-[9px] bg-purple-500/20 text-purple-300 border border-purple-500/30 px-1.5 py-0.5 rounded-full font-bold">Web</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="sections">
          <i data-lucide="layout-list" class="w-4 h-4"></i>
          <span>🔧 Secciones</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="testimonials">
          <i data-lucide="message-square" class="w-4 h-4"></i>
          <span>Testimonios Familiares</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="faqs">
          <div class="flex items-center gap-2.5">
            <i data-lucide="help-circle" class="w-4 h-4"></i>
            <span>Preguntas Frecuentes</span>
          </div>
          <span class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full font-bold" id="faqs-count-badge"><%= (content.faqs || []).length %></span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="sponsors">
          <i data-lucide="building-2" class="w-4 h-4"></i>
          <span>🤝 Auspiciadores</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="venue">
          <i data-lucide="map-pin" class="w-4 h-4"></i>
          <span>📍 Lugar del Evento</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="contact">
          <i data-lucide="mail" class="w-4 h-4"></i>
          <span>✉️ Contacto & Envíos</span>
        </button>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="seo">
          <i data-lucide="search" class="w-4 h-4"></i>
          <span>SEO & Google Events</span>
        </button>
        <% } %>

        <button type="button" class="tab-btn w-full flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl text-xs font-semibold text-gray-400 hover:text-white hover:bg-gray-900 transition-all text-left" data-tab="security">
          <i data-lucide="shield" class="w-4 h-4"></i>
          <span>Seguridad & Clave</span>
        </button>
      </nav>
    </aside>

    <!-- Botón flotante para mostrar sidebar (visible solo en tab leads en escritorio) -->
    <button type="button" id="btn-show-sidebar-leads"
      class="hidden fixed bottom-6 left-6 z-30 items-center gap-2 px-4 py-2.5 rounded-2xl bg-slate-800 border border-slate-700 text-slate-200 text-xs font-bold hover:bg-slate-700 hover:text-white shadow-lg transition-all"
      title="Mostrar panel de navegación">
      <i data-lucide="panel-left-open" class="w-4 h-4 text-blue-400"></i>
      <span>Mostrar menú</span>
    </button>

    <!-- ÁREA DE CONTENIDO / FORMULARIO CMS -->
    <main id="main-content-area" class="flex-1 min-w-0">
      <form id="cms-form" onsubmit="return false;" class="space-y-6">
        
        <!-- PESTAÑA: GESTIÓN DE CORRIDAS & FECHAS (SOLO ADMINISTRADOR) -->
        <% if (role === 'admin') { %>
        <div id="tab-races" class="tab-pane space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-gray-800">
              <div>
                <h2 class="text-lg font-black text-white flex items-center gap-2">
                  <i data-lucide="calendar" class="w-5 h-5 text-blue-400"></i>
                  Gestión y Programación de Corridas
                </h2>
                <p class="text-xs text-gray-400 mt-0.5">Edita, pausa o activa corridas en la web, amplía cupos y administra fechas oficiales.</p>
              </div>
              <button type="button" id="btn-open-new-race" class="px-4 py-2.5 rounded-2xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/30 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Generar Nueva Corrida</span>
              </button>
            </div>

            <!-- Formulario Desplegable para Crear / Editar Corrida -->
            <div id="race-form-panel" class="hidden p-6 rounded-2xl bg-gray-900 border border-blue-500/40 shadow-2xl space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-gray-800">
                <h3 class="text-sm font-bold text-white flex items-center gap-2" id="race-form-title">
                  <i data-lucide="flag" class="w-4 h-4 text-blue-400"></i>
                  <span>Crear Nueva Edición de Carrera</span>
                </h3>
                <button type="button" id="btn-cancel-race-form" class="text-xs text-gray-400 hover:text-white transition-colors cursor-pointer">✕ Cancelar</button>
              </div>

              <input type="hidden" id="input-editRaceId" value="">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="sm:col-span-2">
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Nombre Oficial del Evento *</label>
                  <input type="text" id="input-raceName" placeholder="Ej: KidsRun 2026 - Gran Corrida Bicentenario" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500 font-bold">
                </div>

                <div>
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Fecha y Hora de Largada (ISO) *</label>
                  <input type="datetime-local" id="input-raceDate" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
                </div>

                <div>
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Hora de Largada Visible</label>
                  <input type="text" id="input-raceTime" placeholder="09:00 AM" value="09:00 AM" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500 font-mono">
                </div>

                <div>
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Lugar del Evento</label>
                  <input type="text" id="input-raceLocation" placeholder="Parque Bicentenario • Circuito Cerrado" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
                </div>

                <div>
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Sector / Comuna</label>
                  <input type="text" id="input-raceCity" placeholder="Vitacura, Santiago" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
                </div>

                <div>
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Cupo Máximo de Inscripciones *</label>
                  <input type="number" id="input-raceMax" value="500" min="1" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500 font-bold">
                </div>

                <div>
                  <label class="block text-xs text-gray-300 font-semibold mb-1">Estado de Publicación en la Web *</label>
                  <select id="input-raceStatus" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-blue-500">
                    <option value="active">⚡ Activa en Web (Recibiendo Inscripciones)</option>
                    <option value="paused">⏸ Pausada en Web (Inscripciones Suspendidas)</option>
                    <option value="inactive">🚫 Desactivada de la Web (No visible en portada)</option>
                    <option value="planned">📅 Programada / Borrador</option>
                  </select>
                </div>
              </div>

              <div class="flex items-center justify-end gap-3 pt-3 border-t border-gray-800">
                <button type="button" id="btn-cancel-race-form-2" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400 hover:text-white transition-colors cursor-pointer">
                  Cancelar
                </button>
                <button type="button" id="btn-submit-race" class="px-6 py-2.5 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all flex items-center gap-1.5 cursor-pointer">
                  <i data-lucide="check" class="w-4 h-4"></i>
                  <span id="btn-submit-race-text">Guardar Corrida</span>
                </button>
              </div>
            </div>

            <!-- Lista de Corridas Registradas -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5" id="races-list-container">
              <% (races || []).forEach(race => { 
                   const enrolled = (leads || []).filter(l => l.raceId === race.id).length;
                   const maxPart = parseInt(race.maxParticipants, 10) || 500;
                   const available = Math.max(0, maxPart - enrolled);
                   const pct = Math.min(100, Math.round((enrolled / maxPart) * 100));
                   const isAct = race.status === 'active';
                   const isPaused = race.status === 'paused';
              %>
              <div class="p-5 rounded-2xl bg-gray-900/80 border <%= isAct ? 'border-emerald-500/60 ring-1 ring-emerald-500/20 shadow-lg shadow-emerald-500/10' : (isPaused ? 'border-amber-500/60 ring-1 ring-amber-500/20' : 'border-gray-800') %> flex flex-col justify-between space-y-4 transition-all">
                
                <div class="space-y-3">
                  <div class="flex items-center justify-between gap-2">
                    <% if (isAct) { %>
                    <span class="text-[10px] font-black uppercase px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                      ⚡ ACTIVA EN WEB
                    </span>
                    <% } else if (isPaused) { %>
                    <span class="text-[10px] font-black uppercase px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 flex items-center gap-1 animate-pulse">
                      <i data-lucide="pause-circle" class="w-3 h-3 text-amber-400"></i>
                      ⏸ PAUSADA EN WEB
                    </span>
                    <% } else { %>
                    <span class="text-[10px] font-black uppercase px-2.5 py-1 rounded-full bg-gray-800 text-gray-400 border border-gray-700">
                      DESACTIVADA
                    </span>
                    <% } %>
                    <span class="text-xs font-mono text-gray-400">Año <%= race.year || '2026' %></span>
                  </div>

                  <div>
                    <h3 class="text-base font-bold text-white mb-1"><%= race.name %></h3>
                    <p class="text-xs text-blue-400 font-medium flex items-center gap-1.5 mb-1.5">
                      <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                      <span><%= race.dateDisplay || race.date %> • <%= race.time %></span>
                    </p>
                    <p class="text-xs text-gray-400 flex items-center gap-1.5">
                      <i data-lucide="map-pin" class="w-3.5 h-3.5 text-gray-500"></i>
                      <span><%= race.location %> <%= race.city ? `(${race.city})` : '' %></span>
                    </p>
                  </div>

                  <!-- Barra y métricas de cupos -->
                  <div class="p-3.5 rounded-xl bg-slate-950/60 border border-gray-800 space-y-2">
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-400">
                        Cupos: <strong class="text-white"><%= enrolled %></strong> / <strong class="text-slate-200"><%= maxPart %></strong>
                      </span>
                      <span class="text-[11px] font-bold <%= available > 20 ? 'text-emerald-400' : (available > 0 ? 'text-amber-400' : 'text-red-400') %>">
                        <%= available > 0 ? `${available} disponibles` : '¡AGOTADOS!' %> (<%= pct %>%)
                      </span>
                    </div>
                    <div class="w-full bg-gray-800 rounded-full h-2 overflow-hidden">
                      <div class="h-full rounded-full transition-all <%= pct >= 100 ? 'bg-red-500' : (pct >= 80 ? 'bg-amber-500' : 'bg-emerald-500') %>" style="width: <%= pct %>%"></div>
                    </div>
                    <div class="flex items-center justify-between pt-1">
                      <span class="text-[10px] text-gray-500 font-medium">Capacidad oficial</span>
                      <div class="flex items-center gap-1.5">
                        <button type="button" class="btn-quick-add-cupos text-[10px] font-bold px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all cursor-pointer" data-race-id="<%= race.id %>" data-add="50" title="Sumar 50 cupos inmediatamente">
                          +50 Cupos
                        </button>
                        <button type="button" class="btn-quick-add-cupos text-[10px] font-bold px-2 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-all cursor-pointer" data-race-id="<%= race.id %>" data-add="100" title="Sumar 100 cupos inmediatamente">
                          +100 Cupos
                        </button>
                        <button type="button" class="btn-custom-cupos text-[10px] font-bold px-2 py-1 rounded-lg bg-blue-950/60 hover:bg-blue-900 border border-blue-800 text-blue-300 transition-all cursor-pointer" data-race-id="<%= race.id %>" data-race-name="<%= race.name %>" data-current-max="<%= maxPart %>">
                          ✏ Ajustar
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Botonera de Acciones (Editar, Pausar, Activar/Desactivar, Eliminar) -->
                <div class="pt-3 border-t border-gray-800 flex flex-wrap items-center justify-between gap-2 text-xs">
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="btn-edit-race px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition-all flex items-center gap-1 cursor-pointer"
                      data-id="<%= race.id %>"
                      data-name="<%= race.name %>"
                      data-date="<%= race.date %>"
                      data-time="<%= race.time %>"
                      data-location="<%= race.location %>"
                      data-city="<%= race.city || '' %>"
                      data-max="<%= maxPart %>"
                      data-status="<%= race.status %>">
                      <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                      <span>Editar</span>
                    </button>

                    <% if (isAct) { %>
                    <button type="button" class="btn-toggle-race-status px-3 py-1.5 rounded-xl bg-amber-950/60 hover:bg-amber-900 border border-amber-500/40 text-amber-300 font-bold transition-all flex items-center gap-1 cursor-pointer" data-race-id="<%= race.id %>" data-status="paused" title="Pausar temporalmente las inscripciones en la web">
                      <i data-lucide="pause" class="w-3.5 h-3.5"></i>
                      <span>Pausar</span>
                    </button>
                    <% } else if (isPaused) { %>
                    <button type="button" class="btn-toggle-race-status px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold transition-all flex items-center gap-1 cursor-pointer shadow-md shadow-emerald-600/30" data-race-id="<%= race.id %>" data-status="active" title="Reanudar inscripciones en la web">
                      <i data-lucide="play" class="w-3.5 h-3.5"></i>
                      <span>Reanudar</span>
                    </button>
                    <% } %>
                  </div>

                  <div class="flex items-center gap-1.5">
                    <% if (!isAct) { %>
                    <button type="button" class="btn-toggle-race-status px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold transition-all flex items-center gap-1 cursor-pointer shadow-md shadow-blue-600/30" data-race-id="<%= race.id %>" data-status="active" title="Activar esta corrida como la oficial para la web">
                      <i data-lucide="check" class="w-3.5 h-3.5"></i>
                      <span>Activar en Web</span>
                    </button>
                    <% } else { %>
                    <button type="button" class="btn-toggle-race-status px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold transition-all flex items-center gap-1 cursor-pointer" data-race-id="<%= race.id %>" data-status="inactive" title="Desactivar esta corrida de la web pública">
                      <i data-lucide="power" class="w-3.5 h-3.5"></i>
                      <span>Desactivar</span>
                    </button>
                    <% } %>

                    <button type="button" class="btn-delete-race p-1.5 rounded-xl bg-red-950/60 hover:bg-red-900 border border-red-500/30 text-red-300 transition-all cursor-pointer" data-race-id="<%= race.id %>" data-race-name="<%= race.name %>" title="Eliminar corrida del sistema">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </div>

              </div>
              <% }); %>
            </div>

          </div>
        </div>
        <% } %>

        <!-- PESTAÑA: CUENTA REGRESIVA & FECHA DEL EVENTO -->
        <div id="tab-countdown" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="clock" class="w-4 h-4 text-emerald-400"></i>
              Configuración de la Cuenta Regresiva
            </h2>
            <p class="text-xs text-gray-400 mb-6">Define el día exacto de la corrida infantil para el contador en vivo de la portada.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Fecha y Hora Objetivo (ISO / Estándar)</label>
                <input type="text" id="input-cdTargetDate" value="<%= content.countdown?.targetDate || '2026-11-15T09:00:00' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400 font-mono" placeholder="YYYY-MM-DDTHH:mm:ss">
                <span class="text-[10px] text-gray-500 mt-1 block">Ejemplo: 2026-11-15T09:00:00</span>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Fecha Visible para Familias</label>
                <input type="text" id="input-cdEventDateDisplay" value="<%= content.countdown?.eventDateDisplay || 'Domingo 15 de Noviembre, 2026' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Hora de Largada</label>
                <input type="text" id="input-cdEventTime" value="<%= content.countdown?.eventTime || '09:00 AM' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Texto del Badge Superior</label>
                <input type="text" id="input-cdBadge" value="<%= content.countdown?.badge || '⏰ ¡FALTAN SÓLO!' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Lugar / Parque del Evento</label>
                <input type="text" id="input-cdLocationName" value="<%= content.countdown?.locationName || 'Parque Bicentenario • Circuito Cerrado' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Sector o Ciudad</label>
                <input type="text" id="input-cdLocationCity" value="<%= content.countdown?.locationCity || 'Sector Explanada Central' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: GALERÍA DE FOTOS -->
        <div id="tab-gallery" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
                  <i data-lucide="image" class="w-4 h-4 text-emerald-400"></i>
                  Gestión de la Galería de Fotos
                </h2>
                <p class="text-xs text-gray-400">Fotos de alta resolución de la carrera, medallas y familias con visor modal.</p>
              </div>
              <button type="button" id="btn-add-gallery" class="px-3.5 py-2 rounded-3xl text-xs font-bold text-yellow-300 bg-yellow-200/50 border border-yellow-400/60 hover:bg-yellow-300/60 transition-all flex items-center gap-1.5">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                <span>Agregar Foto</span>
              </button>
            </div>

            <div id="gallery-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% (content.gallery || []).forEach((photo, idx) => { %>
              <div class="gallery-admin-item p-4 rounded-3xl bg-gray-900/70 border border-gray-800 relative space-y-3">
                <button type="button" class="btn-delete-item absolute top-3 right-3 text-red-400 hover:text-red-300 p-1 bg-red-950/40 rounded-xl" title="Eliminar">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>

                <div class="flex items-center gap-3">
                  <img src="<%= photo.url %>" alt="" class="w-16 h-16 rounded-3xl object-cover border border-gray-800 bg-gray-950 flex-shrink-0">
                  <div class="flex-1 min-w-0 pr-8">
                    <label class="block text-[11px] text-gray-400 mb-0.5">Título de la Foto</label>
                    <input type="text" name="gallery[<%= idx %>][title]" value="<%= photo.title %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-400 font-bold">
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <label class="block text-[11px] text-gray-400 mb-0.5">Categoría (Tag)</label>
                    <input type="text" name="gallery[<%= idx %>][category]" value="<%= photo.category || 'Carrera' %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-400">
                  </div>
                  <div>
                    <label class="block text-[11px] text-gray-400 mb-0.5">Foto (URL o Subir)</label>
                    <div class="flex gap-1.5">
                      <input type="text" name="gallery[<%= idx %>][url]" value="<%= photo.url %>" class="gallery-url-input w-full bg-gray-950 border border-gray-800 rounded-xl px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-400" placeholder="/uploads/..." id="gal-url-<%= idx %>">
                      <label class="cursor-pointer bg-blue-600/80 hover:bg-blue-600 text-white text-[11px] font-bold px-2.5 py-1.5 rounded-xl flex items-center gap-1 whitespace-nowrap transition-all" title="Subir y optimizar foto">
                        <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                        <span>Subir</span>
                        <input type="file" class="hidden file-uploader-input" data-target-input="#gal-url-<%= idx %>" data-preview-img="img" data-upload-type="standard" accept="image/*">
                      </label>
                    </div>
                  </div>
                </div>

                <div>
                  <label class="block text-[11px] text-gray-400 mb-0.5">Descripción / Pie de Foto</label>
                  <textarea name="gallery[<%= idx %>][caption]" rows="2" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-2.5 py-1.5 text-xs text-gray-300 focus:outline-none focus:border-emerald-400"><%= photo.caption %></textarea>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        
        <!-- PESTAÑA: SECCIONES DE LA PÁGINA -->
        <div id="tab-sections" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-lg font-black text-white flex items-center gap-2 mb-1">
              <i data-lucide="layout-list" class="w-5 h-5 text-purple-400"></i>
              Secciones de la Página
            </h2>
            <p class="text-xs text-gray-400 mb-6">Arrastra para reordenar. Activa o desactiva el toggle para mostrar u ocultar cada sección. Presiona <strong class="text-white">Guardar Cambios</strong> para publicar.</p>

            <div id="sections-sortable-list" class="space-y-2">
              <%
                const allSectionsMeta = {
                  hero: { icon: 'trophy', name: 'Sección Principal (Hero)', desc: 'La portada con título, CTA e imagen principal.', warn: true },
                  countdown: { icon: 'clock', name: 'Cuenta Regresiva', desc: 'Temporizador hasta la fecha del evento.' },
                  circuits: { icon: 'flag', name: 'Circuitos & Categorías', desc: 'Distancias y categorías por edad.' },
                  schedule: { icon: 'calendar', name: 'Cronograma del Día', desc: 'Horario de actividades durante el evento.' },
                  gallery: { icon: 'image', name: 'Galería de Fotos', desc: 'Galería de imágenes de ediciones anteriores.' },
                  kits: { icon: 'package', name: 'Kits & Precios', desc: 'Planes de inscripción y contenido del kit.' },
                  testimonials: { icon: 'message-square', name: 'Testimonios', desc: 'Comentarios de participantes anteriores.' },
                  faq: { icon: 'help-circle', name: 'Preguntas Frecuentes', desc: 'Respuestas a las dudas más comunes.' },
                  sponsors: { icon: 'building-2', name: 'Auspiciadores', desc: 'Carrusel de logos de marcas auspiciadoras.' },
                  venue: { icon: 'map-pin', name: 'Lugar del Evento', desc: 'Mapa interactivo con la ubicación.' },
                  contact: { icon: 'mail', name: 'Contacto', desc: 'Formulario de consultas y datos de contacto.' }
                };
                const savedOrder = (content.sections && Array.isArray(content.sections.order)) ? content.sections.order : Object.keys(allSectionsMeta);
                // Asegurar que todas las secciones existan
                const finalOrder = [...savedOrder];
                Object.keys(allSectionsMeta).forEach(k => {
                  if (!finalOrder.includes(k)) finalOrder.push(k);
                });
              %>
              <% finalOrder.forEach(sid => { 
                  const meta = allSectionsMeta[sid];
                  if (!meta) return;
                  const isVisible = !(content.sections && content.sections.visibility && content.sections.visibility[sid] === false);
              %>
              <div class="section-sortable-item flex items-center gap-3 p-3 rounded-2xl bg-gray-900/60 border border-gray-800 cursor-grab active:cursor-grabbing hover:border-gray-600 transition-all" data-section-id="<%= sid %>" draggable="true">
                <div class="text-gray-600 hover:text-gray-400 transition-colors select-none text-lg leading-none shrink-0" title="Arrastrar para reordenar">⠿</div>
                <i data-lucide="<%= meta.icon %>" class="w-4 h-4 text-blue-400 shrink-0"></i>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-semibold text-white truncate">
                    <%= meta.name %>
                    <% if (meta.warn) { %><span class="ml-1 text-amber-400 text-xs">⚠️ recomendado</span><% } %>
                  </div>
                  <div class="text-xs text-gray-500 truncate"><%= meta.desc %></div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer shrink-0" title="Mostrar / Ocultar">
                  <input type="checkbox" class="section-visibility-toggle sr-only" data-section-id="<%= sid %>" <%= isVisible ? 'checked' : '' %>>
                  <div class="toggle-track w-10 h-5 bg-gray-700 rounded-full transition-colors peer-checked:bg-blue-600 relative">
                    <div class="toggle-thumb absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full transition-transform shadow"></div>
                  </div>
                </label>
              </div>
              <% }); %>
            </div>

            <div class="mt-5 p-3 rounded-2xl bg-purple-900/20 border border-purple-700/30 text-xs text-purple-300 flex items-start gap-2">
              <i data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
              <span>El orden aquí se refleja directamente en el sitio web. Las secciones ocultas no son visibles para los visitantes pero conservan su contenido.</span>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: IDENTIDAD & MARCA -->
        <div id="tab-brand" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="palette" class="w-4 h-4 text-emerald-400"></i>
              Identidad de Marca & Tema
            </h2>
            <p class="text-xs text-gray-400 mb-6">Nombre del evento infantil y paleta de colores vibrantes.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Nombre del Evento</label>
                <input type="text" id="input-brandName" value="<%= content.brand?.name || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Texto del Logo</label>
                <input type="text" id="input-logoText" value="<%= content.brand?.logoText || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Lema / Subtítulo Oficial</label>
                <input type="text" id="input-brandTagline" value="<%= content.brand?.tagline || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Logo Oficial (Reemplaza el icono y diseño por defecto)</label>
                <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                  <div class="w-16 h-16 rounded-2xl bg-gray-900 border border-gray-800 flex items-center justify-center overflow-hidden flex-shrink-0 p-1" id="preview-logo-box">
                    <% if (content.brand?.logoUrl) { %>
                      <img src="<%= content.brand.logoUrl %>" alt="Logo" class="max-w-full max-h-full object-contain rounded-xl">
                    <% } else { %>
                      <i data-lucide="<%= content.brand?.logoIcon || 'trophy' %>" class="w-6 h-6 text-yellow-400"></i>
                    <% } %>
                  </div>
                  <div class="flex-1 w-full space-y-2">
                    <div class="flex gap-2">
                      <input type="text" id="input-logoUrl" value="<%= content.brand?.logoUrl || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white focus:outline-none focus:border-emerald-400" placeholder="/uploads/mi-logo.webp o URL externa">
                      <label class="cursor-pointer bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-3.5 py-2 rounded-2xl flex items-center gap-1.5 whitespace-nowrap transition-all shadow-md shadow-blue-600/30" title="Subir logo personalizado">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        <span>Subir Logo</span>
                        <input type="file" class="hidden file-uploader-input" data-target-input="#input-logoUrl" data-preview-box="#preview-logo-box" data-upload-type="logo" accept="image/*">
                      </label>
                      <button type="button" id="btn-remove-logo" class="px-3 py-2 bg-slate-800 hover:bg-red-950/50 text-slate-300 hover:text-red-400 border border-slate-700 hover:border-red-500/50 rounded-2xl text-xs font-bold transition-all flex items-center gap-1" title="Quitar logo y volver al por defecto">
                        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">Restablecer</span>
                      </button>
                    </div>
                    <p class="text-[11px] text-gray-400">Al subir un logo aquí, se reemplaza de inmediato el icono/logo por defecto en la portada, footer y pantallas del sistema.</p>
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Icono del Logo (Lucide - si no hay imagen)</label>
                <input type="text" id="input-logoIcon" value="<%= content.brand?.logoIcon || 'trophy' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Modo Visual Predeterminado de la Web</label>
                <select id="input-themeMode" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                  <option value="light" <%= (content.brand?.themeMode !== 'dark') ? 'selected' : '' %>>☀️ Modo Claro (White Mode)</option>
                  <option value="dark" <%= (content.brand?.themeMode === 'dark') ? 'selected' : '' %>>🌙 Modo Oscuro (Dark Mode)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Paleta de Color de Acento</label>
                <input type="hidden" id="input-accentColor" value="<%= content.brand?.accentColor || 'green_yellow' %>">
                <div class="flex items-center gap-2 pt-1">
                  <% Object.entries(themes).forEach(([key, thm]) => { %>
                  <button type="button" class="color-choice-btn w-8 h-8 rounded-full border border-white/20 transition-transform <%= content.brand?.accentColor === key ? 'ring-4 ring-white/40 scale-110' : '' %>" data-color="<%= key %>" style="background-color: <%= thm.primaryHex %>;" title="<%= thm.name %>"></button>
                  <% }); %>
                </div>
              </div>
            </div>

            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3 pt-4 border-t border-gray-800">Redes Sociales Oficiales</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-gray-400 mb-1">Instagram URL</label>
                <input type="text" id="input-socialInstagram" value="<%= content.footer?.socialLinks?.instagram || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">Facebook URL</label>
                <input type="text" id="input-socialFacebook" value="<%= content.footer?.socialLinks?.facebook || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">Twitter / X URL</label>
                <input type="text" id="input-socialTwitter" value="<%= content.footer?.socialLinks?.twitter || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1">YouTube URL</label>
                <input type="text" id="input-socialYoutube" value="<%= content.footer?.socialLinks?.youtube || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-3 py-2 text-xs text-white">
              </div>
            </div>
          </div>
          <!-- Card: Pestaña del Navegador & Favicon -->
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-5">
            <div>
              <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
                <i data-lucide="globe" class="w-4 h-4 text-blue-400"></i>
                Pestaña del Navegador & Favicon (Browser Tab)
              </h2>
              <p class="text-xs text-gray-400">Personaliza el texto que aparece en la pestaña superior del navegador (Chrome, Safari, Edge) y el logo o icono que lo acompaña.</p>
            </div>

            <!-- Maqueta visual en vivo de la pestaña de Chrome -->
            <div class="p-4 rounded-2xl bg-gray-950/90 border border-gray-800 space-y-2">
              <div class="flex items-center justify-between text-[11px] font-bold text-gray-400 uppercase tracking-wider">
                <span class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Vista Previa en Vivo (Pestaña del Navegador)
                </span>
                <span class="text-[10px] text-gray-500 font-normal">Actualización instantánea</span>
              </div>

              <!-- Chrome Tab Bar Mockup -->
              <div class="w-full max-w-lg bg-slate-900 border border-slate-700/60 rounded-t-xl p-1.5 pt-2 flex items-center gap-2 shadow-lg">
                <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-800 rounded-lg border border-slate-700/80 max-w-full flex-1 min-w-0">
                  <img id="preview-tab-favicon" src="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>" alt="Favicon" class="w-4 h-4 rounded-sm object-contain flex-shrink-0">
                  <span id="preview-tab-title" class="text-xs font-semibold text-slate-100 truncate flex-1">
                    <%= content.seo?.metaTitle || 'KidsRun 2026 | La Gran Corrida Infantil y Familiar' %>
                  </span>
                  <span class="text-slate-400 hover:text-white text-xs px-1 cursor-default font-mono">×</span>
                </div>
                <div class="text-slate-500 text-xs px-1 font-bold select-none">+</div>
              </div>
            </div>

            <!-- Campos editables -->
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5 flex items-center justify-between">
                  <span>Texto de la Pestaña del Navegador (&lt;title&gt;)</span>
                  <span class="text-[10px] text-gray-500 font-normal">ej: KidsRun 2026 | La Gran Corrida Infantil y Familiar</span>
                </label>
                <input type="text" id="input-tabTitle" value="<%= content.seo?.metaTitle || 'KidsRun 2026 | La Gran Corrida Infantil y Familiar' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-400 font-medium">
                <p class="text-[11px] text-gray-500 mt-1">Este texto aparece en la barra superior de Google Chrome / Safari y es el título principal indexado por Google.</p>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5 flex items-center justify-between">
                  <span>Logo / Favicon de la Pestaña</span>
                  <span class="text-[10px] text-gray-500 font-normal">PNG, WebP, SVG o JPG (cuadrado / 32x32 / 64x64)</span>
                </label>
                <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                  <div class="w-12 h-12 rounded-xl bg-gray-900 border border-gray-800 flex items-center justify-center overflow-hidden flex-shrink-0 p-1" id="preview-favicon-box">
                    <img id="preview-favicon-img" src="<%= content.brand?.faviconUrl || content.brand?.logoUrl || '/images/default-favicon.svg' %>" alt="Favicon" class="max-w-full max-h-full object-contain rounded-lg">
                  </div>
                  <div class="flex-1 w-full space-y-2">
                    <div class="flex gap-2">
                      <input type="text" id="input-faviconUrl" value="<%= content.brand?.faviconUrl || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white focus:outline-none focus:border-blue-400" placeholder="/uploads/mi-favicon.webp o URL externa">
                      <label class="cursor-pointer bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-3.5 py-2 rounded-2xl flex items-center gap-1.5 whitespace-nowrap transition-all shadow-md shadow-blue-600/30" title="Subir logo o favicon para la pestaña">
                        <i data-lucide="upload" class="w-4 h-4"></i>
                        <span>Subir Favicon</span>
                        <input type="file" class="hidden file-uploader-input" data-target-input="#input-faviconUrl" data-preview-box="#preview-favicon-box" data-upload-type="favicon" accept="image/*">
                      </label>
                      <button type="button" id="btn-remove-favicon" class="px-3 py-2 bg-slate-800 hover:bg-red-950/50 text-slate-300 hover:text-red-400 border border-slate-700 hover:border-red-500/50 rounded-2xl text-xs font-bold transition-all flex items-center gap-1" title="Restablecer al logo predeterminado">
                        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">Restablecer</span>
                      </button>
                    </div>
                    <p class="text-[11px] text-gray-400">Si no configuras un favicon específico, se usará automáticamente el logo oficial del evento o el icono deportivo por defecto.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: HERO -->
        <div id="tab-hero" class="tab-pane hidden space-y-6">
          <!-- Vista Previa Visual en Vivo del Hero -->
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 bg-gradient-to-b from-blue-950/20 via-gray-900/40 to-transparent relative overflow-hidden">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] font-bold text-gray-400 uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Vista Previa en Vivo (Portada de Inicio)
              </span>
              <span class="text-[10px] text-gray-500 bg-gray-800/80 px-2 py-0.5 rounded-full">Actualización instantánea</span>
            </div>

            <div class="text-center py-6 px-4 rounded-2xl bg-gray-950/80 border border-gray-800/80 shadow-2xl relative">
              <!-- Badge -->
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/10 border border-blue-500/20 text-blue-300 mb-4">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                <span id="hero-preview-badge"><%= content.hero?.badgeText || '👟 ¡INSCRIPCIONES ABIERTAS EDICIÓN 2026!' %></span>
              </div>

              <!-- Título Dinámico -->
              <h1 class="text-xl sm:text-3xl font-black text-white leading-tight mb-3">
                <span id="hero-preview-prefix"><%= content.hero?.headlinePrefix || 'La Carrera Más Alegre del Año para' %></span>
                <br>
                <span id="hero-preview-gradient" class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-300 font-extrabold">
                  <%= content.hero?.headlineGradient || 'Pequeños Campeones & Familias' %>
                </span>
              </h1>

              <!-- Subtítulo -->
              <p id="hero-preview-subheadline" class="text-xs sm:text-sm text-gray-300 max-w-xl mx-auto leading-relaxed mb-4">
                <%= content.hero?.subheadline || 'Un día inolvidable de deporte, risas y diversión en un circuito 100% cerrado y seguro.' %>
              </p>

              <!-- Aviso -->
              <div class="text-[11px] text-amber-300/90 font-medium">
                <span id="hero-preview-notice"><%= content.hero?.statsNotice || '🏅 Medalla finisher garantizada para todos los niños' %></span>
              </div>
            </div>
          </div>

          <!-- Formulario: Textos y Botones de Cabecera -->
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="sparkles" class="w-4 h-4 text-emerald-400"></i>
              Textos de la Portada Principal (Hero)
            </h2>
            <p class="text-xs text-gray-400 mb-6">El título, mensajes de bienvenida y botones de llamado a la acción.</p>

            <div class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Texto del Badge Superior</label>
                  <input type="text" id="input-badgeText" value="<%= content.hero?.badgeText || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Enlace del Badge</label>
                  <input type="text" id="input-badgeLink" value="<%= content.hero?.badgeLink || '#pricing' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5 flex items-center justify-between">
                  <span>Título Principal - Línea 1 (Texto Blanco)</span>
                  <span class="text-[10px] text-gray-500 font-normal">ej: La Carrera Más Alegre del Año para</span>
                </label>
                <input type="text" id="input-headlinePrefix" value="<%= content.hero?.headlinePrefix || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400 font-semibold">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5 flex items-center justify-between">
                  <span>Título Principal - Línea 2 con Gradiente</span>
                  <span class="text-[10px] text-amber-400/80 font-normal">ej: Pequeños Campeones & Familias</span>
                </label>
                <input type="text" id="input-headlineGradient" value="<%= content.hero?.headlineGradient || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400 font-bold text-amber-300">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Subtítulo Descriptivo</label>
                <textarea id="input-subheadline" rows="3" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400 leading-relaxed"><%= content.hero?.subheadline || '' %></textarea>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Texto Botón Primario</label>
                  <input type="text" id="input-primaryCtaText" value="<%= content.hero?.primaryCtaText || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Enlace Botón Primario</label>
                  <input type="text" id="input-primaryCtaLink" value="<%= content.hero?.primaryCtaLink || '#contact' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Texto Botón Secundario</label>
                  <input type="text" id="input-secondaryCtaText" value="<%= content.hero?.secondaryCtaText || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Enlace Botón Secundario</label>
                  <input type="text" id="input-secondaryCtaLink" value="<%= content.hero?.secondaryCtaLink || '#gallery' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Mensaje de Garantía / Aviso Inferior</label>
                <input type="text" id="input-statsNotice" value="<%= content.hero?.statsNotice || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>
            </div>
          </div>

          <!-- Formulario: Cifras y Métricas de Impacto -->
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div>
                <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
                  <i data-lucide="award" class="w-4 h-4 text-amber-400"></i>
                  Cifras y Métricas de Impacto (Barra de Estadísticas)
                </h2>
                <p class="text-xs text-gray-400">
                  Cifras destacadas que aparecen horizontalmente en la web justo debajo de la portada (ej: +2,500 Niños y Familias Corriendo, 100% Medallas Aseguradas, etc.).
                </p>
              </div>
              <button type="button" id="btn-add-metric" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs rounded-2xl shadow-lg shadow-amber-500/20 flex items-center gap-2 transition-all self-start sm:self-auto cursor-pointer">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>+ Agregar Métrica</span>
              </button>
            </div>

            <!-- Contenedor dinámico de Métricas -->
            <div id="metrics-container" class="space-y-3">
              <% const metricList = Array.isArray(content.metrics) && content.metrics.length > 0 ? content.metrics : [
                { value: '+2,500', label: 'Niños y Familias Corriendo', icon: 'users' },
                { value: '100%', label: 'Medallas Finisher Aseguradas', icon: 'award' },
                { value: '4', label: 'Circuitos por Edades (500m - 3K)', icon: 'flag' },
                { value: '0', label: 'Incidentes • Seguridad Máxima', icon: 'shield-check' }
              ]; %>
              <% metricList.forEach((metric, idx) => { %>
              <div class="metric-admin-item p-4 rounded-3xl bg-gray-900/80 border border-gray-800 relative space-y-3">
                <div class="flex items-center justify-between pb-2 border-b border-gray-800/80">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 metric-icon-preview">
                      <i data-lucide="<%= metric.icon || 'award' %>" class="w-4 h-4"></i>
                    </div>
                    <span class="text-xs font-bold text-gray-300">Métrica #<%= idx + 1 %></span>
                  </div>
                  <button type="button" class="btn-delete-item text-red-400 hover:text-red-300 p-1.5 bg-red-950/40 rounded-xl transition-all" title="Eliminar Métrica">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                  <div class="sm:col-span-4">
                    <label class="block text-[11px] font-semibold text-gray-400 mb-1">Cifra / Valor</label>
                    <input type="text" value="<%= metric.value %>" placeholder="+2,500" class="metric-value-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white font-black tracking-wide focus:outline-none focus:border-amber-400">
                  </div>
                  <div class="sm:col-span-5">
                    <label class="block text-[11px] font-semibold text-gray-400 mb-1">Etiqueta / Descripción</label>
                    <input type="text" value="<%= metric.label %>" placeholder="Niños y Familias Corriendo" class="metric-label-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
                  </div>
                  <div class="sm:col-span-3">
                    <label class="block text-[11px] font-semibold text-gray-400 mb-1">Ícono</label>
                    <select class="metric-icon-select w-full bg-gray-950 border border-gray-800 rounded-xl px-2.5 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
                      <% const availIcons = [
                        { id: 'users', label: 'users (Familias / Niños)' },
                        { id: 'award', label: 'award (Medalla)' },
                        { id: 'flag', label: 'flag (Circuitos)' },
                        { id: 'shield-check', label: 'shield-check (Seguridad)' },
                        { id: 'trophy', label: 'trophy (Trofeo)' },
                        { id: 'heart', label: 'heart (Corazón / Salud)' },
                        { id: 'smile', label: 'smile (Alegría)' },
                        { id: 'sparkles', label: 'sparkles (Magia)' },
                        { id: 'zap', label: 'zap (Energía)' },
                        { id: 'star', label: 'star (Estrella)' },
                        { id: 'clock', label: 'clock (Tiempo)' },
                        { id: 'map-pin', label: 'map-pin (Ubicación)' },
                        { id: 'activity', label: 'activity (Deporte)' }
                      ]; %>
                      <% availIcons.forEach(ico => { %>
                      <option value="<%= ico.id %>" <%= (metric.icon === ico.id) ? 'selected' : '' %>><%= ico.label %></option>
                      <% }); %>
                    </select>
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: CIRCUITOS Y EDADES -->
        <div id="tab-circuits" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-6">

            <!-- Encabezado con botón Agregar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-gray-800">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                  <i data-lucide="flag" class="w-5 h-5 text-emerald-400"></i>
                  Circuitos y Categorías por Edades
                </h2>
                <p class="text-xs text-gray-400 mt-1">Define las distancias, rangos de edad y descripciones de cada circuito. Puedes agregar, eliminar y reordenar.</p>
              </div>
              <button type="button" id="btn-add-circuit"
                class="shrink-0 px-4 py-2.5 rounded-2xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-600/20 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Agregar Circuito</span>
              </button>
            </div>

            <!-- Lista de circuitos -->
            <div id="circuits-admin-container" class="space-y-4">
              <% (content.categories || []).forEach((cat, idx) => { %>
              <div class="circuit-admin-item p-4 sm:p-5 rounded-2xl bg-gray-900/60 border border-gray-800 space-y-3 group hover:border-gray-700 transition-all">
                <input type="hidden" class="circuit-id-input" value="<%= cat.id || ('cat-' + (idx+1)) %>">

                <!-- Cabecera del item -->
                <div class="flex items-center justify-between gap-3 pb-2 border-b border-gray-800/80">
                  <div class="flex items-center gap-2">
                    <span class="circuit-item-number w-6 h-6 rounded-lg bg-emerald-600/20 text-emerald-400 font-mono text-xs font-bold flex items-center justify-center"><%= idx + 1 %></span>
                    <span class="text-xs font-bold text-slate-300">Circuito #<span class="circuit-item-num-text"><%= idx + 1 %></span></span>
                    <span class="text-xs text-slate-500 font-medium truncate max-w-[140px]"><%= cat.distance %> &bull; <%= cat.badge %></span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="btn-move-up-circuit p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all cursor-pointer" title="Mover arriba">
                      <i data-lucide="arrow-up" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" class="btn-move-down-circuit p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all cursor-pointer" title="Mover abajo">
                      <i data-lucide="arrow-down" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" class="btn-remove-circuit p-1.5 rounded-lg bg-red-950/60 hover:bg-red-900 border border-red-500/30 text-red-300 transition-all ml-1 cursor-pointer" title="Eliminar circuito">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </div>

                <!-- Campos del circuito -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Distancia (ej: 500 Metros)</label>
                    <input type="text" class="circuit-distance w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white font-bold focus:outline-none focus:border-emerald-500" value="<%= cat.distance %>" placeholder="1 Km">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Rango de Edad</label>
                    <input type="text" class="circuit-badge w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" value="<%= cat.badge %>" placeholder="6 a 8 años">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Nombre Categoría</label>
                    <input type="text" class="circuit-title w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500" value="<%= cat.title %>" placeholder="Pequeños Rayos">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Icono Lucide</label>
                    <input type="text" class="circuit-icon w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-emerald-500" value="<%= cat.icon || 'flag' %>" placeholder="flag">
                  </div>
                </div>
                <div>
                  <label class="block text-xs text-gray-400 mb-1">Descripción del Circuito</label>
                  <textarea class="circuit-description w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500" rows="2" placeholder="Describe el circuito, condiciones y características..."><%= cat.description %></textarea>
                </div>
              </div>
              <% }); %>
            </div>

            <!-- Estado vacío -->
            <div id="circuits-empty-state" class="<%= (!content.categories || content.categories.length === 0) ? '' : 'hidden' %> text-center py-10 bg-slate-950/40 rounded-2xl border border-slate-800 text-slate-400 space-y-2">
              <i data-lucide="flag-off" class="w-8 h-8 mx-auto text-slate-600"></i>
              <p class="text-sm font-bold text-slate-300">No hay circuitos definidos</p>
              <p class="text-xs text-slate-500">Haz clic en &ldquo;Agregar Circuito&rdquo; para crear el primero.</p>
            </div>

            <!-- Acciones al pie -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-gray-800">
              <button type="button" id="btn-add-circuit-bottom"
                class="w-full sm:w-auto px-4 py-2.5 rounded-2xl text-xs font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Agregar otro circuito</span>
              </button>
              <button type="button" id="btn-save-circuits"
                class="w-full sm:w-auto px-6 py-2.5 rounded-2xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-600/30 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>Guardar Circuitos</span>
              </button>
            </div>

          </div>
        </div>

        <!-- PESTAÑA: CRONOGRAMA DE ACTIVIDADES (SOLO ADMINISTRADOR) -->
        <div id="tab-schedule" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-6">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-gray-800">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                  <i data-lucide="calendar-clock" class="w-5 h-5 text-amber-400"></i>
                  <span>Cronograma y Horarios de la Gran Jornada</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1">
                  Define las actividades, largadas, calentamientos y shows de la jornada con sus respectivos horarios y descripciones.
                </p>
              </div>

              <div class="flex items-center gap-2">
                <button type="button" id="btn-add-schedule-item" class="px-4 py-2.5 rounded-2xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/20 active:scale-95 transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer">
                  <i data-lucide="plus-circle" class="w-4 h-4"></i>
                  <span>Agregar Actividad</span>
                </button>
              </div>
            </div>

            <!-- Encabezado de la Sección de Cronograma -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-2xl bg-gray-900/50 border border-gray-800">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Etiqueta Superior (Badge)</label>
                <input type="text" id="input-scheduleBadge" value="<%= content.scheduleSection?.badge || 'HORARIOS Y ACTIVIDADES' %>" class="w-full bg-gray-950 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white" placeholder="HORARIOS Y ACTIVIDADES">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Título Principal</label>
                <input type="text" id="input-scheduleTitle" value="<%= content.scheduleSection?.title || 'Cronograma de la Gran Jornada' %>" class="w-full bg-gray-950 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white" placeholder="Cronograma de la Gran Jornada">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Bajada / Subtítulo</label>
                <input type="text" id="input-scheduleSubtitle" value="<%= content.scheduleSection?.subtitle || 'Ven temprano para disfrutar de todas las sorpresas preparadas para la familia.' %>" class="w-full bg-gray-950 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white" placeholder="Ven temprano para disfrutar...">
              </div>
            </div>

            <!-- Lista de Actividades del Cronograma -->
            <div id="schedule-admin-container" class="space-y-4">
              <% (content.schedule || []).forEach((item, idx) => { %>
              <div class="schedule-admin-item p-4 sm:p-5 rounded-2xl bg-gray-900/60 border border-gray-800 space-y-3 group hover:border-gray-700 transition-all">
                <div class="flex items-center justify-between gap-3 pb-2 border-b border-gray-800/80">
                  <div class="flex items-center gap-2">
                    <span class="schedule-item-number w-6 h-6 rounded-lg bg-blue-600/20 text-blue-400 font-mono text-xs font-bold flex items-center justify-center">
                      <%= idx + 1 %>
                    </span>
                    <span class="text-xs font-bold text-slate-300">Actividad #<span class="schedule-item-num-text"><%= idx + 1 %></span></span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="btn-move-up-schedule p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all cursor-pointer" title="Mover arriba">
                      <i data-lucide="arrow-up" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" class="btn-move-down-schedule p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all cursor-pointer" title="Mover abajo">
                      <i data-lucide="arrow-down" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" class="btn-remove-schedule p-1.5 rounded-lg bg-red-950/60 hover:bg-red-900 border border-red-500/30 text-red-300 transition-all ml-1 cursor-pointer" title="Quitar actividad">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Horario / Hora (ej: 08:30 AM)</label>
                    <input type="text" name="schedule[<%= idx %>][time]" value="<%= item.time %>" placeholder="08:30 AM" class="schedule-time-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white font-mono font-bold focus:outline-none focus:border-blue-500">
                  </div>
                  <div class="sm:col-span-2">
                    <label class="block text-xs text-gray-400 mb-1">Nombre / Título de la Actividad</label>
                    <input type="text" name="schedule[<%= idx %>][title]" value="<%= item.title %>" placeholder="Ej: Largada Mini Runners 500m" class="schedule-title-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white font-bold focus:outline-none focus:border-blue-500">
                  </div>
                </div>

                <div>
                  <label class="block text-xs text-gray-400 mb-1">Descripción / Detalles para los Asistentes</label>
                  <textarea name="schedule[<%= idx %>][desc]" rows="2" placeholder="Detalles de la actividad, quiénes participan, recomendaciones..." class="schedule-desc-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500"><%= item.desc %></textarea>
                </div>
              </div>
              <% }); %>
            </div>

            <!-- Estado Vacío cuando no hay actividades -->
            <div id="schedule-empty-state" class="<%= (!content.schedule || content.schedule.length === 0) ? '' : 'hidden' %> text-center py-10 bg-slate-950/40 rounded-2xl border border-slate-800 text-slate-400 space-y-2">
              <i data-lucide="calendar-x" class="w-8 h-8 mx-auto text-slate-600"></i>
              <p class="text-sm font-bold text-slate-300">No hay actividades en el cronograma</p>
              <p class="text-xs text-slate-500">Haz clic en "Agregar Actividad" para comenzar a planificar la jornada.</p>
            </div>

            <!-- Botones de Acción al pie de Cronograma -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-gray-800">
              <button type="button" id="btn-add-schedule-item-bottom" class="w-full sm:w-auto px-4 py-2.5 rounded-2xl text-xs font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Agregar otra actividad</span>
              </button>

              <button type="button" id="btn-save-schedule-section" class="w-full sm:w-auto px-6 py-2.5 rounded-2xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>Guardar Cronograma</span>
              </button>
            </div>

          </div>
        </div>

        <!-- PESTAÑA: KITS Y PRECIOS -->
        <div id="tab-kits" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="tag" class="w-4 h-4 text-emerald-400"></i>
              Kits de Inscripción y Valores
            </h2>
            <p class="text-xs text-gray-400 mb-6">Gestiona los kits con sus poleras oficiales, medallas y beneficios.</p>

            <div class="space-y-6">
              <% (content.pricing?.plans || []).forEach((plan, idx) => { %>
              <div class="pricing-item p-5 rounded-3xl bg-gray-900/70 border <%= plan.isPopular ? 'border-yellow-400/70' : 'border-gray-800' %> space-y-4">
                <input type="hidden" name="plans[<%= idx %>][id]" value="<%= plan.id %>">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Nombre del Kit</label>
                    <input type="text" name="plans[<%= idx %>][name]" value="<%= plan.name %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white font-bold">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Valor Mensual ($)</label>
                    <input type="number" name="plans[<%= idx %>][priceMonthly]" value="<%= plan.priceMonthly %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Valor Anual ($)</label>
                    <input type="number" name="plans[<%= idx %>][priceYearly]" value="<%= plan.priceYearly || plan.priceMonthly %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Badge de Tarjeta</label>
                    <input type="text" name="plans[<%= idx %>][badge]" value="<%= plan.badge || '' %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <input type="checkbox" id="popular-<%= idx %>" name="plans[<%= idx %>][isPopular]" <%= plan.isPopular ? 'checked' : '' %> class="w-4 h-4 rounded text-yellow-500 focus:ring-emerald-400 bg-gray-950 border-gray-800">
                  <label for="popular-<%= idx %>" class="text-xs font-semibold text-yellow-300">Marcar como Kit "Más Elegido" (con halo dorado)</label>
                </div>

                <div>
                  <label class="block text-xs text-gray-400 mb-1">Elementos Incluidos en el Kit (Uno por línea)</label>
                  <textarea name="plans[<%= idx %>][features]" rows="4" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white font-mono leading-relaxed"><%= (plan.features || []).join('\n') %></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Texto del Botón</label>
                    <input type="text" name="plans[<%= idx %>][ctaText]" value="<%= plan.ctaText || 'Inscribir Ahora' %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Enlace de Destino</label>
                    <input type="text" name="plans[<%= idx %>][ctaLink]" value="<%= plan.ctaLink || '#contact' %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white">
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: TESTIMONIOS -->
        <div id="tab-testimonials" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="message-square" class="w-4 h-4 text-emerald-400"></i>
              Testimonios de Familias
            </h2>
            <p class="text-xs text-gray-400 mb-6">Opiniones de padres y tutores de carreras anteriores.</p>

            <div id="testimonials-container" class="space-y-4">
              <% (content.testimonials || []).forEach((testi, idx) => { %>
              <div class="testimonial-item p-4 rounded-3xl bg-gray-900/60 border border-gray-800 relative">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Nombre Familia / Papá</label>
                    <input type="text" name="testimonials[<%= idx %>][name]" value="<%= testi.name %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Rol / Categoría</label>
                    <input type="text" name="testimonials[<%= idx %>][role]" value="<%= testi.role %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Estrellas</label>
                    <input type="number" name="testimonials[<%= idx %>][stars]" value="<%= testi.stars || 5 %>" min="1" max="5" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                </div>
                <div class="mb-3">
                  <label class="block text-xs text-gray-400 mb-1">URL Avatar / Foto</label>
                  <input type="text" name="testimonials[<%= idx %>][avatar]" value="<%= testi.avatar %>" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                </div>
                <div>
                  <label class="block text-xs text-gray-400 mb-1">Testimonio</label>
                  <textarea name="testimonials[<%= idx %>][quote]" rows="2" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white"><%= testi.quote %></textarea>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: FAQS -->
        <div id="tab-faqs" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-gray-800">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-white mb-1 flex items-center gap-2">
                  <i data-lucide="help-circle" class="w-5 h-5 text-emerald-400"></i>
                  Preguntas Frecuentes para Padres (FAQs)
                </h2>
                <p class="text-xs text-gray-400">Responde dudas de seguridad, retiro de kits, horarios y medallas.</p>
              </div>

              <button type="button" id="btn-add-faq" class="px-4 py-2.5 rounded-2xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 active:scale-95 transition-all flex items-center gap-2 self-start sm:self-auto cursor-pointer">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Agregar Pregunta</span>
              </button>
            </div>

            <div id="faqs-container" class="space-y-4">
              <% (content.faqs || []).forEach((faq, idx) => { %>
              <div class="faq-admin-item p-4 sm:p-5 rounded-3xl bg-gray-900/60 border border-gray-800 space-y-3 hover:border-gray-700 transition-all">
                <div class="flex items-center justify-between pb-2 border-b border-gray-800/80">
                  <div class="flex items-center gap-2">
                    <span class="faq-item-number w-6 h-6 rounded-lg bg-emerald-600/20 text-emerald-400 font-mono text-xs font-bold flex items-center justify-center">
                      <%= idx + 1 %>
                    </span>
                    <span class="text-xs font-bold text-slate-300">Pregunta #<span class="faq-item-num-text"><%= idx + 1 %></span></span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <button type="button" class="btn-move-up-faq p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all cursor-pointer" title="Mover arriba">
                      <i data-lucide="arrow-up" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" class="btn-move-down-faq p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all cursor-pointer" title="Mover abajo">
                      <i data-lucide="arrow-down" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" class="btn-remove-faq p-1.5 rounded-lg bg-red-950/60 hover:bg-red-900 border border-red-500/30 text-red-300 transition-all ml-1 cursor-pointer" title="Eliminar pregunta">
                      <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                  </div>
                </div>

                <div>
                  <label class="block text-xs text-gray-400 mb-1 font-semibold">Pregunta *</label>
                  <input type="text" name="faqs[<%= idx %>][question]" value="<%= faq.question %>" placeholder="Ej: ¿Qué incluye el kit de corredor?" class="faq-question-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-sm text-white font-bold focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                  <label class="block text-xs text-gray-400 mb-1 font-semibold">Respuesta *</label>
                  <textarea name="faqs[<%= idx %>][answer]" rows="2" placeholder="Detalle claro y tranquilizador para los padres..." class="faq-answer-input w-full bg-gray-950 border border-gray-800 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none focus:border-emerald-500"><%= faq.answer %></textarea>
                </div>
              </div>
              <% }); %>
            </div>

            <!-- Estado Vacío cuando no hay preguntas -->
            <div id="faqs-empty-state" class="<%= (!content.faqs || content.faqs.length === 0) ? '' : 'hidden' %> text-center py-10 bg-slate-950/40 rounded-2xl border border-slate-800 text-slate-400 space-y-2">
              <i data-lucide="help-circle" class="w-8 h-8 mx-auto text-slate-600"></i>
              <p class="text-sm font-bold text-slate-300">No hay preguntas frecuentes registradas</p>
              <p class="text-xs text-slate-500">Haz clic en "Agregar Pregunta" para informar a los apoderados.</p>
            </div>

            <!-- Botones de Acción al pie de FAQs -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-gray-800">
              <button type="button" id="btn-add-faq-bottom" class="w-full sm:w-auto px-4 py-2.5 rounded-2xl text-xs font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Agregar otra pregunta</span>
              </button>

              <button type="button" id="btn-save-faqs-section" class="w-full sm:w-auto px-6 py-2.5 rounded-2xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>Guardar Preguntas Frecuentes</span>
              </button>
            </div>

          </div>
        </div>

        <!-- PESTAÑA: AUSPICIADORES -->
        <div id="tab-sponsors" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
              <div>
                <h2 class="text-lg font-black text-white flex items-center gap-2">
                  <i data-lucide="building-2" class="w-5 h-5 text-yellow-400"></i>
                  Auspiciadores
                </h2>
                <p class="text-xs text-gray-400 mt-0.5">Los logos se optimizan automáticamente a 320×160 px con fondo transparente para que todos se vean uniformes en el carrusel.</p>
              </div>
              <button type="button" id="btn-add-sponsor" class="px-4 py-2.5 rounded-2xl text-xs font-bold text-white bg-yellow-600 hover:bg-yellow-500 shadow-lg shadow-yellow-600/20 transition-all flex items-center gap-2 whitespace-nowrap">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Agregar Auspiciador</span>
              </button>
            </div>

            <!-- Encabezado de sección -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 p-4 rounded-2xl bg-gray-900/50 border border-gray-800">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Badge</label>
                <input type="text" id="input-sponsorsBadge" value="<%= content.sponsors?.badge || 'Nuestros Auspiciadores' %>" class="w-full bg-gray-950 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Título</label>
                <input type="text" id="input-sponsorsTitle" value="<%= content.sponsors?.title || 'Ellos hacen posible la carrera' %>" class="w-full bg-gray-950 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Descripción</label>
                <input type="text" id="input-sponsorsDescription" value="<%= content.sponsors?.description || '' %>" class="w-full bg-gray-950 border border-gray-800 rounded-2xl px-4 py-2.5 text-sm text-white">
              </div>
            </div>

            <!-- Lista de auspiciadores -->
            <div id="sponsors-admin-container" class="space-y-4">
              <% (content.sponsors?.list || []).forEach((sp, idx) => { %>
              <div class="sponsor-admin-item flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 rounded-2xl bg-gray-900/60 border border-gray-800 group">
                <!-- Preview logo -->
                <div class="relative shrink-0">
                  <div class="sponsor-preview-box w-32 h-16 rounded-xl bg-white/5 border border-gray-700 flex items-center justify-center overflow-hidden">
                    <% if (sp.logoUrl) { %>
                    <img src="<%= sp.logoUrl %>" alt="<%= sp.name %>" class="max-w-full max-h-full object-contain">
                    <% } else { %>
                    <i data-lucide="image" class="w-6 h-6 text-gray-600"></i>
                    <% } %>
                  </div>
                  <input type="hidden" name="sponsors[<%= idx %>][logoUrl]" value="<%= sp.logoUrl || '' %>" class="sponsor-logo-url-input">
                </div>
                <!-- Fields -->
                <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Nombre</label>
                    <input type="text" name="sponsors[<%= idx %>][name]" value="<%= sp.name || '' %>" placeholder="Empresa..." class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Nivel</label>
                    <select name="sponsors[<%= idx %>][tier]" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                      <option value="gold" <%= sp.tier==='gold' ? 'selected' : '' %>>Gold</option>
                      <option value="silver" <%= sp.tier==='silver' ? 'selected' : '' %>>Silver</option>
                      <option value="bronze" <%= sp.tier==='bronze' ? 'selected' : '' %>>Bronze</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs text-gray-400 mb-1">Sitio Web</label>
                    <input type="text" name="sponsors[<%= idx %>][website]" value="<%= sp.website || '' %>" placeholder="https://..." class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-sm text-white">
                  </div>
                </div>
                <!-- Actions -->
                <div class="flex flex-col gap-2 shrink-0">
                  <label class="cursor-pointer bg-blue-600/80 hover:bg-blue-600 text-white text-xs font-bold px-3 py-2 rounded-xl flex items-center gap-1.5 transition-all">
                    <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                    <span>Logo</span>
                    <input type="file" class="hidden file-uploader-input" data-target-input=".sponsor-logo-url-input" data-preview-box=".sponsor-preview-box" data-upload-type="sponsor" accept="image/*">
                  </label>
                  <button type="button" class="btn-remove-sponsor bg-red-900/50 hover:bg-red-800/60 text-red-400 text-xs font-bold px-3 py-2 rounded-xl flex items-center gap-1.5 transition-all">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    <span>Quitar</span>
                  </button>
                </div>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: LUGAR DEL EVENTO -->
        <div id="tab-venue" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-lg font-black text-white flex items-center gap-2 mb-1">
              <i data-lucide="map-pin" class="w-5 h-5 text-blue-400"></i>
              Lugar del Evento
            </h2>
            <p class="text-xs text-gray-400 mb-6">Configura las coordenadas y datos del lugar. El mapa se actualiza automáticamente en la web.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Badge</label>
                <input type="text" id="input-venueBadge" value="<%= content.venue?.badge || 'Punto de Largada' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Título de sección</label>
                <input type="text" id="input-venueTitle" value="<%= content.venue?.title || '¿Dónde es la corrida?' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
            </div>

            <div class="mb-4">
              <label class="block text-xs font-semibold text-gray-300 mb-1.5">Descripción</label>
              <input type="text" id="input-venueDescription" value="<%= content.venue?.description || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Nombre del lugar</label>
                <input type="text" id="input-venueName" value="<%= content.venue?.name || content.countdown?.locationName || 'Parque Bicentenario' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Dirección completa</label>
                <input type="text" id="input-venueAddress" value="<%= content.venue?.address || '' %>" placeholder="Av. Principal 1234, Ciudad" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
            </div>

            <div class="grid grid-cols-3 gap-4 mb-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Latitud</label>
                <input type="number" step="0.000001" id="input-venueLat" value="<%= content.venue?.lat ?? -33.3975 %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white font-mono">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Longitud</label>
                <input type="number" step="0.000001" id="input-venueLng" value="<%= content.venue?.lng ?? -70.5787 %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white font-mono">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Zoom (1-18)</label>
                <input type="number" min="8" max="18" id="input-venueZoom" value="<%= content.venue?.zoom ?? 15 %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Apertura de puertas</label>
                <input type="text" id="input-venueDoorsOpen" value="<%= content.venue?.doorsOpen || '08:00 AM' %>" placeholder="08:00 AM" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Estacionamiento</label>
                <input type="text" id="input-venueParking" value="<%= content.venue?.parking || '' %>" placeholder="Info de parking..." class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Transporte público</label>
                <input type="text" id="input-venueTransit" value="<%= content.venue?.transit || '' %>" placeholder="Metro, bus..." class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>
            </div>

            <div class="mt-4 p-3 rounded-2xl bg-blue-900/20 border border-blue-700/30 text-xs text-blue-300 flex items-start gap-2">
              <i data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
              <span>Para obtener las coordenadas exactas: abre <strong>Google Maps</strong>, haz clic derecho en el lugar y copia la latitud y longitud que aparecen.</span>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: CONTACTO & ENVÍO DE CORREOS -->
        <div id="tab-contact" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="mail" class="w-4 h-4 text-emerald-400"></i>
              Configuración de Contacto y Envíos de Correo
            </h2>
            <p class="text-xs text-gray-400 mb-6">Administra los datos visibles de contacto y el correo donde deseas recibir los mensajes de la web.</p>

            <div class="space-y-4">
              <!-- Configuración de Correo de Vuelta al Usuario (Resend) -->
              <div class="p-5 rounded-3xl bg-purple-950/30 border border-purple-500/30 space-y-3">
                <div class="flex items-center gap-2 text-purple-400 font-bold text-sm">
                  <i data-lucide="send" class="w-4 h-4"></i>
                  <span>Correo de Confirmación Automático al Inscrito (Resend API)</span>
                </div>
                <p class="text-xs text-gray-300">
                  Cada vez que una familia inscriba a su hijo/a, recibirá un correo con el comprobante, nombre del pequeño corredor, distancia y detalles del kit.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-semibold text-gray-200 mb-1.5">Resend API Key</label>
                    <input type="password" id="input-contactResendApiKey" value="<%= content.contact?.resendApiKey || '' %>" placeholder="re_123456789..." class="w-full bg-gray-950 border border-purple-500/40 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-purple-400 font-mono">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-gray-200 mb-1.5">Remitente (De:)</label>
                    <input type="text" id="input-contactResendFromEmail" value="<%= content.contact?.resendFromEmail || 'KidsRun <onboarding@resend.dev>' %>" placeholder="KidsRun &lt;onboarding@resend.dev&gt;" class="w-full bg-gray-950 border border-purple-500/40 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-purple-400">
                  </div>
                </div>
                <div class="text-[11px] text-gray-400 flex items-start gap-1.5">
                  <i data-lucide="info" class="w-3.5 h-3.5 text-purple-400 shrink-0 mt-0.5"></i>
                  <span>Para obtener tu API Key gratuita: entra a <a href="https://resend.com" target="_blank" class="underline text-purple-300">resend.com</a>, crea tu cuenta gratuita y genera tu API Key en la sección "API Keys". Puedes comenzar usando el remitente de pruebas <code>onboarding@resend.dev</code>.</span>
                </div>
              </div>

              <!-- Reenvío de correos gratis con FormSubmit -->
              <div class="p-5 rounded-3xl bg-blue-950/30 border border-blue-500/30 space-y-3">
                <div class="flex items-center gap-2 text-blue-400 font-bold text-sm">
                  <i data-lucide="send" class="w-4 h-4"></i>
                  <span>Reenvío Automático de Correos (100% Gratis - FormSubmit.co)</span>
                </div>
                <p class="text-xs text-gray-300">
                  Ingresa tu correo personal o corporativo (ej. Gmail, Outlook). Cada vez que una persona llene el formulario de contacto, el sistema te enviará una notificación directa con los datos y el mensaje.
                </p>
                <div>
                  <label class="block text-xs font-semibold text-gray-200 mb-1.5">Tu correo donde quieres recibir los mensajes:</label>
                  <input type="email" id="input-contactForwardEmail" value="<%= content.contact?.forwardEmail || '' %>" placeholder="ejemplo@gmail.com" class="w-full bg-gray-950 border border-blue-500/40 rounded-2xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-400">
                </div>
                <div class="text-[11px] text-gray-400 flex items-start gap-1.5">
                  <i data-lucide="info" class="w-3.5 h-3.5 text-yellow-400 shrink-0 mt-0.5"></i>
                  <span>Nota: La primera vez que alguien te escriba, FormSubmit te enviará un correo solicitando un clic de activación (para evitar spam). Una vez activado, todos los correos llegarán de inmediato a tu bandeja.</span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Email público visible en la web</label>
                  <input type="text" id="input-contactEmail" value="<%= content.contact?.email || 'contacto@kidsrun2026.com' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Teléfono / WhatsApp público visible</label>
                  <input type="text" id="input-contactPhone" value="<%= content.contact?.phone || '+56 9 8765 4321' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Ubicación / Dirección visible</label>
                <input type="text" id="input-contactLocation" value="<%= content.contact?.location || 'Parque Bicentenario • Explanada Central' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white">
              </div>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: SEO -->
        <div id="tab-seo" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="search" class="w-4 h-4 text-emerald-400"></i>
              SEO & Google SportsEvent
            </h2>
            <p class="text-xs text-gray-400 mb-6">Optimiza la aparición de la corrida en Google, redes sociales y buscadores locales.</p>

            <div class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5 flex items-center justify-between"><span>Meta Title (Título en Pestaña del Navegador & Google)</span><span class="text-[10px] text-gray-500 font-normal">Sincronizado con Pestaña del Navegador</span></label>
                <input type="text" id="input-metaTitle" value="<%= content.seo?.metaTitle || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Meta Description</label>
                <textarea id="input-metaDescription" rows="3" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white"><%= content.seo?.metaDescription || '' %></textarea>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Palabras Clave (Keywords)</label>
                  <input type="text" id="input-keywords" value="<%= content.seo?.keywords || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">URL Canónica</label>
                  <input type="text" id="input-canonicalUrl" value="<%= content.seo?.canonicalUrl || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Imagen OpenGraph (WhatsApp, Redes)</label>
                <div class="flex gap-2">
                  <input type="text" id="input-ogImage" value="<%= content.seo?.ogImage || '' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2 text-sm text-white" placeholder="/uploads/... o URL externa">
                  <label class="cursor-pointer bg-blue-600/80 hover:bg-blue-600 text-white text-xs font-bold px-3.5 py-2 rounded-2xl flex items-center gap-1.5 whitespace-nowrap transition-all shadow-md shadow-blue-600/20">
                    <i data-lucide="upload" class="w-4 h-4"></i>
                    <span>Subir</span>
                    <input type="file" class="hidden file-uploader-input" data-target-input="#input-ogImage" data-upload-type="standard" accept="image/*">
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PESTAÑA: BASE DE DATOS DE PARTICIPANTES (ADMINISTRADOR Y EDITOR) -->
        <div id="tab-leads" class="tab-pane <%= role === 'admin' ? 'hidden' : '' %> space-y-5">
          <div class="bg-slate-900 border border-slate-800 rounded-3xl p-4 sm:p-7 shadow-xl space-y-5">
            
            <!-- Cabecera de la Base de Datos -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-800">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <div class="w-8 h-8 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center">
                    <i data-lucide="users" class="w-4 h-4"></i>
                  </div>
                  <h2 class="text-lg sm:text-xl font-black text-white">
                    Base de Participantes
                  </h2>
                  <span class="text-xs bg-blue-600 text-white font-black px-2.5 py-0.5 rounded-full" id="participants-count-badge">
                    <%= (leads || []).length %>
                  </span>
                </div>
                <p class="text-xs text-slate-400">
                  Control oficial de inscripciones, pupilos, tutores legales y comprobantes de pago.
                </p>
              </div>

              <!-- Acciones de Cabecera: Escanear Cédula + Exportar CSV + Estado DB -->
              <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="button" id="btn-open-scanner" class="flex-1 sm:flex-initial px-4 py-2.5 rounded-2xl text-xs font-black text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-lg shadow-blue-600/30 active:scale-95 transition-all flex items-center justify-center gap-2">
                  <i data-lucide="scan-line" class="w-4 h-4 text-white"></i>
                  <span>Escanear Cédula</span>
                </button>

                <a href="/admin/api/inscriptions/export" class="px-3.5 py-2.5 rounded-2xl text-xs font-bold text-slate-950 bg-amber-400 hover:bg-amber-300 shadow-md shadow-amber-400/20 active:scale-95 transition-all flex items-center justify-center gap-1.5 shrink-0" title="Descargar planilla Excel/CSV">
                  <i data-lucide="download" class="w-4 h-4"></i>
                  <span class="hidden sm:inline">Exportar CSV</span>
                </a>

                <% if (role === 'admin') { %>
                <button type="button" id="btn-trigger-bulk-delete" class="px-3.5 py-2.5 rounded-2xl text-xs font-bold text-red-300 bg-red-950/80 hover:bg-red-900 border border-red-500/40 shadow-md active:scale-95 transition-all flex items-center justify-center gap-1.5 shrink-0 cursor-pointer" title="Eliminación masiva de participantes con palabra de seguridad">
                  <i data-lucide="shield-alert" class="w-4 h-4 text-red-400"></i>
                  <span class="hidden sm:inline">Eliminación Masiva</span>
                </button>
                <% } %>

                <% if (isPostgres) { %>
                <span class="text-xs bg-emerald-950/80 text-emerald-300 font-bold px-3 py-1.5 rounded-xl border border-emerald-500/30 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>PostgreSQL</span>
                </span>
                <% } else { %>
                <span class="text-xs bg-amber-950/80 text-amber-300 font-bold px-3 py-1.5 rounded-xl border border-amber-500/30 flex items-center gap-1.5">
                  <i data-lucide="hard-drive" class="w-3.5 h-3.5"></i> Respaldo Local
                </span>
                <% } %>
              </div>
            </div>

            <!-- Barra de Herramientas: Búsqueda Inteligente y Filtros -->
            <div class="space-y-3">
              <div class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i data-lucide="search" class="w-4 h-4"></i>
                  </div>
                  <input type="text" id="filter-search-input" placeholder="Buscar por RUT o Nombre del padre/tutor, pupilo, dorsal o email..." class="admin-input w-full pl-10 pr-4 py-2.5 text-xs text-white placeholder-slate-500">
                </div>

                <!-- Filtro por Circuito -->
                <div class="sm:w-56">
                  <select id="filter-circuit-select" class="admin-input w-full py-2.5 text-xs text-white cursor-pointer">
                    <option value="all">Todos los Circuitos</option>
                    <option value="500">500 Metros (Mini Runners)</option>
                    <option value="1">1 Kilómetro (Rayos)</option>
                    <option value="2">2 Kilómetros (Campeones)</option>
                    <option value="3">3 Kilómetros (Titanes)</option>
                  </select>
                </div>
              </div>
              <p class="text-[11px] text-slate-400 flex items-center gap-1">
                <i data-lucide="info" class="w-3.5 h-3.5 text-blue-400 flex-shrink-0"></i>
                <span>Al escribir el <strong>RUT o nombre del apoderado</strong>, el filtro mostrará automáticamente a todos los pupilos asociados a esa familia.</span>
              </p>
            </div>

            <!-- VISTA MÓVIL (CARDS RESPONSIVE - MOBILE FIRST) -->
            <div class="block lg:hidden space-y-3.5" id="participants-mobile-list">
              <% if (!leads || leads.length === 0) { %>
              <div class="text-center py-12 bg-slate-950/60 rounded-3xl border border-slate-800 text-slate-400 space-y-3 p-6">
                <div class="w-14 h-14 rounded-3xl bg-blue-600/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mx-auto">
                  <i data-lucide="user-x" class="w-7 h-7"></i>
                </div>
                <p class="text-base font-bold text-white">Aún no hay inscripciones registradas</p>
                <p class="text-xs text-slate-400 max-w-xs mx-auto">Las personas que se registren en la web aparecerán aquí en tiempo real para ser acreditadas.</p>
              </div>
              <% } else { %>
                <% leads.forEach(lead => { %>
                <div class="participant-row bg-gradient-to-b from-slate-900/90 to-slate-950/90 border border-slate-800/90 hover:border-blue-500/40 rounded-3xl p-4.5 sm:p-5 space-y-3.5 transition-all shadow-lg shadow-black/20 relative overflow-hidden"
                     data-search="<%= ((lead.tutorRut || '') + ' ' + (lead.name || '') + ' ' + (lead.kidName || '') + ' ' + (lead.email || '') + ' ' + (lead.phone || '') + ' ' + (lead.emergencyContact || '') + ' ' + (lead.bibNumber || '')).toLowerCase() %>"
                     data-distance="<%= (lead.distance || '').toLowerCase() %>">
                  
                  <!-- Cabecera de la tarjeta: Dorsal + Circuito -->
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <% if (role === 'admin') { %>
                      <input type="checkbox" class="lead-select-checkbox w-4 h-4 rounded text-blue-600 bg-slate-950 border-slate-700 focus:ring-blue-500 cursor-pointer shrink-0" data-id="<%= lead.id %>" data-name="<%= lead.kidName || lead.name %>">
                      <% } %>
                      <span class="inline-flex items-center gap-1 font-mono font-black text-sm text-amber-300 bg-amber-950/80 border border-amber-500/40 px-2.5 py-1 rounded-xl shadow-sm">
                        <i data-lucide="hash" class="w-3.5 h-3.5 text-amber-400"></i>
                        <span><%= lead.bibNumber || '----' %></span>
                      </span>
                      <span class="text-[11px] font-semibold text-slate-400">Dorsal</span>
                    </div>

                    <span class="px-3 py-1 rounded-full text-xs font-black bg-blue-950/80 text-blue-300 border border-blue-500/40 flex items-center gap-1.5 shadow-sm">
                      <i data-lucide="map-pin" class="w-3 h-3 text-blue-400"></i>
                      <span><%= lead.distance || 'General' %></span>
                    </span>
                  </div>

                  <!-- Datos Destacados del Pupilo/a -->
                  <div class="bg-slate-950/60 rounded-2xl p-3.5 border border-slate-800/80 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="w-10 h-10 rounded-2xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center shrink-0">
                        <i data-lucide="smile" class="w-5 h-5"></i>
                      </div>
                      <div class="min-w-0">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Corredor/a Infantil</div>
                        <h3 class="font-black text-white text-base truncate leading-snug"><%= lead.kidName || 'Sin nombre' %></h3>
                      </div>
                    </div>
                    <% if (lead.kidAge) { %>
                    <span class="px-2.5 py-1 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold shrink-0 border border-slate-700">
                      <%= lead.kidAge %> años
                    </span>
                    <% } %>
                  </div>

                  <!-- Ficha de Datos del Apoderado / Tutor -->
                  <div class="p-3.5 rounded-2xl bg-slate-900/60 border border-slate-800/70 text-xs space-y-2">
                    <div class="flex items-start justify-between gap-2">
                      <span class="text-slate-400 font-medium text-[11px] flex items-center gap-1.5">
                        <i data-lucide="user" class="w-3.5 h-3.5 text-slate-500"></i>
                        <span>Apoderado/a:</span>
                      </span>
                      <span class="font-bold text-white text-right text-xs"><%= lead.name %></span>
                    </div>

                    <% if (lead.tutorRut) { %>
                    <div class="flex items-center justify-between gap-2 pt-1 border-t border-slate-800/50">
                      <span class="text-slate-400 font-medium text-[11px] flex items-center gap-1.5">
                        <i data-lucide="credit-card" class="w-3.5 h-3.5 text-amber-400"></i>
                        <span>Cédula / RUN:</span>
                      </span>
                      <span class="font-mono font-bold text-amber-300 bg-amber-950/40 px-2 py-0.5 rounded-lg border border-amber-500/20 text-xs">
                        <%= lead.tutorRut %>
                      </span>
                    </div>
                    <% } %>

                    <div class="flex items-center justify-between gap-2 pt-1 border-t border-slate-800/50">
                      <span class="text-slate-400 font-medium text-[11px] flex items-center gap-1.5">
                        <i data-lucide="phone" class="w-3.5 h-3.5 text-emerald-400"></i>
                        <span>Emergencia:</span>
                      </span>
                      <span class="font-mono text-slate-200 font-semibold"><%= lead.emergencyContact || lead.phone || 'No indicado' %></span>
                    </div>
                  </div>

                  <!-- Barra de Estado de Pago y Acciones -->
                  <div class="flex items-center justify-between pt-1 gap-2">
                    <div>
                      <% if (lead.paymentProof) { %>
                      <button type="button" class="btn-view-proof inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-950/90 text-emerald-300 border border-emerald-500/50 hover:bg-emerald-900 active:scale-95 transition-all text-xs font-bold shadow-sm" data-proof-url="<%= lead.paymentProof %>" data-pupil="<%= lead.kidName || 'Pupilo' %>" data-tutor="<%= lead.name || 'Tutor' %>">
                        <i data-lucide="receipt" class="w-3.5 h-3.5"></i>
                        <span>Ver Comprobante</span>
                      </button>
                      <% } else { %>
                      <span class="text-amber-400/90 bg-amber-950/40 border border-amber-500/30 px-3 py-1.5 rounded-xl text-xs font-semibold inline-flex items-center gap-1.5">
                        <i data-lucide="clock" class="w-3.5 h-3.5 text-amber-400"></i>
                        <span>Comprobante Pendiente</span>
                      </span>
                      <% } %>
                    </div>

                    <div class="flex items-center gap-1.5">
                      <% const cleanPhone = (lead.phone || lead.emergencyContact || '').replace(/[^0-9]/g, ''); %>
                      <% if (cleanPhone) { %>
                      <a href="https://wa.me/<%= cleanPhone %>" target="_blank" rel="noopener" class="px-2.5 py-1.5 text-emerald-400 hover:text-white hover:bg-emerald-950/90 border border-emerald-500/30 rounded-xl transition-all inline-flex items-center gap-1 text-[11px] font-bold" title="Contactar por WhatsApp">
                        <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">WhatsApp</span>
                      </a>
                      <% } %>

                      <% if (role === 'admin') { %>
                      <button type="button" data-lead-id="<%= lead.id %>" class="btn-delete-lead p-2 text-red-400 hover:text-white hover:bg-red-950/90 border border-transparent hover:border-red-500/30 rounded-xl transition-all" title="Eliminar registro">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                      <% } %>
                    </div>
                  </div>

                </div>
                <% }); %>
              <% } %>
            </div>

            <!-- VISTA ESCRITORIO (TABLA COMPLETA) -->
            <div class="hidden lg:block overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/40">
              <table class="w-full text-left text-xs text-slate-300" id="participants-table">
                <thead class="bg-slate-900 text-slate-400 uppercase tracking-wider font-mono text-[10px] border-b border-slate-800">
                  <tr>
                    <% if (role === 'admin') { %>
                    <th class="py-3.5 px-3 text-center w-10">
                      <input type="checkbox" id="checkbox-select-all-leads" class="w-4 h-4 rounded text-blue-600 bg-slate-950 border-slate-700 focus:ring-blue-500 cursor-pointer" title="Seleccionar todos">
                    </th>
                    <% } %>
                    <th class="py-3.5 px-4 font-black">Dorsal</th>
                    <th class="py-3.5 px-4 font-black">Pupilo/a</th>
                    <th class="py-3.5 px-4 font-black">Edad</th>
                    <th class="py-3.5 px-4 font-black">Circuito</th>
                    <th class="py-3.5 px-4 font-black">Tutor / Apoderado</th>
                    <th class="py-3.5 px-4 font-black">RUT Tutor</th>
                    <th class="py-3.5 px-4 font-black">Teléfono / Emergencia</th>
                    <th class="py-3.5 px-4 font-black">Comprobante</th>
                    <th class="py-3.5 px-4 font-black">Fecha</th>
                    <% if (role === 'admin') { %>
                    <th class="py-3.5 px-4 font-black text-right">Acción</th>
                    <% } %>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/80" id="participants-tbody">
                  <% if (!leads || leads.length === 0) { %>
                  <tr id="no-participants-row">
                    <td colspan="<%= role === 'admin' ? 11 : 9 %>" class="text-center py-12 text-slate-500">
                      <i data-lucide="user-check" class="w-10 h-10 mx-auto mb-2 opacity-40"></i>
                      <p class="text-sm font-bold text-slate-400">Aún no hay inscripciones registradas en la base de datos.</p>
                      <p class="text-xs text-slate-600 mt-1">Los registros desde el landing se reflejarán aquí al instante.</p>
                    </td>
                  </tr>
                  <% } else { %>
                    <% leads.forEach(lead => { %>
                    <tr id="lead-row-<%= lead.id %>" class="participant-row hover:bg-slate-900/60 transition-colors"
                        data-id="<%= lead.id %>"
                        data-search="<%= ((lead.tutorRut || '') + ' ' + (lead.name || '') + ' ' + (lead.kidName || '') + ' ' + (lead.email || '') + ' ' + (lead.phone || '') + ' ' + (lead.emergencyContact || '') + ' ' + (lead.bibNumber || '')).toLowerCase() %>"
                        data-distance="<%= (lead.distance || '').toLowerCase() %>">
                      
                      <% if (role === 'admin') { %>
                      <td class="py-3.5 px-3 text-center">
                        <input type="checkbox" class="lead-select-checkbox w-4 h-4 rounded text-blue-600 bg-slate-950 border-slate-700 focus:ring-blue-500 cursor-pointer" data-id="<%= lead.id %>" data-name="<%= lead.kidName || lead.name %>">
                      </td>
                      <% } %>

                      <!-- Dorsal Oficial -->
                      <td class="py-3.5 px-4 font-mono font-black text-amber-400">
                        #<%= lead.bibNumber || '----' %>
                      </td>

                      <!-- Nombre Pupilo -->
                      <td class="py-3.5 px-4 font-bold text-white">
                        <div class="flex items-center gap-1.5">
                          <i data-lucide="smile" class="w-3.5 h-3.5 text-blue-400 flex-shrink-0"></i>
                          <span><%= lead.kidName || 'No indicado' %></span>
                        </div>
                      </td>

                      <!-- Edad -->
                      <td class="py-3.5 px-4 text-slate-300 font-medium">
                        <%= lead.kidAge ? lead.kidAge + ' años' : '-' %>
                      </td>

                      <!-- Distancia / Circuito con badge -->
                      <td class="py-3.5 px-4">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-blue-950 text-blue-300 border border-blue-500/40">
                          <%= lead.distance || 'General' %>
                        </span>
                      </td>

                      <!-- Nombre Tutor y Correo -->
                      <td class="py-3.5 px-4">
                        <div class="font-bold text-white"><%= lead.name %></div>
                        <div class="text-[11px] font-mono text-slate-500"><%= lead.email %></div>
                      </td>

                      <!-- RUT Tutor -->
                      <td class="py-3.5 px-4 font-mono font-bold text-amber-300 text-[11px]">
                        <%= lead.tutorRut || '-' %>
                      </td>

                      <!-- Teléfono de Emergencia -->
                      <td class="py-3.5 px-4 font-mono text-slate-300">
                        <%= lead.emergencyContact || lead.phone || '-' %>
                      </td>

                      <!-- Comprobante de Pago (Agrandar al Pinchar) -->
                      <td class="py-3.5 px-4">
                        <% if (lead.paymentProof) { %>
                        <button type="button" class="btn-view-proof inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-emerald-950 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-900 transition-all text-[11px] font-bold cursor-pointer" data-proof-url="<%= lead.paymentProof %>" data-pupil="<%= lead.kidName || 'Pupilo' %>" data-tutor="<%= lead.name || 'Tutor' %>" title="Agrandar comprobante">
                          <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i>
                          <span>Ver Foto</span>
                        </button>
                        <% } else { %>
                        <span class="text-slate-500 text-[11px] italic">Pendiente</span>
                        <% } %>
                      </td>

                      <!-- Fecha Registro -->
                      <td class="py-3.5 px-4 text-slate-400 text-[11px] font-mono">
                        <%= new Date(lead.createdAt).toLocaleDateString('es-ES') %>
                      </td>

                      <!-- Acciones (Solo Administrador) -->
                      <% if (role === 'admin') { %>
                      <td class="py-3.5 px-4 text-right">
                        <button type="button" data-lead-id="<%= lead.id %>" class="btn-delete-lead p-1.5 rounded-lg text-red-400 hover:text-white hover:bg-red-950/80 transition-all" title="Eliminar registro">
                          <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                      </td>
                      <% } %>
                    </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Fila Sin Resultados (búsqueda vacía) -->
            <div id="no-search-results" class="hidden text-center py-8 bg-slate-950/50 rounded-2xl border border-slate-800 text-slate-400 space-y-1">
              <i data-lucide="search-x" class="w-7 h-7 mx-auto text-slate-500"></i>
              <p class="text-sm font-bold text-slate-300">No se encontraron inscripciones con ese criterio.</p>
              <p class="text-xs text-slate-500">Prueba buscando por RUT, nombre del padre, nombre del niño o dorsal.</p>
            </div>

          </div>
        </div>

        <!-- MODAL ESCÁNER DE CÉDULA DE IDENTIDAD (ACREDITACIÓN EN TERRENO) -->
        <div id="scanner-modal" class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 overflow-y-auto">
          <div class="relative max-w-xl w-full bg-slate-900 border border-slate-700 rounded-3xl overflow-hidden shadow-2xl p-4 sm:p-6 space-y-4 my-auto">
            
            <!-- Cabecera del Escáner -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-2xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400">
                  <i data-lucide="scan-face" class="w-5 h-5"></i>
                </div>
                <div>
                  <h3 class="text-sm font-black text-white">Escáner de Cédula de Identidad</h3>
                  <p class="text-[11px] text-slate-400">Acreditación y búsqueda de pupilos en terreno</p>
                </div>
              </div>
              <button type="button" id="btn-close-scanner" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-colors">
                ✕
              </button>
            </div>

            <!-- Visor de Cámara y Lector -->
            <div id="scanner-camera-container" class="space-y-3">
              <div class="relative w-full aspect-video sm:aspect-[4/3] bg-black rounded-2xl overflow-hidden border border-slate-800 flex items-center justify-center">
                <div id="reader-qr-view" class="w-full h-full"></div>
                <!-- Guía visual superpuesta -->
                <div class="absolute inset-0 pointer-events-none flex items-center justify-center p-6">
                  <div class="w-full h-36 border-2 border-dashed border-blue-400/80 rounded-2xl flex flex-col items-center justify-center bg-blue-500/5 text-center px-4">
                    <span class="text-xs font-bold text-blue-300 drop-shadow">Apunta al código de barras trasero (PDF417) o QR de la cédula</span>
                    <span class="text-[10px] text-slate-300 mt-1 opacity-80">El RUT se detectará automáticamente</span>
                  </div>
                </div>
              </div>

              <!-- Selector de cámara (frontal / trasera) & Estado -->
              <div class="flex items-center justify-between text-xs text-slate-400 px-1">
                <span id="scanner-status-text" class="flex items-center gap-1.5 text-blue-400 font-semibold">
                  <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
                  Cámara activa lista para escanear
                </span>
                <button type="button" id="btn-switch-camera" class="hover:text-white transition-colors underline flex items-center gap-1">
                  <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                  <span>Cambiar Cámara</span>
                </button>
              </div>
            </div>

            <!-- Opción alternativa: Entrada manual rápida -->
            <div class="pt-2 border-t border-slate-800 flex gap-2">
              <input type="text" id="manual-rut-input" placeholder="O ingresa el RUT manualmente (ej: 12.345.678-9)..." class="admin-input flex-1 px-3 py-2 text-xs text-white placeholder-slate-500 font-mono">
              <button type="button" id="btn-search-manual-rut" class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-all flex items-center gap-1.5 shrink-0">
                <i data-lucide="search" class="w-3.5 h-3.5"></i>
                <span>Buscar</span>
              </button>
            </div>

            <!-- Panel de Resultados de Acreditación (Aparece tras escanear) -->
            <div id="scanner-results-container" class="hidden space-y-3 pt-2">
              <!-- Estado / Mensaje de coincidencia -->
              <div id="scanner-result-header" class="p-3 rounded-2xl flex items-center justify-between">
                <!-- Rellenado dinámicamente -->
              </div>

              <!-- Lista de pupilos encontrados -->
              <div id="scanner-pupils-list" class="space-y-2 max-h-60 overflow-y-auto pr-1">
                <!-- Rellenado dinámicamente -->
              </div>

              <div class="flex gap-2 pt-2">
                <button type="button" id="btn-scan-again" class="flex-1 py-2.5 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-500 text-white transition-all flex items-center justify-center gap-1.5">
                  <i data-lucide="camera" class="w-3.5 h-3.5"></i>
                  <span>Escanear Otra Cédula</span>
                </button>
                <button type="button" id="btn-filter-table-with-rut" class="py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 transition-all flex items-center justify-center gap-1.5" title="Ver en la tabla principal">
                  <i data-lucide="table" class="w-3.5 h-3.5"></i>
                  <span>Ver en Tabla</span>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- MODAL LIGHTBOX PARA VER COMPROBANTE DE PAGO EN GRANDE -->
        <div id="proof-lightbox-modal" class="fixed inset-0 z-50 hidden proof-modal-backdrop bg-slate-950/90 flex items-center justify-center p-3 sm:p-6">
          <div class="relative max-w-2xl w-full bg-slate-900 border border-slate-700 rounded-3xl overflow-hidden shadow-2xl space-y-4 p-4 sm:p-6 animate-in fade-in zoom-in-95 duration-150">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <i data-lucide="receipt" class="w-5 h-5 text-emerald-400"></i>
                <div>
                  <h3 class="text-sm font-black text-white" id="lightbox-pupil-title">Comprobante de Transferencia</h3>
                  <p class="text-[11px] text-slate-400" id="lightbox-tutor-sub">Acreditación oficial del pago</p>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <a id="lightbox-download-link" href="#" target="_blank" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 font-bold flex items-center gap-1" download>
                  <i data-lucide="download" class="w-3.5 h-3.5"></i>
                  <span>Abrir Original</span>
                </a>
                <button type="button" id="btn-close-lightbox" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-colors">
                  ✕
                </button>
              </div>
            </div>

            <!-- Imagen del Comprobante -->
            <div class="w-full max-h-[70vh] bg-slate-950 rounded-2xl flex items-center justify-center overflow-auto p-2 border border-slate-800">
              <img id="lightbox-img" src="" alt="Comprobante de Pago" class="max-w-full max-h-[65vh] object-contain rounded-xl shadow-lg">
            </div>
          </div>
        </div>

        <% if (role === 'admin') { %>
        <!-- BARRA FLOTANTE DE ACCIONES PARA SELECCIÓN MÁLTIPLE -->
        <div id="bulk-selection-bar" class="hidden fixed bottom-6 inset-x-4 sm:inset-x-auto sm:left-1/2 sm:-translate-x-1/2 z-40 bg-slate-900/95 backdrop-blur-md border border-slate-700 shadow-2xl rounded-2xl px-5 py-3 flex items-center justify-between sm:justify-start gap-4 text-xs transition-all">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400 animate-pulse"></span>
            <span class="font-bold text-white"><span id="bulk-selected-counter" class="font-black text-red-400">0</span> seleccionados</span>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" id="btn-deselect-all-leads" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold transition-all cursor-pointer">
              Deseleccionar
            </button>
            <button type="button" id="btn-delete-selected-leads" class="px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-black shadow-md shadow-red-600/30 flex items-center gap-1.5 transition-all cursor-pointer">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              <span>Eliminar Seleccionados</span>
            </button>
          </div>
        </div>

        <!-- MODAL DE EMERGENCIA PARA ELIMINACIÓN MASIVA (CON PALABRA CLAVE DE SEGURIDAD) -->
        <div id="emergency-delete-modal" class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md hidden flex items-center justify-center p-4">
          <div class="bg-slate-900 border-2 border-red-500/60 rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl shadow-red-950/50 space-y-5 relative animate-in fade-in zoom-in-95 duration-150">
            
            <!-- Encabezado con Alerta Roja -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-red-600/20 text-red-400 border border-red-500/40 flex items-center justify-center shrink-0">
                <i data-lucide="shield-alert" class="w-6 h-6 animate-pulse"></i>
              </div>
              <div>
                <span class="text-[10px] font-black uppercase tracking-wider text-red-400 bg-red-950/60 border border-red-500/30 px-2 py-0.5 rounded-full inline-block mb-1">
                  ZONA CRÍTICA DE SEGURIDAD
                </span>
                <h3 class="text-lg font-black text-white">Eliminación Masiva de Participantes</h3>
                <p class="text-xs text-slate-400 mt-0.5">Operación irreversible de purga de base de datos.</p>
              </div>
            </div>

            <!-- Cuadro de advertencia -->
            <div class="p-4 rounded-2xl bg-red-950/40 border border-red-500/40 text-xs text-red-200 space-y-2">
              <p class="font-bold flex items-center gap-1.5 text-red-300">
                <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0 text-amber-400"></i>
                <span>¡Atención Administrador! Esta acción no se puede deshacer.</span>
              </p>
              <p class="text-[11px] text-red-300/80 leading-relaxed">
                Se eliminarán permanentemente los registros seleccionados tanto de <strong>PostgreSQL</strong> como de los <strong>respaldos locales</strong>.
              </p>
              <div class="pt-2 border-t border-red-500/30 flex items-center justify-between text-xs">
                <span class="text-slate-300 font-medium">Registros a eliminar:</span>
                <span id="modal-delete-scope-text" class="font-black text-amber-300 bg-slate-950 px-2.5 py-0.5 rounded-lg border border-slate-700">0 participantes</span>
              </div>
            </div>

            <!-- Selector de alcance cuando se abre desde botón superior -->
            <div id="modal-scope-selector" class="space-y-1.5 hidden">
              <label class="block text-xs font-bold text-slate-300">Alcance de la eliminación:</label>
              <div class="grid grid-cols-2 gap-2 text-xs">
                <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-slate-700">
                  <input type="radio" name="deleteScope" value="selected" id="scope-selected" class="text-red-600 focus:ring-red-500">
                  <span class="font-bold text-slate-300">Sólo seleccionados (<span id="scope-selected-count">0</span>)</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer hover:border-slate-700">
                  <input type="radio" name="deleteScope" value="all" id="scope-all" class="text-red-600 focus:ring-red-500">
                  <span class="font-bold text-red-400">Toda la base de datos</span>
                </label>
              </div>
            </div>

            <!-- Input de confirmación con palabra de emergencia -->
            <div class="space-y-2">
              <label class="block text-xs font-bold text-slate-300">
                Escribe la palabra de seguridad de emergencia para desbloquear:
              </label>
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono">
                <span class="text-slate-400">Palabra requerida:</span>
                <span id="target-security-word" class="font-black text-red-400 bg-red-950/80 px-2.5 py-1 rounded-lg border border-red-500/40 select-all tracking-wider"><%= typeof emergencySecurityWord !== 'undefined' ? emergencySecurityWord : 'ELIMINAR-PARTICIPANTES' %></span>
              </div>
              <input type="text" id="input-emergency-security-word"
                     autocomplete="off"
                     placeholder="Escribe la palabra exactamente..."
                     class="w-full bg-slate-950 border-2 border-slate-800 focus:border-red-500 rounded-xl px-4 py-3 text-sm font-mono font-bold text-white placeholder-slate-600 focus:outline-none transition-colors">
              <p id="security-word-hint" class="text-[10px] text-slate-500 italic">El botón de confirmación se habilitará automáticamente al escribir la palabra exacta.</p>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
              <button type="button" id="btn-cancel-emergency-delete" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 transition-all cursor-pointer">
                Cancelar
              </button>
              <button type="button" id="btn-confirm-emergency-delete" disabled
                      class="px-5 py-2.5 rounded-xl text-xs font-black text-white bg-red-600 hover:bg-red-500 active:bg-red-700 disabled:opacity-40 disabled:cursor-not-allowed shadow-lg shadow-red-600/30 transition-all flex items-center gap-2 cursor-pointer">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                <span id="btn-confirm-emergency-delete-text">Confirmar Eliminación</span>
              </button>
            </div>

          </div>
        </div>
        <% } %>
        <!-- /#tab-leads -->

        <!-- PESTAÑA: GESTIÓN DE USUARIOS (SOLO ADMINISTRADOR) -->
        <% if (role === 'admin') { %>
        <div id="tab-users" class="tab-pane hidden space-y-6">

          <!-- 1. CABECERA PRINCIPAL CON CONTADORES Y BOTÓN DESTACADO -->
          <div class="bg-gradient-to-r from-slate-900 via-slate-900 to-slate-950 border border-slate-800 rounded-3xl p-5 sm:p-7 shadow-xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
              
              <!-- Título & Métricas -->
              <div class="space-y-2.5">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-2xl bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center shrink-0">
                    <i data-lucide="users" class="w-5 h-5"></i>
                  </div>
                  <div>
                    <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-2.5 flex-wrap">
                      <span>Usuarios del Sistema</span>
                      <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-500/40 font-mono font-bold" id="users-total-badge">
                        <%= (typeof usersList !== 'undefined' ? usersList.length : 0) %> cuentas activas
                      </span>
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">Gestión de usuarios con acceso al sistema. Administradores y Lectores.</p>
                  </div>
                </div>

                <!-- Resumen de Roles -->
                <%
                  const adminCount = (typeof usersList !== 'undefined' ? usersList : []).filter(u => u.role === 'admin').length;
                  const editorCount = (typeof usersList !== 'undefined' ? usersList : []).filter(u => u.role === 'editor').length;
                %>
                <div class="flex items-center gap-2 pt-0.5 flex-wrap">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-950/70 border border-blue-500/40 text-blue-300 text-xs font-semibold">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-400"></i>
                    <strong id="users-admin-count"><%= adminCount %></strong> Administrador<%= adminCount === 1 ? '' : 'es' %>
                  </span>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-950/70 border border-amber-500/40 text-amber-300 text-xs font-semibold">
                    <i data-lucide="book-open" class="w-3.5 h-3.5 text-amber-400"></i>
                    <strong id="users-editor-count"><%= editorCount %></strong> Lector<%= editorCount === 1 ? '' : 'es' %>
                  </span>
                </div>
              </div>

              <!-- BOTÓN PRINCIPAL PARA AGREGAR USUARIO -->
              <div class="shrink-0">
                <button type="button" id="btn-toggle-create-user" class="btn-open-user-form w-full sm:w-auto px-6 py-3.5 rounded-2xl text-sm font-black text-white bg-emerald-600 hover:bg-emerald-500 active:scale-95 shadow-xl shadow-emerald-600/30 hover:shadow-emerald-500/50 transition-all flex items-center justify-center gap-2.5 cursor-pointer ring-2 ring-emerald-400/30">
                  <i data-lucide="user-plus" class="w-5 h-5"></i>
                  <span id="btn-toggle-create-text">+ Agregar Usuario</span>
                </button>
              </div>

            </div>
          </div>

          <!-- 2. FORMULARIO INLINE DESPLEGABLE (CREAR / EDITAR) -->
          <div id="user-form-card" class="hidden bg-slate-900 border-2 border-emerald-500/50 rounded-3xl p-5 sm:p-7 shadow-2xl space-y-5 transition-all animate-in fade-in duration-200">
            <!-- Cabecera del Formulario -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-800">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center">
                  <i data-lucide="user-plus" class="w-4 h-4" id="form-header-icon"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white" id="user-form-card-title">Agregar Nuevo Usuario</h3>
                  <p class="text-[11px] text-slate-400" id="user-form-card-subtitle">Ingresa los datos para otorgar acceso como Administrador o Lector.</p>
                </div>
              </div>
              <button type="button" id="btn-cancel-user-form" class="px-3 py-1.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors text-xs flex items-center gap-1 cursor-pointer">
                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                <span>Cerrar</span>
              </button>
            </div>

            <!-- Error Box -->
            <div id="user-form-error-box" class="hidden p-3.5 rounded-2xl bg-red-950/80 border border-red-500/40 text-red-300 text-xs flex items-center gap-2">
              <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 text-red-400"></i>
              <span id="user-form-error-msg"></span>
            </div>

            <input type="hidden" id="user-edit-id" value="">

            <!-- Campos -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Nombre Completo -->
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Nombre Completo *</label>
                <input type="text" id="user-input-name" placeholder="Ej: Marcela Contreras" class="admin-input w-full px-4 py-2.5 text-xs text-white bg-slate-950/70 border-slate-700 rounded-xl focus:border-emerald-500">
              </div>

              <!-- Nombre de Usuario (Login) -->
              <div id="user-username-container">
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Nombre de Usuario (Login) *</label>
                <input type="text" id="user-input-username" placeholder="Ej: mcontreras" autocomplete="off" class="admin-input w-full px-4 py-2.5 text-xs text-white font-mono bg-slate-950/70 border-slate-700 rounded-xl focus:border-emerald-500">
                <span class="text-[10px] text-slate-500 mt-1 block">Solo letras minúsculas, números o guiones. Sin espacios.</span>
              </div>

              <!-- Selección de Rol con Tarjetas Visuales -->
              <div class="sm:col-span-2 space-y-2">
                <label class="block text-xs font-semibold text-slate-300">Rol y Nivel de Acceso *</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="role-cards-container">
                  
                  <!-- Opción Lector -->
                  <div id="role-card-editor" data-role-val="editor" class="role-card-opt p-4 rounded-2xl border-2 border-amber-500/70 bg-amber-950/20 cursor-pointer transition-all hover:border-amber-400 shadow-sm">
                    <div class="flex items-center justify-between mb-2">
                      <span class="font-bold text-xs text-amber-300 flex items-center gap-2">
                        <i data-lucide="book-open" class="w-4 h-4 text-amber-400"></i> Lector
                      </span>
                      <span class="role-indicator-badge text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40">
                        Seleccionado
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                      Acceso de lectura y escáner de participantes para acreditar en terreno el día de la corrida.
                    </p>
                  </div>

                  <!-- Opción Administrador -->
                  <div id="role-card-admin" data-role-val="admin" class="role-card-opt p-4 rounded-2xl border-2 border-slate-700 bg-slate-950/40 cursor-pointer transition-all hover:border-blue-400 opacity-70">
                    <div class="flex items-center justify-between mb-2">
                      <span class="font-bold text-xs text-blue-300 flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4 text-blue-400"></i> Administrador
                      </span>
                      <span class="role-indicator-badge text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 hidden">
                        Seleccionado
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                      Control total: Editar corridas, cupos, cronograma, FAQs, fotos, precios, y <strong>crear o revocar cuentas de administradores y lectores</strong>.
                    </p>
                  </div>

                </div>
                <input type="hidden" id="user-input-role" value="editor">
              </div>

              <!-- Contraseña -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-semibold text-slate-300" id="user-label-password">Contraseña *</label>
                  <button type="button" id="btn-toggle-pw-visibility" class="text-[11px] text-slate-400 hover:text-white flex items-center gap-1 cursor-pointer">
                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                    <span id="pw-toggle-text">Ver clave</span>
                  </button>
                </div>
                <input type="password" id="user-input-password" placeholder="Mínimo 12 caracteres" minlength="12" autocomplete="new-password" class="admin-input w-full px-4 py-2.5 text-xs text-white bg-slate-950/70 border-slate-700 rounded-xl focus:border-emerald-500">
                <span class="text-[10px] text-slate-500 hidden mt-1 block" id="user-hint-password">Deja este campo vacío si deseas mantener la contraseña actual.</span>

                <!-- Medidor de fortaleza -->
                <div class="mt-2 space-y-1" id="pw-strength-container">
                  <div class="flex gap-1.5">
                    <div class="h-1 flex-1 rounded-full bg-slate-700 transition-all" id="pw-bar-1"></div>
                    <div class="h-1 flex-1 rounded-full bg-slate-700 transition-all" id="pw-bar-2"></div>
                    <div class="h-1 flex-1 rounded-full bg-slate-700 transition-all" id="pw-bar-3"></div>
                    <div class="h-1 flex-1 rounded-full bg-slate-700 transition-all" id="pw-bar-4"></div>
                  </div>
                  <span class="text-[10px] text-slate-500 block" id="pw-strength-label"></span>
                </div>
              </div>

              <!-- Confirmar Contraseña -->
              <div id="user-confirm-password-container">
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Confirmar Contraseña *</label>
                <input type="password" id="user-input-password-confirm" placeholder="Repite la contraseña" minlength="12" autocomplete="new-password" class="admin-input w-full px-4 py-2.5 text-xs text-white bg-slate-950/70 border-slate-700 rounded-xl focus:border-emerald-500">
                <span class="text-[10px] hidden mt-1 block font-medium" id="pw-match-hint"></span>
              </div>
            </div>

            <!-- Footer con Botón Guardar -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
              <button type="button" id="btn-cancel-user-form-bottom" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white transition-colors cursor-pointer">
                Cancelar
              </button>
              <button type="button" id="btn-save-user" class="px-6 py-2.5 rounded-2xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-600/30 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span id="btn-save-user-text">Guardar y Agregar Usuario</span>
              </button>
            </div>
          </div>

          <!-- 3. BARRA DE ACCIÓN INTERMEDIA CON BOTÓN DIRECTO -->
          <div class="flex items-center justify-between gap-3 pt-1">
            <div class="flex items-center gap-2.5">
              <h3 class="text-sm font-bold text-white">Cuentas Registradas</h3>
              <span class="text-[11px] font-mono font-bold text-slate-400 bg-slate-800/80 px-2.5 py-0.5 rounded-lg border border-slate-700" id="users-list-badge">
                <%= (typeof usersList !== 'undefined' ? usersList.length : 0) %> en total
              </span>
            </div>
            <button type="button" class="btn-open-user-form px-4 py-2 rounded-xl text-xs font-bold text-emerald-300 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-500/40 hover:border-emerald-400 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm">
              <i data-lucide="user-plus" class="w-3.5 h-3.5 text-emerald-400"></i>
              <span>+ Agregar Usuario</span>
            </button>
          </div>

          <!-- 4. LISTADO DE USUARIOS REGISTRADOS -->
          <div class="space-y-3" id="users-list-container">
            <% const hasUsers = typeof usersList !== 'undefined' && usersList && usersList.length > 0; %>

            <!-- Estado Vacío con botón directo -->
            <div id="users-empty-state" class="<%= hasUsers ? 'hidden' : '' %> text-center py-14 bg-slate-950/40 rounded-3xl border border-dashed border-slate-700 text-slate-400 space-y-4 px-6">
              <div class="w-14 h-14 mx-auto rounded-3xl bg-emerald-600/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
                <i data-lucide="users" class="w-7 h-7"></i>
              </div>
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-slate-200">No hay usuarios registrados</h4>
                <p class="text-xs text-slate-500">Haz clic en el botón para añadir el primer administrador o lector.</p>
              </div>
              <div>
                <button type="button" class="btn-open-user-form inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-600/30 transition-all cursor-pointer">
                  <i data-lucide="user-plus" class="w-4 h-4"></i>
                  <span>+ Agregar Primer Usuario</span>
                </button>
              </div>
            </div>

            <!-- Tarjetas de Usuarios (Renderizadas en el servidor) -->
            <% (typeof usersList !== 'undefined' ? usersList : []).forEach(u => { %>
            <div class="user-card-item bg-slate-900/90 border border-slate-800 hover:border-slate-700 rounded-2xl p-4.5 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all shadow-md"
                 data-user-id="<%= u.id %>" data-username="<%= u.username %>" data-name="<%= u.name %>" data-role="<%= u.role %>">
              
              <!-- Info del Usuario -->
              <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-2xl shrink-0 flex items-center justify-center font-black text-sm
                     <%= u.role === 'admin' ? 'bg-blue-600/20 text-blue-400 border border-blue-500/40 shadow-blue-500/10' : 'bg-amber-600/20 text-amber-400 border border-amber-500/40 shadow-amber-500/10' %> shadow-lg">
                  <%= (u.name || u.username)[0].toUpperCase() %>
                </div>
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-sm text-white"><%= u.name %></span>
                    <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-lg
                         <%= u.role === 'admin' ? 'bg-blue-950 text-blue-300 border border-blue-500/40' : 'bg-amber-950 text-amber-300 border border-amber-500/40' %>">
                      <%= u.role === 'admin' ? 'ADMINISTRADOR' : 'LECTOR' %>
                    </span>
                    <% if (u.username === username) { %>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Eres tú
                    </span>
                    <% } %>
                  </div>
                  <p class="text-xs text-slate-400 font-mono mt-0.5">@<%= u.username %></p>
                </div>
              </div>

              <!-- Botones de Acción -->
              <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
                <button type="button" class="btn-edit-user px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer"
                        data-id="<%= u.id %>" data-username="<%= u.username %>" data-name="<%= u.name %>" data-role="<%= u.role %>">
                  <i data-lucide="edit-3" class="w-3.5 h-3.5 text-slate-400"></i>
                  <span>Editar</span>
                </button>

                <% if (u.username !== username) { %>
                <button type="button" class="btn-delete-user p-2 rounded-xl bg-red-950/50 hover:bg-red-900 border border-red-500/30 text-red-300 transition-colors cursor-pointer"
                        data-id="<%= u.id %>" data-username="<%= u.username %>" title="Eliminar usuario">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
                <% } %>
              </div>

            </div>
            <% }); %>

          </div>

          <!-- 5. BOTÓN INFERIOR PARA AGREGAR MÁS USUARIOS -->
          <div class="pt-1">
            <button type="button" class="btn-open-user-form w-full py-4 rounded-2xl border-2 border-dashed border-slate-800 hover:border-emerald-500/60 bg-slate-900/40 hover:bg-emerald-950/20 text-slate-400 hover:text-emerald-300 transition-all flex items-center justify-center gap-2 text-xs font-bold cursor-pointer group shadow-sm">
              <i data-lucide="user-plus" class="w-4 h-4 text-slate-500 group-hover:text-emerald-400 transition-colors"></i>
              <span>+ Agregar otro administrador o lector</span>
            </button>
          </div>

        </div>
        <% } %>
        <!-- PESTAÑA: MODO CONSTRUCCIÓN (SOLO ADMINISTRADOR) -->
        <% if (role === 'admin') { %>
        <div id="tab-construction" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 space-y-6">
            
            <!-- Cabecera de la sección -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-gray-800">
              <div>
                <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                  <i data-lucide="construction" class="w-5 h-5 text-amber-400"></i>
                  <span>Modo Construcción & Pre-Lanzamiento</span>
                </h2>
                <p class="text-xs text-gray-400 mt-1">
                  Controla si la web está abierta a inscripciones o si muestra la pantalla de preparación.
                </p>
              </div>

              <!-- Botones de Enlace Rápido -->
              <div class="flex items-center gap-2 shrink-0">
                <a href="/preview-construction" target="_blank" class="px-3.5 py-2 rounded-2xl text-xs font-bold text-amber-300 bg-amber-950/60 border border-amber-500/40 hover:bg-amber-900 transition-all flex items-center gap-1.5 shadow-sm">
                  <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                  <span>Previsualizar Pantalla</span>
                </a>
                <a href="/" target="_blank" class="px-3.5 py-2 rounded-2xl text-xs font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-all flex items-center gap-1.5 shadow-sm">
                  <i data-lucide="external-link" class="w-3.5 h-3.5 text-blue-400"></i>
                  <span>Ver Web (Bypass)</span>
                </a>
              </div>
            </div>

            <!-- Caja Informativa de Funcionamiento del Bypass -->
            <div class="p-4 rounded-2xl bg-blue-950/40 border border-blue-800/60 text-xs text-blue-200 flex items-start gap-3">
              <i data-lucide="shield-check" class="w-5 h-5 text-blue-400 shrink-0 mt-0.5"></i>
              <div class="space-y-1">
                <p class="font-bold text-white">¿Cómo funciona el acceso de Administrador?</p>
                <p class="text-blue-300/90 leading-relaxed">
                  Cuando activas el <strong>Modo Construcción</strong>, cualquier visitante público externo verá la pantalla interactiva de lanzamiento y no podrá inscribirse aún. Sin embargo, <strong>tú como Administrador</strong> con tu sesión activa puedes entrar a <a href="/" target="_blank" class="underline font-bold text-yellow-300">kidsrun.cl</a> y navegar por toda la web con total normalidad para verificar su funcionamiento.
                </p>
              </div>
            </div>

            <!-- Interruptor Principal On/Off con Botones Rápidos -->
            <div class="p-5 rounded-2xl bg-gray-900/90 border border-gray-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-white">Estado del Modo Construcción</span>
                  <span id="construction-status-pill" class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full transition-all <%= content.construction?.enabled ? 'bg-amber-500 text-slate-950 animate-pulse' : 'bg-slate-800 text-slate-400' %>">
                    <%= content.construction?.enabled ? 'ACTIVADO' : 'DESACTIVADO' %>
                  </span>
                </div>
                <p class="text-xs text-gray-400">
                  Activa para que el público general vea la pantalla de lanzamiento o desactiva para publicar la web completa.
                </p>
              </div>

              <!-- Controles On/Off: Botones y Switch interactivo -->
              <div class="flex items-center gap-2.5 self-start sm:self-auto">
                <button type="button" id="btn-construction-activate" class="text-xs font-bold px-3 py-2 rounded-xl border border-amber-500/40 text-amber-300 hover:bg-amber-500/20 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm <%= content.construction?.enabled ? 'opacity-40 pointer-events-none' : '' %>" title="Poner la web en modo construcción">
                  <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-400"></i>
                  <span>Activar</span>
                </button>
                <button type="button" id="btn-construction-deactivate" class="text-xs font-bold px-3 py-2 rounded-xl border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/20 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm <%= !content.construction?.enabled ? 'opacity-40 pointer-events-none' : '' %>" title="Abrir y publicar la web completa">
                  <i data-lucide="globe" class="w-3.5 h-3.5 text-emerald-400"></i>
                  <span>Desactivar</span>
                </button>

                <!-- Switch Visual con Custom CSS -->
                <div id="construction-switch-container" class="flex items-center ml-1 cursor-pointer" title="Haz clic para alternar ON / OFF">
                  <input type="checkbox" id="input-construction-enabled" class="sr-only" <%= content.construction?.enabled ? 'checked' : '' %>>
                  <div id="construction-toggle-track" class="construction-toggle-track <%= content.construction?.enabled ? 'active' : '' %>" role="switch" aria-checked="<%= content.construction?.enabled ? 'true' : 'false' %>">
                    <div class="construction-toggle-thumb"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Formulario de Configuración de la Pantalla de Construcción -->
            <div class="space-y-4 pt-2">
              <h3 class="text-xs font-black uppercase tracking-wider text-gray-400 flex items-center gap-2">
                <i data-lucide="palette" class="w-3.5 h-3.5 text-blue-400"></i>
                <span>Personalización de la Pantalla de Lanzamiento</span>
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Badge Superior Animado</label>
                  <input type="text" id="input-construction-badge" value="<%= content.construction?.badge || '🚧 PISTA EN PREPARACIÓN • MUY PRONTO' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400">
                </div>

                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Fecha Estimada de Apertura (Texto)</label>
                  <input type="text" id="input-construction-expectedDate" value="<%= content.construction?.expectedDate || 'Domingo 15 de Noviembre, 2026' %>" placeholder="Ej: Octubre 2026 o Domingo 15 de Noviembre" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Título Principal</label>
                <input type="text" id="input-construction-title" value="<%= content.construction?.title || '¡Estamos Calentando Motores!' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-xs text-white font-bold focus:outline-none focus:border-amber-400">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Mensaje o Subtítulo para las Familias</label>
                <textarea id="input-construction-subtitle" rows="3" class="w-full bg-gray-900 border border-gray-800 rounded-2xl p-3 text-xs text-white focus:outline-none focus:border-amber-400"><%= content.construction?.subtitle || 'La Gran Corrida Infantil KidsRun 2026 está preparando una pista llena de aventuras, medallas y diversión para toda la familia.' %></textarea>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">Fecha/Hora Cuenta Regresiva (ISO o Local)</label>
                  <input type="datetime-local" id="input-construction-targetDate" value="<%= (content.construction?.targetDate || content.countdown?.targetDate || '2026-11-15T09:00').substring(0, 16) %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400">
                </div>

                <div>
                  <label class="block text-xs font-semibold text-gray-300 mb-1.5">WhatsApp de Contacto Directo</label>
                  <input type="text" id="input-construction-whatsapp" value="<%= content.construction?.contactWhatsapp || content.contact?.phone || '+56 9 8765 4321' %>" class="w-full bg-gray-900 border border-gray-800 rounded-2xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-amber-400">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <label class="flex items-center gap-3 p-3.5 bg-gray-900 rounded-2xl border border-gray-800 cursor-pointer">
                  <input type="checkbox" id="input-construction-showCountdown" class="rounded text-amber-500 focus:ring-amber-400 w-4 h-4 bg-gray-800 border-gray-700" <%= content.construction?.showCountdown !== false ? 'checked' : '' %>>
                  <div class="text-xs">
                    <p class="font-bold text-white">Mostrar Contador Regresivo</p>
                    <p class="text-[10px] text-gray-400">Muestra los días, horas y minutos restantes.</p>
                  </div>
                </label>

                <label class="flex items-center gap-3 p-3.5 bg-gray-900 rounded-2xl border border-gray-800 cursor-pointer">
                  <input type="checkbox" id="input-construction-notifyForm" class="rounded text-amber-500 focus:ring-amber-400 w-4 h-4 bg-gray-800 border-gray-700" <%= content.construction?.notifyForm !== false ? 'checked' : '' %>>
                  <div class="text-xs">
                    <p class="font-bold text-white">Formulario de Captura de Leads</p>
                    <p class="text-[10px] text-gray-400">Permite registrar correos/WhatsApp para avisarles.</p>
                  </div>
                </label>
              </div>

              <!-- Botón Guardar Cambios Específico de Construcción -->
              <div class="pt-4 flex items-center justify-between">
                <button type="button" id="btn-save-construction-section" class="px-5 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-md shadow-amber-500/20 active:scale-95 transition-all flex items-center gap-2 cursor-pointer">
                  <i data-lucide="check" class="w-4 h-4"></i>
                  <span>Guardar Ajustes de Modo Construcción</span>
                </button>
              </div>

            </div>

          </div>
        </div>
        <% } %>

        <!-- PESTAÑA: SEGURIDAD -->
        <div id="tab-security" class="tab-pane hidden space-y-6">
          <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-gray-800 max-w-md">
            <h2 class="text-base font-bold text-white mb-1 flex items-center gap-2">
              <i data-lucide="shield" class="w-4 h-4 text-blue-400"></i>
              Cambiar Contraseña de Acceso
            </h2>
            <p class="text-xs text-gray-400 mb-6">Actualiza tu clave de acceso de forma segura.</p>

            <div id="form-change-password-container" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Contraseña Actual</label>
                <input type="password" id="input-currentPassword" required class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-300 mb-1.5">Nueva Contraseña (mínimo 12 caracteres)</label>
                <input type="password" id="input-newPassword" required minlength="12" class="w-full bg-gray-900 border border-gray-800 rounded-3xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-400">
              </div>
              <button type="button" id="btn-submit-change-password" class="px-5 py-2.5 rounded-3xl text-xs font-bold text-white bg-yellow-500 hover:bg-yellow-400 transition-all">
                Actualizar Clave
              </button>
            </div>
          </div>
        </div>

      </form>
    </main>

  </div>

  <script src="/js/admin.js?v=<%= Date.now() %>"></script>
</body>
</html>
